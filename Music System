Players.PlayerRemoving:Connect(function(player)
	local userId = player.UserId

	validationService:CleanupPlayer(userId)
	queueManager:RemoveUserSongs(userId)
	skipVoteManager:UpdateVoteOnPlayerLeave(userId, Dispatcher)
	RateLimiter:Cleanup(userId)
	RetryTracker:Cleanup(userId)

	scheduleBatchedSync("queue")
end)

-- ====================================
-- INITIALIZATION
-- ====================================
MusicStorageHandler:StartAutoCleanup()

task.spawn(function()
	Dispatcher:NotifyAll("Music system initializing...")

	local currentQueue = queueManager:GetQueue()
	if #currentQueue > 0 then
		for i, songData in ipairs(currentQueue) do
			local duration = loadSongOnDemand(songData.musicData.id, songData.musicData.judul)
			if duration > 0 then
				songData.musicData.Duration = duration
				songData.Duration = duration
			end
		end
	end

	local musicList = MusicModule:GetAllMusic()
	local topSongs = {}
	for i = 1, math.min(CONFIG.PRELOAD_TOP_SONGS, #musicList) do
		table.insert(topSongs, musicList[i])
	end

	for i, song in ipairs(topSongs) do
		if not MusicStorageHandler:IsSoundReady(song.id) then
			local duration = loadSongOnDemand(song.id, song.judul)
			if duration > 0 then
				song.Duration = duration
			end
		end
	end

	SystemState.InitialPreloadComplete = true
	Dispatcher:NotifyAll(string.format("Music system ready! %d songs loaded | Server-side audio active", #musicList))

	task.wait(1)
	SystemState.IsReady = true

	if CONFIG.AUTO_PLAYLIST_ENABLED and queueManager:IsEmpty() and not playbackManager:IsPlaying() then
		playNextSong()
	elseif not queueManager:IsEmpty() and not playbackManager:IsPlaying() then
		playNextSong()
	end
end)

Players.PlayerAdded:Connect(function(player)
	RoleSystem:InitializePlayer(player)

	task.wait(1)
	if validationService:ValidatePlayer(player) then
		Dispatcher:SyncToPlayer(player)

		if not SystemState.InitialPreloadComplete then
			Dispatcher:Notify(player, "Music system is loading, please wait...")
		else
			Dispatcher:Notify(player, "Welcome! Use /retry if music doesn't sync. Commands: /vol, /mute")
		end
	end

	player.CharacterAdded:Connect(function(character)
		local hrp = character:WaitForChild("HumanoidRootPart", 5)
		if not hrp then return end

		task.wait(0.5)

		if validationService:ValidatePlayer(player) then
			Dispatcher:SyncToPlayer(player)
		end
	end)

	player.Chatted:Connect(function(message)
		local role = RoleSystem:GetPlayerRole(player)

		if role == "Admin" or role == "Owner" or role == "Moderator" then
			local lowerMsg = string.lower(message)

			if lowerMsg == "/retrystats" or lowerMsg == ";rs" then
				local totalPlayers = 0
				local totalRetries = 0
				local playersWithRetries = 0

				for _, plr in ipairs(Players:GetPlayers()) do
					totalPlayers = totalPlayers + 1
					local stats = RetryTracker:GetStats(plr)
					if stats.totalRetries > 0 then
						playersWithRetries = playersWithRetries + 1
						totalRetries = totalRetries + stats.totalRetries
					end
				end

				Dispatcher:Notify(player, string.format(
					"Retry Statistics:\nPlayers with retries: %d/%d\nTotal retry attempts: %d",
					playersWithRetries, totalPlayers, totalRetries
					))
			end

			if lowerMsg:match("^/retryplayer%s+") or lowerMsg:match("^;retryplayer%s+") then
				local targetName = lowerMsg:match("^/retryplayer%s+(.+)") or lowerMsg:match("^;retryplayer%s+(.+)")

				local targetPlayer = nil
				local matches = {}
				local lowerTarget = targetName:lower()

				for _, plr in ipairs(Players:GetPlayers()) do
					local lowerDisplay = plr.DisplayName:lower()

					if lowerDisplay == lowerTarget then
						targetPlayer = plr
						break
					end

					if #lowerTarget >= 3 and lowerDisplay:sub(1, #lowerTarget) == lowerTarget then
						table.insert(matches, plr)
					end
				end

				if not targetPlayer then
					if #matches == 1 then
						targetPlayer = matches[1]
					elseif #matches > 1 then
						local names = {}
						for _, plr in ipairs(matches) do
							table.insert(names, plr.DisplayName)
						end
						Dispatcher:Notify(player, string.format("Multiple players found: %s. Please be more specific!", table.concat(names, ", ")))
						return
					end
				end

				if targetPlayer then
					Dispatcher:Notify(player, string.format("Reloading music for %s...", targetPlayer.DisplayName))

					local serverSound = playbackManager.audioHandler:GetSound()
					if serverSound and serverSound.IsPlaying then
						local currentPos = serverSound.TimePosition

						pcall(function()
							serverSound:Stop()
						end)

						task.wait(0.1)

						pcall(function()
							serverSound.TimePosition = currentPos
							serverSound:Play()
						end)

						task.delay(0.5, function()
							Dispatcher:Notify(player, string.format("%s's music has been reloaded!", targetPlayer.DisplayName))
							Dispatcher:Notify(targetPlayer, string.format("Admin %s reloaded your music", player.DisplayName))
						end)
					else
						Dispatcher:Notify(player, "No music is currently playing")
					end
				else
					Dispatcher:Notify(player, "Player not found! Use DisplayName or first 3+ letters (e.g. /retryplayer Eld)")
				end
			end

			if lowerMsg == "/retryall" or lowerMsg == ";retryall" then
				local playerCount = #Players:GetPlayers()
				Dispatcher:Notify(player, string.format("Reloading music for %d players...", playerCount))

				local serverSound = playbackManager.audioHandler:GetSound()
				if serverSound and serverSound.IsPlaying then
					local currentPos = serverSound.TimePosition

					pcall(function()
						serverSound:Stop()
					end)

					task.wait(0.1)

					pcall(function()
						serverSound.TimePosition = currentPos
						serverSound:Play()
					end)

					task.delay(0.5, function()
						if serverSound.IsPlaying then
							Dispatcher:NotifyAll(string.format("Admin %s reloaded music for all players!", player.DisplayName))
							Dispatcher:Notify(player, "Music reloaded successfully!")
						else
							Dispatcher:Notify(player, "Failed to reload music")
						end
					end)
				else
					Dispatcher:Notify(player, "No music is currently playing")
				end
			end
		end
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	local userId = player.UserId

	validationService:CleanupPlayer(userId)
	queueManager:RemoveUserSongs(userId)
	skipVoteManager:UpdateVoteOnPlayerLeave(userId, Dispatcher)
	RateLimiter:Cleanup(userId)
	RetryTracker:Cleanup(userId)

	scheduleBatchedSync("queue")
end)

