-- ====================================
-- RATE LIMITING
-- ====================================
local RateLimiter = {}
RateLimiter.playerLimits = {}

function RateLimiter:CheckLimit(player, actionType)
	local userId = player.UserId
	local cooldown = CONFIG.SPAM_PROTECTION.ACTION_COOLDOWNS[actionType] or CONFIG.SYNC_RATE_LIMIT

	if not self.playerLimits[userId] then
		self.playerLimits[userId] = {}
	end

	local lastTime = self.playerLimits[userId][actionType]
	if lastTime and (tick() - lastTime) < cooldown then
		return false
	end

	self.playerLimits[userId][actionType] = tick()
	return true
end

function RateLimiter:Cleanup(userId)
	self.playerLimits[userId] = nil
end

-- ====================================
-- RETRY TRACKING SYSTEM
-- ====================================
local RetryTracker = {}
RetryTracker.playerRetries = {}

function RetryTracker:Track(player)
	local userId = player.UserId

	if not self.playerRetries[userId] then
		self.playerRetries[userId] = {
			count = 0,
			lastRetry = 0,
			totalRetries = 0,
			firstRetry = tick()
		}
	end

	local data = self.playerRetries[userId]
	data.count = data.count + 1
	data.totalRetries = data.totalRetries + 1
	data.lastRetry = tick()

	return data
end

function RetryTracker:GetStats(player)
	local userId = player.UserId
	return self.playerRetries[userId] or {count = 0, totalRetries = 0}
end

function RetryTracker:Reset(player)
	local userId = player.UserId
	if self.playerRetries[userId] then
		self.playerRetries[userId].count = 0
	end
end

function RetryTracker:Cleanup(userId)
	self.playerRetries[userId] = nil
end

-- ====================================
-- ADMIN BLOCK UTILITIES
-- ====================================
local function isModeratorPlus(player)
	local role = RoleSystem:GetPlayerRole(player)
	local hierarchy = RoleSystem.Config.RoleHierarchy[role] or 0
	return hierarchy >= 4
end

local function toggleUIBlock()
	SystemState.IsUIBlocked = not SystemState.IsUIBlocked
	return SystemState.IsUIBlocked
end

-- ====================================
-- DISPATCHER UTILITIES
-- ====================================
local Dispatcher = {}

function Dispatcher:SendToClient(player, eventType, payload)
	if player and player:IsDescendantOf(Players) then
		pcall(function()
			dispatchEvent:FireClient(player, {
				type = eventType,
				payload = payload
			})
		end)
	end
end

function Dispatcher:SendToAll(eventType, payload)
	pcall(function()
		dispatchEvent:FireAllClients({
			type = eventType,
			payload = payload
		})
	end)
end

function Dispatcher:Notify(player, message)
	self:SendToClient(player, "NOTIFY", {message = message})
end

function Dispatcher:NotifyAll(message)
	self:SendToAll("NOTIFY", {message = message})
end

function Dispatcher:SyncQueueOnly()
	local fullQueue = queueManager:GetQueue()
	local limitedQueue = {}
	for i = 1, math.min(10, #fullQueue) do
		table.insert(limitedQueue, fullQueue[i])
	end

	self:SendToAll("QUEUE_UPDATE", {
		queue = limitedQueue,
		totalCount = #fullQueue
	})
end

function Dispatcher:SyncState()
	local playbackState = playbackManager:GetState()

	self:SendToAll("SYNC_STATE", {
		queue = queueManager:GetQueue(),
		currentSong = playbackState.currentSong,
		currentUploader = playbackState.currentUploader,
		isPlaying = playbackState.isPlaying,
		isPaused = playbackState.isPaused,
		startTime = playbackState.startTime,
		duration = playbackState.duration,
		isBlocked = SystemState.IsUIBlocked
	})
end

function Dispatcher:SyncToPlayer(player)
	if not validationService:ValidatePlayer(player) then
		return
	end

	local playbackState = playbackManager:GetState()

	self:SendToClient(player, "SYNC_STATE", {
		queue = queueManager:GetQueue(),
		currentSong = playbackState.currentSong,
		currentUploader = playbackState.currentUploader,
		isPlaying = playbackState.isPlaying,
		isPaused = playbackState.isPaused,
		startTime = playbackState.startTime,
		duration = playbackState.duration,
		isBlocked = SystemState.IsUIBlocked
	})

	if playbackState.isPlaying and playbackState.currentSong then
		playbackManager:SyncToPlayer(Remotes, player)
	end

	-- Sync block state to new player
	if SystemState.IsUIBlocked and not isModeratorPlus(player) then
		self:SendToClient(player, "ADMIN_BLOCK_ACTIVATED", {})
	end
end

-- ====================================
-- BATCHED SYNC
-- ====================================
local syncBatch = {
	pending = false,
	queueUpdatePending = false,
	stateUpdatePending = false
}

local function scheduleBatchedSync(syncType)
	if syncType == "queue" then
		if syncBatch.queueUpdatePending then return end
		syncBatch.queueUpdatePending = true

		task.delay(CONFIG.BATCH_UPDATE_DELAY, function()
			syncBatch.queueUpdatePending = false
			Dispatcher:SyncQueueOnly()
		end)
	elseif syncType == "state" then
		if syncBatch.stateUpdatePending then return end
		syncBatch.stateUpdatePending = true

		task.delay(CONFIG.BATCH_UPDATE_DELAY, function()
			syncBatch.stateUpdatePending = false
			Dispatcher:SyncState()
		end)
	end
end

-- ====================================
-- LAZY SONG LOADING
-- ====================================
local function loadSongOnDemand(musicId, musicTitle)
	if SystemState.LoadingQueue[musicId] then
		local startWait = tick()
		while SystemState.LoadingQueue[musicId] and (tick() - startWait) < 20 do
			task.wait(0.5)
		end
	end

	local sound, duration = MusicStorageHandler:GetSound(musicId)
	if duration > 0 then
		return duration
	end

	if SystemState.FailedLoads[musicId] then
		local failData = SystemState.FailedLoads[musicId]
		if tick() - failData.timestamp < 300 then
			return 0
		end
	end

	SystemState.LoadingQueue[musicId] = true
	sound, duration = MusicStorageHandler:LoadSound(musicId, musicTitle)
	SystemState.LoadingQueue[musicId] = nil

	if duration > 0 then
		return duration
	else
		SystemState.FailedLoads[musicId] = {
			title = musicTitle,
			timestamp = tick()
		}
		return 0
	end
end

-- ====================================
-- PLAYBACK FUNCTIONS
-- ====================================
local playNextSong

playNextSong = function()
	if not queueManager:IsEmpty() then
		local nextSong = queueManager:GetNext()
		local duration = loadSongOnDemand(nextSong.musicData.id, nextSong.musicData.judul)

		if duration > 0 then
			nextSong.musicData.Duration = duration
			nextSong.Duration = duration

			playbackManager.autoNextCallback = playNextSong

			local success = playbackManager:Play(Remotes, nextSong, nextSong.uploader, false)

			if success then
				scheduleBatchedSync("state")
			else
				task.delay(1, playNextSong)
			end
		else
			Dispatcher:NotifyAll("Failed to load song, skipping...")
			task.delay(1, playNextSong)
		end

	elseif CONFIG.AUTO_PLAYLIST_ENABLED then
		local playlistSong = playlistManager:GetNextSong()
		if playlistSong then
			local duration = loadSongOnDemand(playlistSong.id, playlistSong.judul)
			if duration > 0 then
				playlistSong.Duration = duration
				local songData = {
					musicData = playlistSong,
					uploader = "Auto-Playlist",
					Duration = duration
				}

				playbackManager.autoNextCallback = playNextSong

				local success = playbackManager:Play(Remotes, songData, "Auto-Playlist", true)

				if success then
					scheduleBatchedSync("state")
				else
					task.delay(1, playNextSong)
				end
			else
				task.delay(1, playNextSong)
			end
		else
			playbackManager:Stop(Remotes)
			scheduleBatchedSync("state")
		end
	else
		playbackManager:Stop(Remotes)
		scheduleBatchedSync("state")
	end
end

-- ====================================
-- ACTION HANDLERS
-- ====================================
local ActionHandlers = {}

function ActionHandlers:ADD_TO_QUEUE(player, data)
	if not validationService:ValidatePlayer(player) then return end
	if not RateLimiter:CheckLimit(player, "ADD_TO_QUEUE") then
		Dispatcher:Notify(player, "Please wait 2 seconds before adding another song!")
		return
	end

	local musicId = data.musicId
	local isFromPlaylist = data.isFromPlaylist

	if type(musicId) ~= "string" or type(isFromPlaylist) ~= "boolean" then
		return
	end

	local canProceed, spamMsg = validationService:CheckSpamProtection(player)
	if not canProceed then
		Dispatcher:Notify(player, spamMsg)
		return
	end

	local role = RoleSystem:GetPlayerRole(player)
	if RoleSystem.Config.RoleHierarchy[role] < RoleSystem.Config.RoleHierarchy.VIP then
		Dispatcher:Notify(player, "Minimum rank VIP required to add songs!")
		return
	end

	local canAddCooldown, cooldownMsg = validationService:CheckCooldown(player, CONFIG.COOLDOWNS)
	if not canAddCooldown then
		Dispatcher:Notify(player, cooldownMsg)
		return
	end

	if not SystemState.InitialPreloadComplete then
		Dispatcher:Notify(player, "System is preloading music library, please wait...")
		return
	end

	task.spawn(function()
		local musicData
		if isFromPlaylist then
			musicData = MusicModule:GetMusicById(musicId)
			if not musicData then
				Dispatcher:Notify(player, "Song not found in playlist!")
				return
			end
		else
			local valid, data, reason = validationService:ValidateMusicId(musicId)
			if not valid then
				Dispatcher:Notify(player, "Invalid Music ID! Please check and try again.")
				return
			end
			musicData = data
		end

		musicData.Duration = CONFIG.DEFAULT_SONG_DURATION

		local success, errorMsg = queueManager:AddToQueue(musicData, player.DisplayName, player.UserId)

		if not success then
			Dispatcher:Notify(player, errorMsg)
			return
		end

		validationService:UpdateCooldown(player)
		scheduleBatchedSync("queue")

		local queuePosition = queueManager:GetSize()
		Dispatcher:Notify(player, string.format("'%s' added to queue (Position: #%d)", musicData.judul, queuePosition))

		if not playbackManager:IsPlaying() then
			task.delay(0.5, playNextSong)
		end
	end)
end

function ActionHandlers:CONTROL_NEXT(player, data)
	if not validationService:ValidatePlayer(player) then return end

	local role = RoleSystem:GetPlayerRole(player)
	local roleHierarchy = RoleSystem.Config.RoleHierarchy[role] or 0

	if roleHierarchy < RoleSystem.Config.RoleHierarchy.VIP then
		Dispatcher:Notify(player, "Minimum rank VIP required to skip!")
		return
	end

	-- Moderator+ can skip directly without vote
	if roleHierarchy >= 4 then
		local currentSong = playbackManager:GetCurrentSong()
		if currentSong then
			Dispatcher:NotifyAll(string.format("%s (%s) skipped: %s", player.DisplayName, role, currentSong.judul or "Unknown"))
			playNextSong()
		else
			Dispatcher:Notify(player, "No song is currently playing!")
		end
		return
	end

	-- VIP/VVIP need to start vote
	local currentSong = playbackManager:GetCurrentSong()
	if not currentSong then 
		Dispatcher:Notify(player, "No song is currently playing!")
		return 
	end

	if playbackManager:IsFromPlaylist() then
		Dispatcher:Notify(player, "Cannot skip auto-playlist songs! Wait for user-added songs.")
		return
	end

	if not RateLimiter:CheckLimit(player, "SKIP_VOTE_INITIATE") then
		Dispatcher:Notify(player, "Please wait before starting another skip vote!")
		return
	end

	local success, msg = skipVoteManager:StartVote(player, currentSong, Dispatcher)
	if not success then
		Dispatcher:Notify(player, msg)
	else
		Dispatcher:NotifyAll(string.format("%s started a skip vote for: %s", player.DisplayName, currentSong.judul or "Unknown"))
	end
end

function ActionHandlers:CONTROL_PREV(player, data)
	if not validationService:ValidatePlayer(player) then return end
	local role = RoleSystem:GetPlayerRole(player)
	local roleHierarchy = RoleSystem.Config.RoleHierarchy[role] or 0

	if roleHierarchy < 4 then
		Dispatcher:Notify(player, "Only Moderator+ can restart songs!")
		return 
	end

	if playbackManager:GetCurrentSong() then
		local currentSong = playbackManager:GetCurrentSong()

		playbackManager.autoNextCallback = playNextSong

		playbackManager:Restart(Remotes)
		scheduleBatchedSync("state")
		Dispatcher:NotifyAll(string.format("%s (%s) restarted: %s", player.DisplayName, role, currentSong.judul or "Unknown"))
	else
		Dispatcher:Notify(player, "No song to restart!")
	end
end

function ActionHandlers:CONTROL_PAUSE(player, data)
	if not validationService:ValidatePlayer(player) then return end
	local role = RoleSystem:GetPlayerRole(player)
	local roleHierarchy = RoleSystem.Config.RoleHierarchy[role] or 0

	if roleHierarchy < 4 then
		Dispatcher:Notify(player, "Only Moderator+ can pause/play music!")
		return 
	end

	if not playbackManager:GetCurrentSong() then
		Dispatcher:Notify(player, "No song is currently playing!")
		return
	end

	playbackManager:Pause(Remotes)
	scheduleBatchedSync("state")

	local state = playbackManager:GetState()
	if state.isPaused then
		Dispatcher:NotifyAll(string.format("%s (%s) paused the music", player.DisplayName, role))
	else
		Dispatcher:NotifyAll(string.format("%s (%s) resumed the music", player.DisplayName, role))
	end
end

function ActionHandlers:SKIP_VOTE_YES(player, data)
	if not validationService:ValidatePlayer(player) then return end
	local success, passed = skipVoteManager:CastVote(player, "yes", Dispatcher)

	if not success then
		Dispatcher:Notify(player, "Unable to cast vote. No active vote or you already voted!")
		return
	end

	if passed then
		local currentSong = playbackManager:GetCurrentSong()
		Dispatcher:NotifyAll(string.format("Skip vote passed! Skipping: %s", currentSong and currentSong.judul or "Unknown"))
		task.wait(1)
		playNextSong()
		skipVoteManager:EndVote(Dispatcher, true)
	else
		Dispatcher:Notify(player, "Your vote has been counted!")
	end
end

function ActionHandlers:SKIP_VOTE_NO(player, data)
	if not validationService:ValidatePlayer(player) then return end
	local success = skipVoteManager:CastVote(player, "no", Dispatcher)

	if success then
		Dispatcher:Notify(player, "Your vote has been counted!")
	else
		Dispatcher:Notify(player, "Unable to cast vote. No active vote or you already voted!")
	end
end

function ActionHandlers:ADMIN_TOGGLE_BLOCK(player, data)
	if not validationService:ValidatePlayer(player) then return end

	-- Check if player is Moderator+
	if not isModeratorPlus(player) then
		Dispatcher:Notify(player, "Minumum Role Admin can toggle UI block!")
		return
	end

	local isBlocked = toggleUIBlock()

	if isBlocked then
		-- Block activated
		Dispatcher:NotifyAll("Admin mengambil alih akses musik")

		-- Send block event to non-moderators
		for _, plr in ipairs(Players:GetPlayers()) do
			if not isModeratorPlus(plr) then
				Dispatcher:SendToClient(plr, "ADMIN_BLOCK_ACTIVATED", {})
			else
				-- Update button text for moderators
				Dispatcher:SendToClient(plr, "ADMIN_BLOCK_ACTIVATED", {})
			end
		end
	else
		-- Block deactivated
		Dispatcher:NotifyAll("Akses musik dikembalikan")

		-- Send unblock event to all
		for _, plr in ipairs(Players:GetPlayers()) do
			Dispatcher:SendToClient(plr, "ADMIN_BLOCK_DEACTIVATED", {})
		end
	end
end

-- ====================================
-- MAIN DISPATCHER
-- ====================================
dispatchAction.OnServerEvent:Connect(function(player, action)
	if not validationService:ValidatePlayer(player) then return end
	if type(action) ~= "table" or type(action.type) ~= "string" then return end

	local validActions = {
		ADD_TO_QUEUE = true,
		CONTROL_NEXT = true,
		CONTROL_PREV = true,
		CONTROL_PAUSE = true,
		SKIP_VOTE_YES = true,
		SKIP_VOTE_NO = true,
		ADMIN_TOGGLE_BLOCK = true
	}

	if not validActions[action.type] then return end

	local handler = ActionHandlers[action.type]
	if handler then
		pcall(function()
			handler(ActionHandlers, player, action.payload or {})
		end)
	end
end)

-- ====================================
-- REQUEST SYNC HANDLER
-- ====================================
requestSync.OnServerEvent:Connect(function(player)
	if not validationService:ValidatePlayer(player) then
		return
	end

	if not RateLimiter:CheckLimit(player, "REQUEST_SYNC") then
		Dispatcher:Notify(player, "Sync request too fast, please wait...")
		return
	end

	local retryData = RetryTracker:Track(player)

	Dispatcher:Notify(player, string.format("Syncing... (Attempt #%d)", retryData.count))

	task.wait(0.3)

	if not validationService:ValidatePlayer(player) then
		return
	end

	local playbackState = playbackManager:GetState()

	Dispatcher:SyncToPlayer(player)

	task.delay(0.5, function()
		if validationService:ValidatePlayer(player) then
			if playbackState.isPlaying and playbackState.currentSong then
				local elapsed = playbackState.elapsedTime or 0
				Dispatcher:Notify(player, string.format(
					"Synced! Now playing: %s (%.0fs/%.0fs)",
					playbackState.currentSong.judul or "Unknown",
					elapsed,
					playbackState.duration or 0
					))
				RetryTracker:Reset(player)
			elseif playbackState.currentSong then
				Dispatcher:Notify(player, string.format(
					"Synced! Song loaded: %s (Paused)",
					playbackState.currentSong.judul or "Unknown"
					))
				RetryTracker:Reset(player)
			else
				Dispatcher:Notify(player, "Synced! Enjoy")
			end
		end
	end)

	if retryData.count >= 5 then
		Dispatcher:Notify(player, string.format(
			"Multiple sync attempts detected (%d times). If music still not working, please contact an admin.",
			retryData.count
			))
	end
end)

