function MusicModule:GetMusicById(musicId)
	for _, music in ipairs(self.MusicList) do
		if music.id == musicId then
			return music
		end
	end
	return nil
end

function MusicModule:GetAllMusic()
	local sortedList = {}

	for _, music in ipairs(self.MusicList) do
		table.insert(sortedList, music)
	end

	table.sort(sortedList, function(a, b)
		return string.lower(a.judul) < string.lower(b.judul)
	end)

	return sortedList
end

function MusicModule:SearchMusic(query)
	if query == "" then
		return self:GetAllMusic()
	end

	local results = {}
	local lowerQuery = string.lower(query)

	for _, music in ipairs(self.MusicList) do
		if string.find(string.lower(music.judul), lowerQuery, 1, true) then
			table.insert(results, music)
		end
	end

	table.sort(results, function(a, b)
		return string.lower(a.judul) < string.lower(b.judul)
	end)

	return results
end

return MusicModule
