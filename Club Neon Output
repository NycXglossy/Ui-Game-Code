		pcall(function()
			item.old.Name = item.name
			item.old.Parent = item.parent
			if item.old:IsA("BaseScript") and item.disabled ~= nil then item.old.Disabled = item.disabled end
		end)
	end
	for i = #createdFolders, 1, -1 do
