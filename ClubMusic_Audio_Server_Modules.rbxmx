<?xml version="1.0" encoding="utf-8"?>
<roblox version="4">
  <Item class="Folder" referent="RBX0">
    <Properties><string name="Name">ClubMusicAudioModules</string></Properties>
    <Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">ClubMusicAudioBackend</string><ProtectedString name="Source"><![CDATA[--!strict
-- ClubMusic modern Roblox audio backend.
-- This module owns only its injected AudioPlayer graph. The server controller
-- remains the sole authority for queue state, track selection, and transitions.
-- It is opt-in until the experience has completed Studio/multiplayer validation.

local Backend = {}
Backend.__index = Backend

export type Config = {
	Parent: Instance?,
	Name: string?,
	Volume: number?,
	PlaybackSpeed: number?,
	InitialGain: number?,
	OutputPlayer: Player?,
}

local function finite(value: any): boolean
	return typeof(value) == "number" and value == value and math.abs(value) < math.huge
end

local function makeWire(parent: Instance, source: Instance, target: Instance): Wire
	local wire = Instance.new("Wire")
	wire.SourceInstance = source
	wire.TargetInstance = target
	wire.Parent = parent
	return wire
end

function Backend.new(config: Config?)
	config = config or {}
	local parent = config.Parent or game:GetService("SoundService")
	local name = config.Name or "ClubMusicModernAudio"
	local root = Instance.new("Folder")
	root.Name = name
	root:SetAttribute("ManagedByClubMusicAudioBackend", true)
	root.Parent = parent

	local player = Instance.new("AudioPlayer")
	player.Name = "AudioPlayer"
	player.AutoLoad = true
	player.AutoPlay = false
	player.Looping = false
	player.Volume = math.clamp(if finite(config.Volume) then config.Volume else 1, 0, 10)
	player.PlaybackSpeed = math.clamp(if finite(config.PlaybackSpeed) then config.PlaybackSpeed else 1, 0.05, 20)
	player.Parent = root

	local equalizer = Instance.new("AudioEqualizer")
	equalizer.Name = "MusicEqualizer"
	equalizer.MidRange = NumberRange.new(400, 3000)
	equalizer.LowGain = 0
	equalizer.MidGain = 0
	equalizer.HighGain = 0
	equalizer.Parent = root

	local fader = Instance.new("AudioFader")
	fader.Name = "MusicFader"
	fader.Volume = math.clamp(if finite(config.InitialGain) then config.InitialGain else 1, 0, 1)
	fader.Parent = root

	local output = Instance.new("AudioDeviceOutput")
	output.Name = "MusicOutput"
	if config.OutputPlayer then output.Player = config.OutputPlayer end
	output.Parent = root

	local inputWire = makeWire(root, player, equalizer)
	local equalizerWire = makeWire(root, equalizer, fader)
	local outputWire = makeWire(root, fader, output)

	return setmetatable({
		root = root,
		player = player,
		fader = fader,
		equalizer = equalizer,
		output = output,
		wires = { inputWire, equalizerWire, outputWire },
		destroyed = false,
		paused = false,
		pausedAt = 0,
		currentAsset = "",
	}, Backend)
end

function Backend:IsAvailable(): boolean
	return not self.destroyed and self.player ~= nil and self.player.Parent ~= nil
end

function Backend:SetAsset(asset: string): (boolean, string?)
	if not self:IsAvailable() then return false, "Audio backend is unavailable." end
	if typeof(asset) ~= "string" or #asset > 64 or not string.match(asset, "^rbxassetid://%d+$") then
		return false, "Invalid audio asset ID."
	end
	local stopped, stopError = self:Stop()
	if not stopped then return false, stopError or "The current audio could not be stopped safely." end
	local previousAsset = self.currentAsset
	local ok, err = pcall(function()
		self.player.Asset = asset
	end)
	if not ok then
		-- Keep the previous asset selected if replacement fails. Playback remains
		-- stopped; the controller can explicitly retry or resume it.
		if previousAsset ~= "" then
			pcall(function() self.player.Asset = previousAsset end)
		end
		return false, tostring(err)
	end
	self.currentAsset = asset
	self.paused = false
	self.pausedAt = 0
	return true, nil
end

function Backend:IsReady(): boolean
	if not self:IsAvailable() then return false end
	local ok, ready = pcall(function() return self.player.IsReady end)
	return ok and ready == true
end

-- Readiness is a multi-property condition for safe handoff: the asset must be
-- selected, the decoder must be ready, and duration must be finite and positive.
function Backend:GetReadinessSnapshot(): {ready: boolean, length: number, asset: string}
	if not self:IsAvailable() then
		return { ready = false, length = 0, asset = "" }
	end
	local ok, ready, length, asset = pcall(function()
		return self.player.IsReady, self.player.TimeLength, self.player.Asset
	end)
	if not ok then return { ready = false, length = 0, asset = self.currentAsset } end
	local validLength = if finite(length) then math.max(0, length) else 0
	local validAsset = if typeof(asset) == "string" then asset else ""
	-- A decoder can briefly report IsReady for a previous selection while a
	-- replacement asset is loading. Never expose that stale readiness as usable.
	local assetMatchesSelection = self.currentAsset ~= "" and validAsset == self.currentAsset
	return {
		ready = ready == true and validLength > 0 and assetMatchesSelection,
		length = validLength,
		asset = validAsset,
	}
end

function Backend:GetTimePosition(): number
	if not self:IsAvailable() then return 0 end
	local ok, position = pcall(function() return self.player.TimePosition end)
	return if ok and finite(position) then math.max(0, position) else 0
end

function Backend:GetTimeLength(): number
	if not self:IsReady() then return 0 end
	local ok, length = pcall(function() return self.player.TimeLength end)
	return if ok and finite(length) then math.max(0, length) else 0
end

function Backend:IsPlaying(): boolean
	if not self:IsAvailable() or self.paused then return false end
	local ok, playing = pcall(function() return self.player.IsPlaying end)
	return ok and playing == true
end

function Backend:Play(asset: string?, position: number?): (boolean, string?)
	if position ~= nil and (not finite(position) or position < 0) then
		return false, "Invalid playback position."
	end
	if asset ~= nil then
		local ok, err = self:SetAsset(asset)
		if not ok then return false, err end
	end
	if not self:IsAvailable() then return false, "Audio backend is unavailable." end
	local wasPaused = self.paused
	local previousPausedAt = self.pausedAt
	local ok, err = pcall(function()
		if position ~= nil then self.player.TimePosition = position end
		self.player:Play()
	end)
	if not ok then
		-- Play can fail after the engine has partially changed state. Prefer
		-- the engine's observable state over leaving a false paused snapshot.
		local stateOk, isPlaying = pcall(function() return self.player.IsPlaying end)
		if stateOk and isPlaying == true then
			self.paused = false
			self.pausedAt = 0
		else
			self.paused = wasPaused
			self.pausedAt = previousPausedAt
		end
		return false, tostring(err)
	end
	self.paused = false
	self.pausedAt = 0
	return true, nil
end

function Backend:GetAsset(): string
	if not self:IsAvailable() then return "" end
	if self.currentAsset ~= "" then return self.currentAsset end
	local ok, asset = pcall(function() return self.player.Asset end)
	return if ok and typeof(asset) == "string" then asset else ""
end

-- Re-select the current asset and restart it from a known position. The caller
-- owns readiness waits and decides when a recovered source may be committed.
function Backend:Reload(position: number?): (boolean, string?)
	if not self:IsAvailable() then return false, "Audio backend is unavailable." end
	local asset = self:GetAsset()
	if asset == "" then return false, "No audio asset is selected for reload." end
	local wasPaused = self.paused
	local target = if position == nil then (if wasPaused then self.pausedAt else self:GetTimePosition()) else position
	if not finite(target) or target < 0 then return false, "Invalid reload position." end

	-- Force a fresh decoder selection even when the requested asset ID matches.
	local resetOk, resetError = pcall(function()
		self.player:Stop()
		self.player.Asset = ""
	end)
	if not resetOk then return false, tostring(resetError) end
	self.currentAsset = ""
	self.paused = false
	self.pausedAt = 0
	task.wait()
	local selected, selectError = self:SetAsset(asset)
	if not selected then return false, selectError end

	local deadline = os.clock() + 8
	local ready = false
	repeat
		task.wait(0.1)
		local readiness = self:GetReadinessSnapshot()
		ready = readiness.ready == true and readiness.asset == asset and readiness.length > 0
	until ready or os.clock() >= deadline
	if not ready then return false, "The AudioPlayer decoder did not become ready within 8 seconds." end

	local seeked, seekError = self:Seek(target)
	if not seeked then return false, seekError end
	if wasPaused then
		self.pausedAt = self:GetTimePosition()
		self.paused = true
		return true, nil
	end
	return self:Play()
end

-- AudioPlayer has no Sound-style Pause method. Preserve the playhead and stop;
-- Resume restores the saved position and starts the same asset again.
function Backend:Pause(): (boolean, string?, number?)
	if not self:IsAvailable() then return false, "Audio backend is unavailable.", nil end
	if self.paused then return true, nil, self.pausedAt end
	local playingOk, playing = pcall(function() return self.player.IsPlaying end)
	if not playingOk then return false, "Audio playback state could not be read for pause.", nil end
	if not playing then
		local positionOk, position = pcall(function() return self.player.TimePosition end)
		if not positionOk or not finite(position) or position < 0 then
			return false, "Audio playhead could not be captured for pause.", nil
		end
		self.pausedAt = position
		self.paused = true
		return true, nil, position
	end
	local positionOk, position = pcall(function() return self.player.TimePosition end)
	if not positionOk or not finite(position) or position < 0 then
		return false, "Audio playhead could not be captured for pause.", nil
	end
	local ok, err = pcall(function() self.player:Stop() end)
	if not ok then return false, tostring(err), nil end
	self.pausedAt = position
	self.paused = true
	return true, nil, position
end

function Backend:Resume(): (boolean, string?)
	if not self:IsAvailable() then return false, "Audio backend is unavailable." end
	if not self.paused then return true, nil end
	if not self:IsReady() then return false, "Audio asset is not ready to resume." end
	local position = math.max(0, self.pausedAt)
	local ok, err = pcall(function()
		self.player.TimePosition = position
		self.player:Play()
	end)
	if not ok then
		-- Retain the saved pause point unless the engine actually began playing.
		-- This makes a retry safe after a transient property/API failure.
		local stateOk, isPlaying = pcall(function() return self.player.IsPlaying end)
		if stateOk and isPlaying == true then
			self.paused = false
			self.pausedAt = 0
		end
		return false, tostring(err)
	end
	self.paused = false
	self.pausedAt = 0
	return true, nil
end

function Backend:Stop(): (boolean, string?)
	if not self:IsAvailable() then return false, "Audio backend is unavailable." end
	-- Keep the logical pause snapshot intact unless the engine confirms Stop.
	-- A transient Stop failure must not silently turn a paused deck into a
	-- playing-state deck or discard the position needed by Resume.
	local ok, err = pcall(function() self.player:Stop() end)
	if not ok then return false, tostring(err) end
	self.paused = false
	self.pausedAt = 0
	return true, nil
end

function Backend:Seek(position: number): (boolean, string?)
	if not self:IsAvailable() or not finite(position) or position < 0 then
		return false, "Invalid seek request."
	end
	local target = position
	if self:IsReady() then
		local lengthOk, length = pcall(function() return self.player.TimeLength end)
		if lengthOk and finite(length) and length > 0 then
			if target > length then return false, "Seek position exceeds the loaded track duration." end
		end
	end
	local previousPausedAt = self.pausedAt
	local ok, err = pcall(function() self.player.TimePosition = target end)
	-- Some engine/property failures can occur after a partial playhead update.
	-- Read back the actual position so a paused snapshot never advertises a
	-- stale point when the AudioPlayer did move before reporting the error.
	local readOk, actualPosition = pcall(function() return self.player.TimePosition end)
	if readOk and finite(actualPosition) and actualPosition >= 0 and self.paused then
		self.pausedAt = actualPosition
	end
	if not ok then
		if not readOk or not finite(actualPosition) or actualPosition < 0 then
			self.pausedAt = previousPausedAt
		end
		return false, tostring(err)
	end
	if not readOk or not finite(actualPosition) or actualPosition < 0 then
		if self.paused then self.pausedAt = previousPausedAt end
		return false, "The seek position could not be verified."
	end
	return true, nil
end

function Backend:SetGain(value: number): (boolean, string?)
	if not self:IsAvailable() or not finite(value) then return false, "Invalid audio gain." end
	self.fader.Volume = math.clamp(value, 0, 1)
	return true, nil
end

function Backend:GetGain(): number
	if not self:IsAvailable() or not self.fader then return 0 end
	return math.clamp(self.fader.Volume, 0, 1)
end

function Backend:SetEqualizer(lowGain: number, midGain: number, highGain: number): (boolean, string?)
	if not self:IsAvailable() or not self.equalizer
		or not finite(lowGain) or not finite(midGain) or not finite(highGain) then
		return false, "Invalid equalizer settings."
	end
	self.equalizer.LowGain = math.clamp(lowGain, -20, 10)
	self.equalizer.MidGain = math.clamp(midGain, -20, 10)
	self.equalizer.HighGain = math.clamp(highGain, -20, 10)
	return true, nil
end

function Backend:GetEqualizer(): {low: number, mid: number, high: number}
	if not self:IsAvailable() or not self.equalizer then
		return { low = 0, mid = 0, high = 0 }
	end
	return { low = self.equalizer.LowGain, mid = self.equalizer.MidGain, high = self.equalizer.HighGain }
end

function Backend:SetPlaybackSpeed(value: number): (boolean, string?)
	if not self:IsAvailable() or not finite(value) then return false, "Invalid playback speed." end
	self.player.PlaybackSpeed = math.clamp(value, 0.5, 2)
	return true, nil
end

function Backend:GetPlayer(): AudioPlayer?
	return if self:IsAvailable() then self.player else nil
end

function Backend:Cleanup()
	if self.destroyed then return end
	self.destroyed = true
	if self.root then pcall(function() self.root:Destroy() end) end
	self.root = nil
	self.player = nil
	self.fader = nil
	self.equalizer = nil
	self.output = nil
	table.clear(self.wires)
end

return Backend
]]></ProtectedString></Properties></Item>
    <Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">ClubMusicAudioCrossfadeManager</string><ProtectedString name="Source"><![CDATA[--!strict
-- Controller-invoked crossfade coordinator. No independent queue or playback loop.
-- The caller supplies both decks and owns when a transition is committed.
-- Cancellation invalidates the running generation before touching either deck.
local Manager = {}
Manager.__index = Manager

export type Deck = {
	SetGain: (self: any, gain: number) -> (boolean, string?),
	SetAsset: (self: any, asset: string) -> (boolean, string?),
	IsReady: (self: any) -> boolean,
	Play: (self: any, asset: string?, position: number?) -> (boolean, string?),
	Stop: (self: any) -> (boolean, string?),
	GetTimePosition: (self: any) -> number,
	Cleanup: (self: any) -> (),
}

local function safeMethod(object: any, methodName: string, ...: any): (boolean, any, any)
	if object == nil or typeof(object[methodName]) ~= "function" then
		return false, nil, "Missing deck method: " .. methodName
	end
	return pcall(object[methodName], object, ...)
end

local function readOutgoingGain(context: any): (boolean, number)
	if typeof(context) ~= "table" or typeof(context.GetOutgoingGain) ~= "function" then
		return false, 0
	end
	local ok, value = pcall(context.GetOutgoingGain)
	if not ok or typeof(value) ~= "number" or value ~= value
		or value < 0 or value > 1 or value == math.huge then
		return false, 0
	end
	return true, value
end

local function setOutgoingGain(context: any, gain: number): boolean
	-- Missing gain control is a hard failure, never a silent full-volume fallback.
	if typeof(context) ~= "table" or typeof(context.SetOutgoingGain) ~= "function" then
		return false
	end
	local ok, result = pcall(context.SetOutgoingGain, gain)
	return ok and result ~= false
end

function Manager.new(context)
	assert(typeof(context) == "table", "Crossfade manager requires controller context.")
	assert(typeof(context.CreateDeck) == "function", "Crossfade manager requires CreateDeck.")
	assert(typeof(context.SetOutgoingGain) == "function", "Crossfade manager requires SetOutgoingGain; refusing an unsafe full-volume dual-deck fade.")
	assert(typeof(context.GetOutgoingGain) == "function", "Crossfade manager requires GetOutgoingGain so it can preserve the active gain profile.")
	assert(typeof(context.OnCommit) == "function", "Crossfade manager requires OnCommit.")
	return setmetatable({
		context = context,
		generation = 0,
		active = false,
		destroyed = false,
		incoming = nil,
	}, Manager)
end

function Manager:Cancel(): (boolean, string?)
	-- Invalidate first so a sleeping transition coroutine cannot commit afterward.
	self.generation += 1
	self.active = false
	local incoming = self.incoming
	self.incoming = nil
	local restoreGain = self.outgoingBaseGain
	self.outgoingBaseGain = nil

	local cleanupFailed = false
	if incoming then
		local stopOk, stopResult = safeMethod(incoming, "Stop")
		if not stopOk or stopResult == false then cleanupFailed = true end
		local cleanupOk = safeMethod(incoming, "Cleanup")
		if not cleanupOk then cleanupFailed = true end
	end

	-- Restore the still-controller-owned outgoing deck after an interrupted fade.
	local restoreFailed = false
	if typeof(restoreGain) == "number" and not setOutgoingGain(self.context, restoreGain) then
		restoreFailed = true
	end
	if cleanupFailed or restoreFailed then
		return false, if restoreFailed then "Outgoing gain restoration failed." else "Incoming deck cleanup failed."
	end
	return true, nil
end

function Manager:Begin(asset: string, duration: number)
	if self.destroyed or typeof(self.context) ~= "table" then
		return false, "Crossfade manager is unavailable."
	end
	if self.active then return false, "A crossfade is already in progress." end
	if typeof(asset) ~= "string" or #asset > 64 or not string.match(asset, "^rbxassetid://%d+$") then
		return false, "Invalid incoming audio asset."
	end
	if typeof(duration) ~= "number" or duration ~= duration or duration < 0.25 or duration > 12 then
		return false, "Crossfade duration must be between 0.25 and 12 seconds."
	end

	local createOk, incoming = pcall(self.context.CreateDeck)
	if not createOk or typeof(incoming) ~= "table" then
		return false, "Could not create the incoming audio deck."
	end
	for _, methodName in ipairs({ "Play", "SetGain", "SetAsset", "IsReady", "Stop", "Cleanup" }) do
		if typeof(incoming[methodName]) ~= "function" then
			pcall(function() incoming:Cleanup() end)
			return false, "Incoming audio deck is missing " .. methodName .. "."
		end
	end

	local gainOk, outgoingBaseGain = readOutgoingGain(self.context)
	if not gainOk then
		safeMethod(incoming, "Cleanup")
		return false, "Could not read the outgoing audio gain."
	end

	local generation = self.generation + 1
	self.generation = generation
	self.outgoingBaseGain = outgoingBaseGain
	self.incoming = incoming
	self.active = true

	local gainOk, gainResult, gainError = safeMethod(incoming, "SetGain", 0)
	if not gainOk or gainResult == false then
		self:Cancel()
		return false, tostring(gainError or "Could not initialize incoming deck gain.")
	end
	local assetOk, assetResult, assetError = safeMethod(incoming, "SetAsset", asset)
	if not assetOk or assetResult == false then
		self:Cancel()
		return false, tostring(assetError or "Could not assign the incoming asset.")
	end

	-- Wait for the incoming asset before fading; otherwise the outgoing deck
	-- could be attenuated while the AudioPlayer is still buffering.
	task.spawn(function()
		local readyDeadline = os.clock() + 8
		local ready = false
		while os.clock() < readyDeadline and self.generation == generation
			and self.active and self.incoming == incoming and not self.destroyed do
			local readyOk, readyValue = safeMethod(incoming, "IsReady")
			if readyOk and readyValue == true then ready = true; break end
			task.wait(0.1)
		end
		if self.generation ~= generation or not self.active or self.incoming ~= incoming or self.destroyed then return end
		if not ready then self:Cancel(); return end

		-- Prepare early, but do not attenuate the current track until its
		-- remaining-time window reaches the requested fade duration.
		if typeof(self.context.GetRemainingTime) == "function" then
			while self.generation == generation and self.active and self.incoming == incoming and not self.destroyed do
				local remainingOk, remaining = pcall(self.context.GetRemainingTime)
				if not remainingOk or typeof(remaining) ~= "number" or remaining ~= remaining
					or remaining < 0 or remaining == math.huge then
					self:Cancel()
					return
				end
				if remaining <= duration then break end
				task.wait(math.min(0.1, remaining - duration))
			end
		end
		if self.generation ~= generation or not self.active or self.incoming ~= incoming or self.destroyed then return end

		local playOk, playResult = safeMethod(incoming, "Play", nil, 0)
		if not playOk or playResult == false then self:Cancel(); return end
		local elapsed = 0
		local step = 0.05
		while elapsed < duration and self.generation == generation and not self.destroyed do
			local alpha = math.clamp(elapsed / duration, 0, 1)
			local incomingOk, incomingResult = safeMethod(incoming, "SetGain", outgoingBaseGain * alpha)
			if not incomingOk or incomingResult == false then self:Cancel(); return end
			if not setOutgoingGain(self.context, outgoingBaseGain * (1 - alpha)) then self:Cancel(); return end
			task.wait(step)
			elapsed += step
		end
		if self.generation ~= generation or self.destroyed or self.incoming ~= incoming then return end

		local fullGainOk, fullGainResult = safeMethod(incoming, "SetGain", outgoingBaseGain)
		if not fullGainOk or fullGainResult == false or not setOutgoingGain(self.context, 0) then
			self:Cancel()
			return
		end

		-- OnCommit must atomically transfer controller ownership or return false.
		local commitOk, commitResult = pcall(self.context.OnCommit, incoming)
		if not commitOk or commitResult == false then self:Cancel(); return end
		if self.generation ~= generation or self.incoming ~= incoming then return end
		self.incoming = nil
		self.outgoingBaseGain = nil
		self.active = false
	end)
	return true, nil
end

function Manager:Cleanup(): (boolean, string?)
	if self.destroyed then return true, nil end
	local cancelOk, cancelError = self:Cancel()
	self.destroyed = true
	self.context = nil
	if not cancelOk then return false, cancelError end
	return true, nil
end

return Manager
]]></ProtectedString></Properties></Item>
    <Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">ClubMusicAudioQualityProfiles</string><ProtectedString name="Source"><![CDATA[--!strict
-- Validated audio quality profiles. Applies only to a supplied AudioPlayer;
-- per-player preferences must use a client-local graph, never a shared server gain.
local Profiles = {}
Profiles.__index = Profiles

local DEFINITIONS = {
	Standard = { playbackSpeed = 1, gain = 1, low = 0, mid = 0, high = 0 },
	Soft = { playbackSpeed = 1, gain = 0.9, low = -2, mid = 1, high = -2 },
	Bass = { playbackSpeed = 1, gain = 1, low = 5, mid = 0, high = 1 },
	Night = { playbackSpeed = 1, gain = 0.72, low = -3, mid = 1, high = -4 },
}

function Profiles.new(context)
	assert(typeof(context) == "table", "Audio quality profiles require context.")
	return setmetatable({ context = context, current = "Standard", destroyed = false }, Profiles)
end

function Profiles:GetProfiles()
	local copy = {}
	for name, values in pairs(DEFINITIONS) do copy[name] = table.clone(values) end
	return copy
end

function Profiles:Apply(name: string)
	if self.destroyed then return false, "Audio quality service is unavailable." end
	local profile = DEFINITIONS[name]
	if not profile then return false, "Unknown audio quality profile." end
	if typeof(self.context.SetPlaybackSpeed) == "function" then
		local ok, result = pcall(self.context.SetPlaybackSpeed, profile.playbackSpeed)
		if not ok or result == false then return false, "Could not apply playback speed." end
	end
	if typeof(self.context.SetGain) == "function" then
		local ok, result = pcall(self.context.SetGain, profile.gain)
		if not ok or result == false then return false, "Could not apply audio gain." end
	end
	if typeof(self.context.SetEqualizer) == "function" then
		local ok, result = pcall(self.context.SetEqualizer, profile.low, profile.mid, profile.high)
		if not ok or result == false then return false, "Could not apply equalizer settings." end
	end
	self.current = name
	return true, name
end

function Profiles:GetCurrent()
	return self.current
end

function Profiles:Cleanup()
	self.destroyed = true
	self.context = nil
end

return Profiles
]]></ProtectedString></Properties></Item>
    <Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">ClubMusicDJSessionManager</string><ProtectedString name="Source"><![CDATA[--!strict
-- DJ session state facade. Controller supplies authorization and the only
-- callback that changes active DJ ownership; this module never mutates playback.
local Sessions = {}
Sessions.__index = Sessions

function Sessions.new(context)
	assert(typeof(context) == "table", "DJ session service requires context.")
	assert(typeof(context.Authorize) == "function", "DJ session service requires authorization.")
	assert(typeof(context.OnHandoff) == "function", "DJ session service requires OnHandoff.")
	return setmetatable({ context = context, current = nil, history = {}, destroyed = false }, Sessions)
end

local function validPlayer(player)
	return typeof(player) == "Instance" and player:IsA("Player") and player.Parent ~= nil
end

function Sessions:Start(player: Player)
	if self.destroyed then return false, "DJ session service is unavailable." end
	if not validPlayer(player) then return false, "A connected DJ is required." end
	local ok, allowed = pcall(self.context.Authorize, player, "Start")
	if not ok or allowed ~= true then return false, "You are not authorized to start a DJ session." end
	if self.current then return false, "A DJ session is already active." end
	self.current = { userId = player.UserId, name = player.Name, startedAt = os.time() }
	return true, table.clone(self.current)
end

function Sessions:Handoff(fromPlayer: Player, toPlayer: Player)
	if self.destroyed or not self.current then return false, "No active DJ session." end
	if not validPlayer(fromPlayer) or not validPlayer(toPlayer) then return false, "Both DJs must be connected." end
	if self.current.userId ~= fromPlayer.UserId then return false, "Only the active DJ can hand off the session." end
	local ok, allowed = pcall(self.context.Authorize, fromPlayer, "Handoff")
	if not ok or allowed ~= true then return false, "You are not authorized to hand off this session." end
	local callbackOk, accepted = pcall(self.context.OnHandoff, fromPlayer, toPlayer)
	if not callbackOk or accepted == false then return false, "The controller rejected the DJ handoff." end
	local previous = table.clone(self.current)
	table.insert(self.history, 1, { userId = previous.userId, name = previous.name, endedAt = os.time(), reason = "Handoff" })
	while #self.history > 50 do table.remove(self.history) end
	self.current = { userId = toPlayer.UserId, name = toPlayer.Name, startedAt = os.time() }
	return true, table.clone(self.current)
end

function Sessions:End(player: Player)
	if self.destroyed or not self.current then return false, "No active DJ session." end
	if not validPlayer(player) or self.current.userId ~= player.UserId then return false, "Only the active DJ can end this session." end
	local ok, allowed = pcall(self.context.Authorize, player, "End")
	if not ok or allowed ~= true then return false, "You are not authorized to end this session." end
	table.insert(self.history, 1, { userId = self.current.userId, name = self.current.name, endedAt = os.time(), reason = "Ended" })
	while #self.history > 50 do table.remove(self.history) end
	self.current = nil
	return true, nil
end

function Sessions:GetState()
	return { current = if self.current then table.clone(self.current) else nil, history = table.clone(self.history) }
end

-- Server-only lifecycle cleanup; callers must not expose this through a RemoteEvent.
function Sessions:EndForDeparture(userId: number): boolean
	if self.destroyed or not self.current or self.current.userId ~= userId then return false end
	table.insert(self.history, 1, {
		userId = self.current.userId,
		name = self.current.name,
		endedAt = os.time(),
		reason = "Disconnected",
	})
	while #self.history > 50 do table.remove(self.history) end
	self.current = nil
	return true
end

function Sessions:Cleanup()
	self.destroyed = true
	self.current = nil
	table.clear(self.history)
	self.context = nil
end

return Sessions
]]></ProtectedString></Properties></Item>
    <Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">ClubMusicSpatialAudioGraph</string><ProtectedString name="Source"><![CDATA[--!strict
-- Optional spatial-audio graph builder. Caller must provide the venue emitter
-- and listener placement policy; no spatial graph is created automatically.
local Spatial = {}
Spatial.__index = Spatial

local function validWorldParent(instance: any): boolean
	return typeof(instance) == "Instance"
		and (instance:IsA("BasePart") or instance:IsA("Attachment") or instance:IsA("Camera"))
end

function Spatial.new(context)
	assert(typeof(context) == "table", "Spatial audio requires context.")
	assert(typeof(context.AudioPlayer) == "Instance" and context.AudioPlayer:IsA("AudioPlayer"),
		"Spatial audio requires a valid AudioPlayer.")
	assert(typeof(context.AudioDeviceOutput) == "Instance" and context.AudioDeviceOutput:IsA("AudioDeviceOutput"),
		"Spatial audio requires a valid AudioDeviceOutput.")
	return setmetatable({ context = context, graphs = {}, enabled = false, destroyed = false }, Spatial)
end

function Spatial:CreateRoute(key: string, emitterParent: Instance, listenerParent: Instance)
	if self.destroyed then return false, "Spatial audio service is unavailable." end
	if typeof(key) ~= "string" or #key < 1 or #key > 48 or not string.match(key, "^[%w_%-]+$") then
		return false, "Invalid spatial route key."
	end
	if self.graphs[key] then return false, "Spatial route already exists." end
	if not validWorldParent(emitterParent) or not validWorldParent(listenerParent) then
		return false, "Emitter and listener must be parented to a BasePart, Attachment, or Camera."
	end
	local context = self.context
	if not context or not context.AudioPlayer or not context.AudioDeviceOutput
		or context.AudioPlayer.Parent == nil or context.AudioDeviceOutput.Parent == nil then
		return false, "Spatial audio endpoints are unavailable."
	end

	local folder = Instance.new("Folder")
	folder.Name = "ClubMusicSpatial_" .. key
	local emitter, listener
	local ok, err = pcall(function()
		emitter = Instance.new("AudioEmitter")
		emitter.Name = "MusicEmitter"
		emitter.Parent = emitterParent
		listener = Instance.new("AudioListener")
		listener.Name = "MusicListener"
		listener.Parent = listenerParent
		local sourceWire = Instance.new("Wire")
		sourceWire.SourceInstance = context.AudioPlayer
		sourceWire.TargetInstance = emitter
		sourceWire.Parent = folder
		local listenerWire = Instance.new("Wire")
		listenerWire.SourceInstance = emitter
		listenerWire.TargetInstance = listener
		listenerWire.Parent = folder
		local outputWire = Instance.new("Wire")
		outputWire.SourceInstance = listener
		outputWire.TargetInstance = context.AudioDeviceOutput
		outputWire.Parent = folder
		folder.Parent = context.Parent or workspace
	end)
	if not ok then
		pcall(function() folder:Destroy() end)
		if emitter then pcall(function() emitter:Destroy() end) end
		if listener then pcall(function() listener:Destroy() end) end
		return false, "Spatial route creation failed: " .. tostring(err)
	end
	self.graphs[key] = { folder = folder, emitter = emitter, listener = listener }
	return true, key
end

function Spatial:RemoveRoute(key: string)
	local graph = self.graphs[key]
	if not graph then return false end
	self.graphs[key] = nil
	pcall(function() graph.folder:Destroy() end)
	pcall(function() graph.emitter:Destroy() end)
	pcall(function() graph.listener:Destroy() end)
	return true
end

function Spatial:SetEnabled(value: boolean)
	if self.destroyed or typeof(value) ~= "boolean" then return false end
	if typeof(self.context.OnEnabledChanged) == "function" then
		local ok, result = pcall(self.context.OnEnabledChanged, value)
		if not ok or result == false then return false end
	end
	self.enabled = value
	return true
end

function Spatial:Cleanup()
	if self.destroyed then return end
	local keys = {}
	for key in pairs(self.graphs) do table.insert(keys, key) end
	for _, key in ipairs(keys) do self:RemoveRoute(key) end
	self.destroyed = true
	self.context = nil
end

return Spatial
]]></ProtectedString></Properties></Item>
  </Item>
</roblox>
