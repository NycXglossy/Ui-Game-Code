<?xml version="1.0" encoding="utf-8"?>
<roblox version="4">
  <Item class="Folder" referent="RBX0">
    <Properties><string name="Name">ClubMusic_Global_Optional_Services</string></Properties>
    <Item class="ModuleScript" referent="RBX1">
      <Properties>
        <string name="Name">ClubMusic_Global_Event_Log_Service</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- Bounded, expiring operational event log. Does not record chat or raw player data.
local Service = {}
Service.__index = Service

local DEFAULT_TTL_SECONDS = 24 * 60 * 60
local MAX_DETAIL_LENGTH = 180
local MAX_KIND_LENGTH = 48
local MAX_QUERY_LIMIT = 100

local function isFiniteNumber(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function isEnabled(self)
	local ok, enabled = pcall(self.d.isEnabled)
	return ok and enabled == true
end

function Service.new(dependencies)
	assert(type(dependencies) == "table", "EventLog dependencies must be a table")
	assert(dependencies.memoryStoreService ~= nil, "EventLog requires memoryStoreService")
	assert(type(dependencies.isEnabled) == "function", "EventLog requires isEnabled")
	local self = setmetatable({
		d = dependencies,
		count = 0,
		lastError = nil,
	}, Service)
	local ok, mapOrError = pcall(function()
		return dependencies.memoryStoreService:GetSortedMap(dependencies.mapName or "ClubMusic_EventLog_v1")
	end)
	if not ok then
		self.lastError = tostring(mapOrError)
		self.map = nil
	else
		self.map = mapOrError
	end
	return self
end

function Service:Record(kind, detail, severity)
	if not isEnabled(self) or not self.map then return false end
	if type(kind) ~= "string" or #kind < 1 or #kind > MAX_KIND_LENGTH then return false end
	local safeDetail = if type(detail) == "string" then string.sub(detail, 1, MAX_DETAIL_LENGTH)
		else string.sub(tostring(detail or ""), 1, MAX_DETAIL_LENGTH)
	local safeSeverity = if type(severity) == "string" and #severity <= 16 then severity else "Info"
	local jobId = tostring(self.d.jobId or "unknown")
	local guidOk, guid = pcall(self.d.guid)
	if not guidOk then
		self.lastError = tostring(guid)
		return false
	end
	local id = tostring(os.time()) .. ":" .. jobId .. ":" .. tostring(guid)
	local value = {
		kind = kind,
		detail = safeDetail,
		severity = safeSeverity,
		jobId = jobId,
		at = os.time(),
	}
	local ttl = self.d.ttlSeconds
	if not isFiniteNumber(ttl) or ttl < 60 then ttl = DEFAULT_TTL_SECONDS end
	local ok, err = pcall(function()
		self.map:SetAsync(id, value, math.floor(ttl), os.time())
	end)
	if ok then
		self.count += 1
		self.lastError = nil
	else
		self.lastError = tostring(err)
	end
	return ok
end

function Service:GetRecent(limit)
	if not isEnabled(self) or not self.map then return false, {} end
	local requested = tonumber(limit)
	if not isFiniteNumber(requested) then requested = 25 end
	local count = math.clamp(math.floor(requested), 1, MAX_QUERY_LIMIT)
	local ok, result = pcall(function()
		return self.map:GetRangeAsync(Enum.SortDirection.Descending, count)
	end)
	if not ok then
		self.lastError = tostring(result)
		return false, {}
	end
	local out = {}
	if type(result) == "table" then
		for _, entry in ipairs(result) do
			if type(entry) == "table" and typeof(entry.value) == "table" then
				table.insert(out, table.clone(entry.value))
			end
		end
	end
	self.lastError = nil
	return true, out
end

function Service:GetStatus()
	return {
		state = if isEnabled(self) and self.map then "Healthy" else if not self.map then "Degraded" else "Disabled",
		written = self.count,
		lastError = self.lastError,
		available = self.map ~= nil,
	}
end

function Service:Start()
	return self.map ~= nil
end

function Service:Stop()
	-- MemoryStore owns the backing map; no local resources need closing.
end

return Service
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX2">
      <Properties>
        <string name="Name">ClubMusic_Global_RateLimit_Service</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- Facade over the existing shared token buckets; intentionally creates no second limiter.
local Service = {}
Service.__index = Service

local function isFiniteNumber(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function Service.new(dependencies)
	assert(type(dependencies) == "table", "RateLimit dependencies must be a table")
	assert(type(dependencies.isEnabled) == "function", "RateLimit requires isEnabled")
	assert(type(dependencies.consumeShared) == "function", "RateLimit requires consumeShared")
	return setmetatable({
		d = dependencies,
		checks = 0,
		rejected = 0,
		sharedFailures = 0,
		lastError = nil,
	}, Service)
end

function Service:Consume(key, capacity, refill, cost)
	local enabledOk, enabled = pcall(self.d.isEnabled)
	if not enabledOk then
		self.lastError = tostring(enabled)
		return false, false
	end
	-- Cross-server limits are deliberately bypassed while global service is disabled
	-- (for example, ordinary isolated Studio sessions).
	if enabled ~= true then return true, true end
	if type(key) ~= "string" or #key < 1 or #key > 100
		or not isFiniteNumber(capacity) or capacity <= 0
		or not isFiniteNumber(refill) or refill < 0
		or not isFiniteNumber(cost) or cost <= 0 or cost > capacity then
		self.rejected += 1
		return false, false
	end
	self.checks += 1
	local callOk, allowed, shared = pcall(self.d.consumeShared, key, capacity, refill, cost)
	if not callOk then
		self.sharedFailures += 1
		self.rejected += 1
		self.lastError = tostring(allowed)
		return false, false
	end
	if allowed ~= true then self.rejected += 1 end
	if shared ~= true then self.sharedFailures += 1 end
	self.lastError = nil
	return allowed == true, shared == true
end

function Service:GetStatus()
	local enabledOk, enabled = pcall(self.d.isEnabled)
	local state = if not enabledOk then "Degraded" else if enabled ~= true then "Disabled" else "Healthy"
	return {
		state = state,
		checks = self.checks,
		rejected = self.rejected,
		sharedFailures = self.sharedFailures,
		usesExistingBuckets = true,
		lastError = self.lastError,
	}
end

function Service:Start()
	return true
end

function Service:Stop()
end

return Service
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX3">
      <Properties>
        <string name="Name">MusicGlobalPlaybackAuthority</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- Playback-only cross-server authority. Queue data is deliberately not represented here.
local Workspace = game:GetService("Workspace")

local PlaybackAuthority = {}
PlaybackAuthority.__index = PlaybackAuthority

local LEASE_KEY = "playbackLeader_v1"
local SNAPSHOT_KEY = "playbackSnapshot_v1"
local LEASE_TTL = 24
local MAX_TRACK_TEXT = 120
local MAX_DURATION = 24 * 60 * 60

local function finite(value: any): boolean
	return typeof(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function cleanText(value: any, maxLength: number): string?
	if typeof(value) ~= "string" or #value < 1 or #value > maxLength or string.find(value, "[%c]") then return nil end
	return value
end

local function sanitizeTrack(raw: any): {[string]: any}?
	if raw == nil then return nil end
	if typeof(raw) ~= "table" then return nil end
	local trackId = cleanText(raw.trackId, 32)
	local title = cleanText(raw.title, MAX_TRACK_TEXT)
	local artist = cleanText(raw.artist, MAX_TRACK_TEXT)
	local soundId = raw.soundId
	if not trackId or not title or not artist or typeof(soundId) ~= "string"
		or #soundId > 64 or not string.match(soundId, "^rbxassetid://%d+$")
		or not finite(raw.duration) or raw.duration < 1 or raw.duration > MAX_DURATION then
		return nil
	end
	return {
		trackId = trackId,
		title = title,
		artist = artist,
		soundId = soundId,
		duration = math.floor(raw.duration),
	}
end

local function sanitizeSnapshot(raw: any): {[string]: any}
	local state = {
		schemaVersion = 1,
		revision = 0,
		trackRevision = 0,
		current = nil,
		paused = false,
		position = 0,
		anchorTime = Workspace:GetServerTimeNow(),
		leaderJobId = "",
		leaderToken = "",
		leaderGeneration = 0,
		updatedAt = os.time(),
	}
	if typeof(raw) ~= "table" or raw.schemaVersion ~= 1 then return state end
	state.revision = if finite(raw.revision) then math.max(0, math.floor(raw.revision)) else 0
	state.trackRevision = if finite(raw.trackRevision) then math.max(0, math.floor(raw.trackRevision)) else 0
	state.current = sanitizeTrack(raw.current)
	state.paused = raw.paused == true
	state.position = if finite(raw.position) then math.clamp(raw.position, 0, MAX_DURATION) else 0
	state.anchorTime = if finite(raw.anchorTime) then raw.anchorTime else Workspace:GetServerTimeNow()
	state.leaderJobId = if typeof(raw.leaderJobId) == "string" then string.sub(raw.leaderJobId, 1, 128) else ""
	state.leaderToken = if typeof(raw.leaderToken) == "string" then string.sub(raw.leaderToken, 1, 64) else ""
	state.leaderGeneration = if finite(raw.leaderGeneration) then math.max(0, math.floor(raw.leaderGeneration)) else 0
	state.updatedAt = if finite(raw.updatedAt) then math.max(0, math.floor(raw.updatedAt)) else os.time()
	return state
end

function PlaybackAuthority.new(dependencies: {[string]: any})
	assert(typeof(dependencies) == "table", "PlaybackAuthority dependencies are required")
	return setmetatable({
		safeCall = dependencies.safeCall,
		dataStoreService = dependencies.dataStoreService,
		memoryStoreService = dependencies.memoryStoreService,
		jobId = tostring(dependencies.jobId or ""),
		guid = dependencies.guid,
		publish = dependencies.publish,
		store = nil,
		leaseMap = nil,
		leaseToken = nil,
		leaseExpiresAt = 0,
		leaderGeneration = nil,
		leadershipReady = false,
		lastError = nil,
		started = false,
	}, PlaybackAuthority)
end

function PlaybackAuthority:_safeCall(operation: string, callback: (...any) -> ...any, ...: any): ...any
	if self.safeCall and type(self.safeCall.Run) == "function" then
		return self.safeCall:Run("PlaybackAuthority", operation, callback, ...)
	end
	return pcall(callback, ...)
end

function PlaybackAuthority:Start(): (boolean, string?)
	if self.started then return true, nil end
	local ok, result = self:_safeCall("DataStoreAndMemoryStore.Initialize", function()
		self.store = self.dataStoreService:GetDataStore("ClubMusic_GlobalPlaybackOnly_v1")
		self.leaseMap = self.memoryStoreService:GetHashMap("ClubMusic_GlobalPlaybackLeader_v1")
	end)
	if not ok then return false, tostring(result) end
	self.started = true
	return true, nil
end

function PlaybackAuthority:GetLeader(): (boolean, {[string]: any}?, string?)
	if not self.started or not self.leaseMap then return false, nil, "Playback authority is not started." end
	local ok, value = self:_safeCall("MemoryStore.GetLeaderLease", function() return self.leaseMap:GetAsync(LEASE_KEY) end)
	if not ok then return false, nil, tostring(value) end
	if typeof(value) ~= "table" or not finite(value.expiresAt) or value.expiresAt <= os.time()
		or typeof(value.jobId) ~= "string" or typeof(value.token) ~= "string" then
		return true, nil, nil
	end
	return true, {jobId = value.jobId, token = value.token, expiresAt = value.expiresAt}, nil
end

function PlaybackAuthority:AcquireOrRenewLeadership(): (boolean, {[string]: any}?, string?)
	if not self.started or not self.leaseMap then return false, nil, "Playback authority is not started." end
	local now = os.time()
	local proposedToken = self.leaseToken or self.guid()
	local alreadyFencedLeader = self.leadershipReady == true and self.leaseToken == proposedToken and self.leaderGeneration ~= nil
	local ok, value = self:_safeCall("MemoryStore.AcquireOrRenewLease", function()
		return self.leaseMap:UpdateAsync(LEASE_KEY, function(old)
			if typeof(old) == "table" and finite(old.expiresAt) and old.expiresAt > now then
				if old.jobId == self.jobId and old.token == self.leaseToken then
					return {jobId = self.jobId, token = self.leaseToken, expiresAt = now + LEASE_TTL}
				end
				return old
			end
			return {jobId = self.jobId, token = proposedToken, expiresAt = now + LEASE_TTL}
		end, LEASE_TTL)
	end)
	if not ok then return false, nil, tostring(value) end
	if typeof(value) ~= "table" or value.jobId ~= self.jobId or value.token ~= proposedToken then
		self.leaseToken = nil
		self.leaseExpiresAt = 0
		return false, if typeof(value) == "table" then value else nil, "Another server currently owns global playback."
	end
	self.leaseToken = proposedToken
	self.leaseExpiresAt = value.expiresAt
	self.leadershipReady = alreadyFencedLeader

	-- Claim a monotonically increasing generation in the same durable record
	-- that playback commits update. Once this claim wins, older generations
	-- can no longer commit, even if an old server wakes after a long stall.
	local claimed: any = nil
	if alreadyFencedLeader then
		local snapshotOk, snapshot, snapshotError = self:GetSnapshot()
		if not snapshotOk or not snapshot or snapshot.leaderToken ~= proposedToken or snapshot.leaderJobId ~= self.jobId
			or snapshot.leaderGeneration ~= self.leaderGeneration then
			self.leadershipReady = false
			self.lastError = tostring(snapshotError or "Durable leadership fence no longer matches this lease.")
			return false, nil, self.lastError
		end
		claimed = snapshot
	else
		local claimOk, claimResult = self:_safeCall("DataStore.ClaimLeaderFence", function()
			return self.store:UpdateAsync(SNAPSHOT_KEY, function(old)
				local state = sanitizeSnapshot(old)
				state.leaderGeneration += 1
				state.leaderJobId = self.jobId
				state.leaderToken = proposedToken
				state.revision += 1
				state.updatedAt = os.time()
				return state
			end)
		end)
		if not claimOk or typeof(claimResult) ~= "table" then
			self.lastError = tostring(claimResult)
			return false, nil, "Could not claim playback fencing generation: " .. tostring(claimResult)
		end
		claimed = claimResult
	end
	local currentOk, currentLease = self:GetLeader()
	if not currentOk or not currentLease or currentLease.jobId ~= self.jobId or currentLease.token ~= proposedToken then
		self.leaseToken = nil
		self.leaseExpiresAt = 0
		self.leaderGeneration = nil
		return false, currentLease, "Leadership lease changed during fencing claim."
	end
	self.leaderGeneration = math.floor(claimed.leaderGeneration or 0)
	self.leadershipReady = self.leaderGeneration > 0
	self.lastError = nil
	return self.leadershipReady, {jobId = self.jobId, token = proposedToken, generation = self.leaderGeneration, expiresAt = value.expiresAt}, if self.leadershipReady then nil else "Fencing generation was not established."
end

function PlaybackAuthority:ReleaseLeadership(): boolean
	local token = self.leaseToken
	if not token or not self.leaseMap then return true end
	local ok = self:_safeCall("MemoryStore.ReleaseLeadership", function()
		self.leaseMap:UpdateAsync(LEASE_KEY, function(old)
			if typeof(old) == "table" and old.jobId == self.jobId and old.token == token then return nil end
			return old
		end, LEASE_TTL)
	end)
	if ok then self.leaseToken = nil; self.leaseExpiresAt = 0; self.leaderGeneration = nil; self.leadershipReady = false end
	return ok
end

function PlaybackAuthority:GetSnapshot(): (boolean, {[string]: any}?, string?)
	if not self.started or not self.store then return false, nil, "Playback authority is not started." end
	local ok, raw = self:_safeCall("DataStore.GetPlaybackSnapshot", function() return self.store:GetAsync(SNAPSHOT_KEY) end)
	if not ok then return false, nil, tostring(raw) end
	return true, sanitizeSnapshot(raw), nil
end

function PlaybackAuthority:CommitPlayback(raw: any, expectedRevision: any): (boolean, {[string]: any}?, string?)
	if not self.leaseToken or not self.leadershipReady or not self.leaderGeneration then return false, nil, "This server has no active fenced playback leadership." end
	if not finite(expectedRevision) or expectedRevision < 0 then return false, nil, "Invalid playback revision." end
	if typeof(raw) ~= "table" then return false, nil, "Invalid playback snapshot." end
	local track = sanitizeTrack(raw.current)
	if raw.current ~= nil and not track then return false, nil, "Invalid current track metadata." end
	if typeof(raw.paused) ~= "boolean" or not finite(raw.position) or raw.position < 0 or raw.position > MAX_DURATION then
		return false, nil, "Invalid playback position or pause state."
	end
	local leaseOk, lease = self:GetLeader()
	if not leaseOk or not lease or lease.jobId ~= self.jobId or lease.token ~= self.leaseToken then
		self.leaseToken = nil
		self.leaseExpiresAt = 0
		return false, nil, "Playback leader lease expired or was replaced."
	end
	local token = self.leaseToken
	local accepted = false
	local ok, result = self:_safeCall("DataStore.CommitPlayback", function()
		return self.store:UpdateAsync(SNAPSHOT_KEY, function(old)
			accepted = false
			local state = sanitizeSnapshot(old)
			if state.revision ~= math.floor(expectedRevision) then return old end
			if state.leaderGeneration ~= self.leaderGeneration or state.leaderToken ~= token or state.leaderJobId ~= self.jobId then return old end
			-- The durable generation/token check fences every prior leader after takeover.
			state.revision += 1
			state.trackRevision = if finite(raw.trackRevision) then math.max(state.trackRevision, math.floor(raw.trackRevision)) else state.trackRevision
			state.current = track
			state.paused = raw.paused
			state.position = math.clamp(raw.position, 0, MAX_DURATION)
			state.anchorTime = if finite(raw.anchorTime) then raw.anchorTime else Workspace:GetServerTimeNow()
			state.leaderJobId = self.jobId
			state.leaderToken = token
			state.updatedAt = os.time()
			accepted = true
			return state
		end)
	end)
	if not ok then return false, nil, tostring(result) end
	local snapshot = sanitizeSnapshot(result)
	if not accepted then return false, snapshot, "Playback revision changed or this leader was fenced out." end
	if typeof(self.publish) == "function" then self:_safeCall("Messaging.PublishPlaybackChanged", self.publish, {kind = "PlaybackChanged", revision = snapshot.revision, trackRevision = snapshot.trackRevision}) end
	return true, snapshot, nil
end

function PlaybackAuthority:GetStatus(): {[string]: any}
	local leaderOk, leader, leaderError = self:GetLeader()
	return {
		enabled = self.started,
		isLeader = self.leadershipReady == true and self.leaseToken ~= nil and leaderOk and leader ~= nil and leader.jobId == self.jobId and leader.token == self.leaseToken,
		leadershipReady = self.leadershipReady == true,
		leaderGeneration = self.leaderGeneration,
		lastError = self.lastError,
		leaderJobId = if leader then leader.jobId else nil,
		leaseExpiresAt = if leader then leader.expiresAt else nil,
		error = leaderError,
	}
end

return PlaybackAuthority
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX4">
      <Properties>
        <string name="Name">ClubMusic_Global_Authorization_Service</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- Server-side authorization adapter. Denies by default without a trusted resolver.
local Service={}; Service.__index=Service
local ALLOWED={GlobalDJ=true,GlobalModeration=true,GlobalAnnouncement=true,GlobalConfig=true,SecurityPolicy=true,IncidentResponse=true}
function Service.new(d) assert(type(d)=="table","Authorization dependencies missing"); return setmetatable({d=d,checks=0,denied=0},Service) end
function Service:Check(actorUserId,permission)
 if type(actorUserId)~="number" or actorUserId<1 or actorUserId%1~=0 or not ALLOWED[permission] then self.denied+=1; return false,"Invalid actor or permission." end
 if type(self.d.resolvePermission)~="function" then self.denied+=1; return false,"No trusted permission resolver is configured." end
 local ok,allowed=pcall(self.d.resolvePermission,math.floor(actorUserId),permission)
 self.checks+=1
 if not ok or allowed~=true then self.denied+=1; return false,"Permission denied." end
 return true
end
function Service:GetStatus()
 local available=type(self.d.isResolverAvailable)=="function" and self.d.isResolverAvailable()==true
 return {state=if available then "Ready" else "Unconfigured",checks=self.checks,denied=self.denied,default="Deny"}
end
function Service:Start() return true end
function Service:Stop() end
return Service
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX5">
      <Properties>
        <string name="Name">ClubMusic_Global_SafeCall_Service</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- Centralized protected-call diagnostics for ClubMusic global services.
-- This module observes failures only; it never changes authorization or recovery policy.
local SafeCall = {}
SafeCall.__index = SafeCall

local MAX_RECORDS = 50
local MAX_TEXT = 240
local WARN_COOLDOWN = 30

local function clean(value: any): string
	local text = tostring(value or "")
	text = string.gsub(text, "[%c]", " ")
	return string.sub(text, 1, MAX_TEXT)
end

function SafeCall.new(dependencies: {[string]: any}?)
	local d = if typeof(dependencies) == "table" then dependencies else {}
	return setmetatable({
		serviceName = clean(d.serviceName or "ClubMusicGlobal"),
		records = {},
		counts = {calls = 0, failures = 0, recovered = 0},
		lastSuccess = nil,
		lastFailure = nil,
		lastWarnings = {},
	}, SafeCall)
end

function SafeCall:Run(serviceName: string, operation: string, callback: (...any) -> ...any, ...: any): ...any
	self.counts.calls += 1
	local packed = table.pack(pcall(callback, ...))
	local ok = packed[1] == true
	local now = os.time()
	local service = clean(serviceName ~= "" and serviceName or self.serviceName)
	local op = clean(operation)
	if ok then
		self.lastSuccess = {service = service, operation = op, at = now}
		return table.unpack(packed, 1, packed.n)
	end

	local err = clean(packed[2])
	local trace = err
	if debug and type(debug.traceback) == "function" then
		local traceOk, traceResult = pcall(debug.traceback, err, 2)
		if traceOk then trace = clean(traceResult) end
	end
	self.counts.failures += 1
	self.lastFailure = {service = service, operation = op, error = err, traceback = trace, at = now}
	local record = table.clone(self.lastFailure)
	table.insert(self.records, 1, record)
	while #self.records > MAX_RECORDS do table.remove(self.records) end

	local signature = service .. "|" .. op .. "|" .. err
	local lastWarn = self.lastWarnings[signature] or 0
	if now - lastWarn >= WARN_COOLDOWN then
		self.lastWarnings[signature] = now
		warn("[ClubMusic][SafeCall] Operation failed; service=" .. service
			.. "; operation=" .. op .. "; error=" .. err)
	end
	return false, err, trace
end

function SafeCall:RecordFailure(serviceName: string, operation: string, detail: any)
	local now = os.time()
	local service = clean(serviceName)
	local op = clean(operation)
	local err = clean(detail)
	self.counts.failures += 1
	self.lastFailure = {service = service, operation = op, error = err, traceback = err, at = now}
	table.insert(self.records, 1, table.clone(self.lastFailure))
	while #self.records > MAX_RECORDS do table.remove(self.records) end
	local signature = service .. "|" .. op .. "|" .. err
	local lastWarn = self.lastWarnings[signature] or 0
	if now - lastWarn >= WARN_COOLDOWN then
		self.lastWarnings[signature] = now
		warn("[ClubMusic][SafeCall] Operation reported failure; service=" .. service
			.. "; operation=" .. op .. "; detail=" .. err)
	end
end

function SafeCall:RecordRecovery(serviceName: string, operation: string)
	self.counts.recovered += 1
	local record = {service = clean(serviceName), operation = clean(operation), at = os.time()}
	self.lastSuccess = record
	print("[ClubMusic][SafeCall] Operation recovered; service=" .. record.service .. "; operation=" .. record.operation)
end

function SafeCall:GetRecent(limit: number?): {any}
	local count = math.clamp(math.floor(tonumber(limit) or 20), 1, MAX_RECORDS)
	local out = {}
	for index = 1, math.min(count, #self.records) do
		out[index] = table.clone(self.records[index])
	end
	return out
end

function SafeCall:GetStatus(): {[string]: any}
	return {
		service = self.serviceName,
		calls = self.counts.calls,
		failures = self.counts.failures,
		recovered = self.counts.recovered,
		lastSuccess = if self.lastSuccess then table.clone(self.lastSuccess) else nil,
		lastFailure = if self.lastFailure then table.clone(self.lastFailure) else nil,
		recentFailureCount = #self.records,
	}
end

return SafeCall
