<?xml version="1.0" encoding="utf-8"?>
<roblox version="4">
  <Item class="Folder" referent="RBX0">
    <Properties><string name="Name">ClubMusic_Global_Optional_Services</string></Properties>
    <Item class="ModuleScript" referent="RBX1">
      <Properties>
        <string name="Name">ClubMusic_Global_Event_Log_Service</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- Bounded, expiring operational event log. Does not record chat or raw player data.
local Service = {}
Service.__index = Service

local DEFAULT_TTL_SECONDS = 24 * 60 * 60
local MAX_DETAIL_LENGTH = 180
local MAX_KIND_LENGTH = 48
local MAX_QUERY_LIMIT = 100

local function isFiniteNumber(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function isEnabled(self)
	local ok, enabled = pcall(self.d.isEnabled)
	return ok and enabled == true
end

function Service.new(dependencies)
	assert(type(dependencies) == "table", "EventLog dependencies must be a table")
	assert(dependencies.memoryStoreService ~= nil, "EventLog requires memoryStoreService")
	assert(type(dependencies.isEnabled) == "function", "EventLog requires isEnabled")
	local self = setmetatable({
		d = dependencies,
		count = 0,
		lastError = nil,
	}, Service)
	local ok, mapOrError = pcall(function()
		return dependencies.memoryStoreService:GetSortedMap(dependencies.mapName or "ClubMusic_EventLog_v1")
	end)
	if not ok then
		self.lastError = tostring(mapOrError)
		self.map = nil
	else
		self.map = mapOrError
	end
	return self
end

function Service:Record(kind, detail, severity)
	if not isEnabled(self) or not self.map then return false end
	if type(kind) ~= "string" or #kind < 1 or #kind > MAX_KIND_LENGTH then return false end
	local safeDetail = if type(detail) == "string" then string.sub(detail, 1, MAX_DETAIL_LENGTH)
		else string.sub(tostring(detail or ""), 1, MAX_DETAIL_LENGTH)
	local safeSeverity = if type(severity) == "string" and #severity <= 16 then severity else "Info"
	local jobId = tostring(self.d.jobId or "unknown")
	local guidOk, guid = pcall(self.d.guid)
	if not guidOk then
		self.lastError = tostring(guid)
		return false
	end
	local id = tostring(os.time()) .. ":" .. jobId .. ":" .. tostring(guid)
	local value = {
		kind = kind,
		detail = safeDetail,
		severity = safeSeverity,
		jobId = jobId,
		at = os.time(),
	}
	local ttl = self.d.ttlSeconds
	if not isFiniteNumber(ttl) or ttl < 60 then ttl = DEFAULT_TTL_SECONDS end
	local ok, err = pcall(function()
		self.map:SetAsync(id, value, math.floor(ttl), os.time())
	end)
	if ok then
		self.count += 1
		self.lastError = nil
	else
		self.lastError = tostring(err)
	end
	return ok
end

function Service:GetRecent(limit)
	if not isEnabled(self) or not self.map then return false, {} end
	local requested = tonumber(limit)
	if not isFiniteNumber(requested) then requested = 25 end
	local count = math.clamp(math.floor(requested), 1, MAX_QUERY_LIMIT)
	local ok, result = pcall(function()
		return self.map:GetRangeAsync(Enum.SortDirection.Descending, count)
	end)
	if not ok then
		self.lastError = tostring(result)
		return false, {}
	end
	local out = {}
	if type(result) == "table" then
		for _, entry in ipairs(result) do
			if type(entry) == "table" and typeof(entry.value) == "table" then
				table.insert(out, table.clone(entry.value))
			end
		end
	end
	self.lastError = nil
	return true, out
end

function Service:GetStatus()
	return {
		state = if isEnabled(self) and self.map then "Healthy" else if not self.map then "Degraded" else "Disabled",
		written = self.count,
		lastError = self.lastError,
		available = self.map ~= nil,
	}
end

function Service:Start()
	return self.map ~= nil
end

function Service:Stop()
	-- MemoryStore owns the backing map; no local resources need closing.
end

return Service
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX2">
      <Properties>
        <string name="Name">ClubMusic_Global_RateLimit_Service</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- Facade over the existing shared token buckets; intentionally creates no second limiter.
local Service = {}
Service.__index = Service

local function isFiniteNumber(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function Service.new(dependencies)
	assert(type(dependencies) == "table", "RateLimit dependencies must be a table")
	assert(type(dependencies.isEnabled) == "function", "RateLimit requires isEnabled")
	assert(type(dependencies.consumeShared) == "function", "RateLimit requires consumeShared")
	return setmetatable({
		d = dependencies,
		checks = 0,
		rejected = 0,
		sharedFailures = 0,
		lastError = nil,
	}, Service)
end

function Service:Consume(key, capacity, refill, cost)
	local enabledOk, enabled = pcall(self.d.isEnabled)
	if not enabledOk then
		self.lastError = tostring(enabled)
		return false, false
	end
	-- Cross-server limits are deliberately bypassed while global service is disabled
	-- (for example, ordinary isolated Studio sessions).
	if enabled ~= true then return true, true end
	if type(key) ~= "string" or #key < 1 or #key > 100
		or not isFiniteNumber(capacity) or capacity <= 0
		or not isFiniteNumber(refill) or refill < 0
		or not isFiniteNumber(cost) or cost <= 0 or cost > capacity then
		self.rejected += 1
		return false, false
	end
	self.checks += 1
	local callOk, allowed, shared = pcall(self.d.consumeShared, key, capacity, refill, cost)
	if not callOk then
		self.sharedFailures += 1
		self.rejected += 1
		self.lastError = tostring(allowed)
		return false, false
	end
	if allowed ~= true then self.rejected += 1 end
	if shared ~= true then self.sharedFailures += 1 end
	self.lastError = nil
	return allowed == true, shared == true
end

function Service:GetStatus()
	local enabledOk, enabled = pcall(self.d.isEnabled)
	local state = if not enabledOk then "Degraded" else if enabled ~= true then "Disabled" else "Healthy"
	return {
		state = state,
		checks = self.checks,
		rejected = self.rejected,
		sharedFailures = self.sharedFailures,
		usesExistingBuckets = true,
		lastError = self.lastError,
	}
end

function Service:Start()
	return true
end

function Service:Stop()
end

return Service
]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
</roblox>
