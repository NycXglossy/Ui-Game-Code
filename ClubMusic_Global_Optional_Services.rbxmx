<?xml version="1.0" encoding="utf-8"?>
<roblox version="4">
  <Item class="Folder" referent="RBX0">
    <Properties><string name="Name">ClubMusic_Global_Optional_Services</string></Properties>
    <Item class="ModuleScript" referent="RBX1">
      <Properties>
        <string name="Name">ClubMusic_Global_Event_Log_Service</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- Bounded, expiring operational event log. Does not record chat or raw player data.
local Service = {}
Service.__index = Service

local DEFAULT_TTL_SECONDS = 24 * 60 * 60
local MAX_DETAIL_LENGTH = 180
local MAX_KIND_LENGTH = 48
local MAX_QUERY_LIMIT = 100

local function isFiniteNumber(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function isEnabled(self)
	local ok, enabled = pcall(self.d.isEnabled)
	return ok and enabled == true
end

function Service.new(dependencies)
	assert(type(dependencies) == "table", "EventLog dependencies must be a table")
	assert(dependencies.memoryStoreService ~= nil, "EventLog requires memoryStoreService")
	assert(type(dependencies.isEnabled) == "function", "EventLog requires isEnabled")
	local self = setmetatable({
		d = dependencies,
		count = 0,
		lastError = nil,
	}, Service)
	local ok, mapOrError = pcall(function()
		return dependencies.memoryStoreService:GetSortedMap(dependencies.mapName or "ClubMusic_EventLog_v1")
	end)
	if not ok then
		self.lastError = tostring(mapOrError)
		self.map = nil
	else
		self.map = mapOrError
	end
	return self
end

function Service:Record(kind, detail, severity)
	if not isEnabled(self) or not self.map then return false end
	if type(kind) ~= "string" or #kind < 1 or #kind > MAX_KIND_LENGTH then return false end
	local safeDetail = if type(detail) == "string" then string.sub(detail, 1, MAX_DETAIL_LENGTH)
		else string.sub(tostring(detail or ""), 1, MAX_DETAIL_LENGTH)
	local safeSeverity = if type(severity) == "string" and #severity <= 16 then severity else "Info"
	local jobId = tostring(self.d.jobId or "unknown")
	local guidOk, guid = pcall(self.d.guid)
	if not guidOk then
		self.lastError = tostring(guid)
		return false
	end
	local id = tostring(os.time()) .. ":" .. jobId .. ":" .. tostring(guid)
	local value = {
		kind = kind,
		detail = safeDetail,
		severity = safeSeverity,
		jobId = jobId,
		at = os.time(),
	}
	local ttl = self.d.ttlSeconds
	if not isFiniteNumber(ttl) or ttl < 60 then ttl = DEFAULT_TTL_SECONDS end
	local ok, err = pcall(function()
		self.map:SetAsync(id, value, math.floor(ttl), os.time())
	end)
	if ok then
		self.count += 1
		self.lastError = nil
	else
		self.lastError = tostring(err)
	end
	return ok
end

function Service:GetRecent(limit)
	if not isEnabled(self) or not self.map then return false, {} end
	local requested = tonumber(limit)
	if not isFiniteNumber(requested) then requested = 25 end
	local count = math.clamp(math.floor(requested), 1, MAX_QUERY_LIMIT)
	local ok, result = pcall(function()
		return self.map:GetRangeAsync(Enum.SortDirection.Descending, count)
	end)
	if not ok then
		self.lastError = tostring(result)
		return false, {}
	end
	local out = {}
	if type(result) == "table" then
		for _, entry in ipairs(result) do
			if type(entry) == "table" and typeof(entry.value) == "table" then
				table.insert(out, table.clone(entry.value))
			end
		end
	end
	self.lastError = nil
	return true, out
end

function Service:GetStatus()
	return {
		state = if isEnabled(self) and self.map then "Healthy" else if not self.map then "Degraded" else "Disabled",
		written = self.count,
		lastError = self.lastError,
		available = self.map ~= nil,
	}
end

function Service:Start()
	return self.map ~= nil
end

function Service:Stop()
	-- MemoryStore owns the backing map; no local resources need closing.
end

return Service
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX2">
      <Properties>
        <string name="Name">ClubMusic_Global_RateLimit_Service</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- Facade over the existing shared token buckets; intentionally creates no second limiter.
local Service = {}
Service.__index = Service

local function isFiniteNumber(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function Service.new(dependencies)
	assert(type(dependencies) == "table", "RateLimit dependencies must be a table")
	assert(type(dependencies.isEnabled) == "function", "RateLimit requires isEnabled")
	assert(type(dependencies.consumeShared) == "function", "RateLimit requires consumeShared")
	return setmetatable({
		d = dependencies,
		checks = 0,
		rejected = 0,
		sharedFailures = 0,
		lastError = nil,
	}, Service)
end

function Service:Consume(key, capacity, refill, cost)
	local enabledOk, enabled = pcall(self.d.isEnabled)
	if not enabledOk then
		self.lastError = tostring(enabled)
		return false, false
	end
	-- Cross-server limits are deliberately bypassed while global service is disabled
	-- (for example, ordinary isolated Studio sessions).
	if enabled ~= true then return true, true end
	if type(key) ~= "string" or #key < 1 or #key > 100
		or not isFiniteNumber(capacity) or capacity <= 0
		or not isFiniteNumber(refill) or refill < 0
		or not isFiniteNumber(cost) or cost <= 0 or cost > capacity then
		self.rejected += 1
		return false, false
	end
	self.checks += 1
	local callOk, allowed, shared = pcall(self.d.consumeShared, key, capacity, refill, cost)
	if not callOk then
		self.sharedFailures += 1
		self.rejected += 1
		self.lastError = tostring(allowed)
		return false, false
	end
	if allowed ~= true then self.rejected += 1 end
	if shared ~= true then self.sharedFailures += 1 end
	self.lastError = nil
	return allowed == true, shared == true
end

function Service:GetStatus()
	local enabledOk, enabled = pcall(self.d.isEnabled)
	local state = if not enabledOk then "Degraded" else if enabled ~= true then "Disabled" else "Healthy"
	return {
		state = state,
		checks = self.checks,
		rejected = self.rejected,
		sharedFailures = self.sharedFailures,
		usesExistingBuckets = true,
		lastError = self.lastError,
	}
end

function Service:Start()
	return true
end

function Service:Stop()
end

return Service
]]></ProtectedString>
      </Properties>
    </Item>
    
    <Item class="ModuleScript" referent="RBX4">
      <Properties>
        <string name="Name">ClubMusic_Global_Authorization_Service</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- Local authorization adapter for ClubMusic global controls.
-- This service is intentionally independent of cross-server enablement and Studio isolation.
-- It always denies by default unless the controller supplies a trusted permission resolver.

local Service = {}
Service.__index = Service

local ALLOWED_PERMISSIONS = {
	GlobalDJ = true,
	GlobalModeration = true,
	GlobalAnnouncement = true,
	GlobalConfig = true,
	SecurityPolicy = true,
	IncidentResponse = true,
}

local function validActor(actorUserId: any): boolean
	return typeof(actorUserId) == "number"
		and actorUserId == actorUserId
		and actorUserId > 0
		and actorUserId < math.huge
		and actorUserId % 1 == 0
end

function Service.new(dependencies: {[string]: any})
	assert(typeof(dependencies) == "table", "Authorization dependencies missing")
	assert(type(dependencies.resolvePermission) == "function", "Trusted permission resolver is required")

	return setmetatable({
		dependencies = dependencies,
		checks = 0,
		denied = 0,
		lastError = nil,
		started = false,
	}, Service)
end

function Service:Start(): boolean
	-- Do not require DataStore, MemoryStore, MessagingService, or global enablement.
	self.started = true
	return true
end

function Service:Check(actorUserId: any, permission: any): (boolean, string?)
	if not validActor(actorUserId) or typeof(permission) ~= "string"
		or not ALLOWED_PERMISSIONS[permission] then
		self.denied += 1
		return false, "Invalid actor or permission."
	end

	local resolver = self.dependencies.resolvePermission
	if type(resolver) ~= "function" then
		self.denied += 1
		self.lastError = "Trusted permission resolver is unavailable."
		return false, self.lastError
	end

	local ok, allowed = pcall(resolver, math.floor(actorUserId), permission)
	self.checks += 1
	if not ok then
		self.denied += 1
		self.lastError = string.sub(tostring(allowed), 1, 180)
		warn("[ClubMusic][Authorization] Trusted resolver failed; permission=" .. permission
			.. "; error=" .. self.lastError)
		return false, "Authorization resolver failed."
	end
	if allowed ~= true then
		self.denied += 1
		return false, "Permission denied."
	end

	self.lastError = nil
	return true
end

function Service:GetStatus(): {[string]: any}
	local available = false
	local availabilityError = nil
	if type(self.dependencies.isResolverAvailable) == "function" then
		local ok, result = pcall(self.dependencies.isResolverAvailable)
		available = ok and result == true
		if not ok then availabilityError = string.sub(tostring(result), 1, 180) end
	end

	return {
		state = if not self.started then "Stopped" elseif available then "Ready" else "ResolverUnavailable",
		started = self.started,
		resolverAvailable = available,
		checks = self.checks,
		denied = self.denied,
		lastError = self.lastError or availabilityError,
		default = "Deny",
	}
end

function Service:Stop()
	self.started = false
end

return Service]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX5">
      <Properties>
        <string name="Name">ClubMusic_Global_SafeCall_Service</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- Centralized protected-call diagnostics for ClubMusic global services.
-- This module observes failures only; it never changes authorization or recovery policy.
local SafeCall = {}
SafeCall.__index = SafeCall

local MAX_RECORDS = 50
local MAX_TEXT = 240
local WARN_COOLDOWN = 30

local function clean(value: any): string
	local text = tostring(value or "")
	text = string.gsub(text, "[%c]", " ")
	return string.sub(text, 1, MAX_TEXT)
end

function SafeCall.new(dependencies: {[string]: any}?)
	local d = if typeof(dependencies) == "table" then dependencies else {}
	return setmetatable({
		serviceName = clean(d.serviceName or "ClubMusicGlobal"),
		records = {},
		counts = {calls = 0, failures = 0, recovered = 0},
		lastSuccess = nil,
		lastFailure = nil,
		lastWarnings = {},
	}, SafeCall)
end

function SafeCall:Run(serviceName: string, operation: string, callback: (...any) -> ...any, ...: any): ...any
	self.counts.calls += 1
	local packed = table.pack(pcall(callback, ...))
	local ok = packed[1] == true
	local now = os.time()
	local service = clean(serviceName ~= "" and serviceName or self.serviceName)
	local op = clean(operation)
	if ok then
		self.lastSuccess = {service = service, operation = op, at = now}
		return table.unpack(packed, 1, packed.n)
	end

	local err = clean(packed[2])
	local trace = err
	if debug and type(debug.traceback) == "function" then
		local traceOk, traceResult = pcall(debug.traceback, err, 2)
		if traceOk then trace = clean(traceResult) end
	end
	self.counts.failures += 1
	self.lastFailure = {service = service, operation = op, error = err, traceback = trace, at = now}
	local record = table.clone(self.lastFailure)
	table.insert(self.records, 1, record)
	while #self.records > MAX_RECORDS do table.remove(self.records) end

	local signature = service .. "|" .. op .. "|" .. err
	local lastWarn = self.lastWarnings[signature] or 0
	if now - lastWarn >= WARN_COOLDOWN then
		self.lastWarnings[signature] = now
		warn("[ClubMusic][SafeCall] Operation failed; service=" .. service
			.. "; operation=" .. op .. "; error=" .. err)
	end
	return false, err, trace
end

function SafeCall:RecordFailure(serviceName: string, operation: string, detail: any)
	local now = os.time()
	local service = clean(serviceName)
	local op = clean(operation)
	local err = clean(detail)
	self.counts.failures += 1
	self.lastFailure = {service = service, operation = op, error = err, traceback = err, at = now}
	table.insert(self.records, 1, table.clone(self.lastFailure))
	while #self.records > MAX_RECORDS do table.remove(self.records) end
	local signature = service .. "|" .. op .. "|" .. err
	local lastWarn = self.lastWarnings[signature] or 0
	if now - lastWarn >= WARN_COOLDOWN then
		self.lastWarnings[signature] = now
		warn("[ClubMusic][SafeCall] Operation reported failure; service=" .. service
			.. "; operation=" .. op .. "; detail=" .. err)
	end
end

function SafeCall:RecordRecovery(serviceName: string, operation: string)
	self.counts.recovered += 1
	local record = {service = clean(serviceName), operation = clean(operation), at = os.time()}
	self.lastSuccess = record
	print("[ClubMusic][SafeCall] Operation recovered; service=" .. record.service .. "; operation=" .. record.operation)
end

function SafeCall:GetRecent(limit: number?): {any}
	local count = math.clamp(math.floor(tonumber(limit) or 20), 1, MAX_RECORDS)
	local out = {}
	for index = 1, math.min(count, #self.records) do
		out[index] = table.clone(self.records[index])
	end
	return out
end

function SafeCall:GetStatus(): {[string]: any}
	return {
		service = self.serviceName,
		calls = self.counts.calls,
		failures = self.counts.failures,
		recovered = self.counts.recovered,
		lastSuccess = if self.lastSuccess then table.clone(self.lastSuccess) else nil,
		lastFailure = if self.lastFailure then table.clone(self.lastFailure) else nil,
		recentFailureCount = #self.records,
	}
end

return SafeCall
]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
