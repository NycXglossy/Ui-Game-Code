    <Item class="ModuleScript" referent="RBX2">
      <Properties>
        <string name="Name">MusicPlaylistService</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- MusicPlaylistService
-- Place as ModuleScript: ServerStorage/MusicPlaylistService
-- Persistent staff-managed playlists. Does not own playback or queue state.

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local MusicPlaylistService = {}
local store = DataStoreService:GetDataStore("ClubMusic_Playlists_v1")
local KEY = "playlists"
local MAX_PLAYLISTS = 30
local MAX_TRACKS = 100
local MAX_NAME = 32

type Playlist = {id: string, name: string, trackIds: {string}, createdAt: number, updatedAt: number}
local playlists: {Playlist} = {}
local ready = false
local persistent = false
local busy = false

local function cleanName(value: any): string?
 if typeof(value) ~= "string" then return nil end
 local name = string.gsub(value, "^%s*(.-)%s*$", "%1")
 if #name < 2 or #name > MAX_NAME then return nil end
 if string.find(name, "[%c]") then return nil end
 return name
end

local function clonePlaylist(p: Playlist): Playlist
 return {id=p.id, name=p.name, trackIds=table.clone(p.trackIds), createdAt=p.createdAt, updatedAt=p.updatedAt}
end

local function sanitize(raw: any): {Playlist}
 local result: {Playlist} = {}
 if typeof(raw) ~= "table" or typeof(raw.playlists) ~= "table" then return result end
 local ids: {[string]: boolean} = {}
 local names: {[string]: boolean} = {}
 for _, item in ipairs(raw.playlists) do
  if #result >= MAX_PLAYLISTS then break end
  if typeof(item) == "table" and typeof(item.id) == "string" and #item.id <= 64
   and string.match(item.id, "^[%w%-_]+$") and not ids[item.id] then
   local name = cleanName(item.name)
   local folded = if name then string.lower(name) else ""
   if name and not names[folded] and typeof(item.trackIds) == "table" then
    local tracks: {string} = {}
    local seen: {[string]: boolean} = {}
    for _, trackId in ipairs(item.trackIds) do
     if #tracks >= MAX_TRACKS then break end
     if typeof(trackId) == "string" and #trackId <= 24
      and string.match(trackId, "^[%w%-_]+$") and not seen[trackId] then
      table.insert(tracks, trackId); seen[trackId] = true
     end
    end
    table.insert(result, {id=item.id, name=name, trackIds=tracks,
     createdAt=math.max(0, tonumber(item.createdAt) or 0),
     updatedAt=math.max(0, tonumber(item.updatedAt) or 0)})
    ids[item.id] = true; names[folded] = true
   end
  end
 end
 return result
end

local function hasValidStoredPlaylistRecords(raw: any): boolean
 if raw == nil then return true end
 if typeof(raw) ~= "table" or typeof(raw.playlists) ~= "table" then return false end
 -- Accept the original unversioned shape and the current v1 record only.
 -- Unknown future versions must not be interpreted as an empty list and overwritten.
 if raw.schemaVersion ~= nil and raw.schemaVersion ~= 1 then return false end
 local count, highest = 0, 0
 for key in pairs(raw.playlists) do
  if typeof(key) ~= "number" or key % 1 ~= 0 or key < 1 or key > MAX_PLAYLISTS then return false end
  count += 1
  if key > highest then highest = key end
 end
 if count ~= highest then return false end
 local cleaned = sanitize(raw)
 if #cleaned ~= count then return false end
 for index, item in ipairs(raw.playlists) do
  if typeof(item.trackIds) ~= "table" then return false end
  local trackCount, trackHighest = 0, 0
  for key in pairs(item.trackIds) do
   if typeof(key) ~= "number" or key % 1 ~= 0 or key < 1 or key > MAX_TRACKS then return false end
   trackCount += 1
   if key > trackHighest then trackHighest = key end
  end
  if trackCount ~= trackHighest or #cleaned[index].trackIds ~= trackCount then return false end
 end
 return true
end

local function pack(list: {Playlist})
 local data = {schemaVersion=1, playlists={}}
 for _, p in ipairs(list) do table.insert(data.playlists, clonePlaylist(p)) end
 return data
end

function MusicPlaylistService:Initialize(studioUseDataStore: boolean?, budgetCallback: (() -> boolean)?): boolean
 if ready then return true end
 persistent = not RunService:IsStudio() or studioUseDataStore == true
 if not persistent then ready = true; return true end
 if budgetCallback and not budgetCallback() then return false end
 local ok, data = pcall(function() return store:GetAsync(KEY) end)
 if not ok then warn("[ClubMusic Playlists] Initial load failed: " .. tostring(data)); return false end
 if not hasValidStoredPlaylistRecords(data) then
  warn("[ClubMusic Playlists] Initialization refused malformed or unsupported stored data; no defaults were substituted.")
  return false
 end
 playlists = sanitize(data); ready = true
 return true
end

function MusicPlaylistService:IsReady(): boolean return ready end

function MusicPlaylistService:GetAll(): {Playlist}
 local result = {}
 for _, p in ipairs(playlists) do table.insert(result, clonePlaylist(p)) end
 table.sort(result, function(a,b)
  local aa,bb=string.lower(a.name),string.lower(b.name)
  return if aa == bb then a.id < b.id else aa < bb
 end)
 return result
end

function MusicPlaylistService:Refresh(budgetCallback: (() -> boolean)?): boolean
 if not ready then return false end
 if not persistent then return true end
 if busy then return false end
 -- Serialize refresh reads with mutations so a stale GetAsync cannot replace a
 -- newer in-memory playlist list after a successful UpdateAsync.
 busy = true
 if budgetCallback then
  local budgetOk, budgetAvailable = pcall(budgetCallback)
  if not budgetOk or budgetAvailable ~= true then
   busy = false
   return false
  end
 end
 local ok, data = pcall(function() return store:GetAsync(KEY) end)
 if not ok then
  busy = false
  warn("[ClubMusic Playlists] Refresh failed: " .. tostring(data))
  return false
 end
 if not hasValidStoredPlaylistRecords(data) then
  busy = false
  warn("[ClubMusic Playlists] Refresh refused malformed or unsupported stored data; last-known-good cache preserved.")
  return false
 end
 playlists = sanitize(data)
 busy = false
 return true
end

local function applyMutation(self, mutate: ({Playlist}) -> (boolean, string)): (boolean, string)
 if not ready then return false, "Playlist storage is unavailable." end
 if busy then return false, "Playlist storage is busy. Try again shortly." end
 if not persistent then
  local candidate = {}
  for _, p in ipairs(playlists) do table.insert(candidate, clonePlaylist(p)) end
  local ok, message = mutate(candidate)
  if ok then playlists = candidate end
  return ok, message
 end
 busy = true
 local accepted, response = false, "Playlist save failed."
 local invalidStoredData = false
 local ok, result = pcall(function()
  return store:UpdateAsync(KEY, function(old)
   invalidStoredData = false
   if not hasValidStoredPlaylistRecords(old) then
    invalidStoredData = true
    return old
   end
   local candidate = sanitize(old)
   local changed, message = mutate(candidate)
   accepted, response = changed, message
   if not changed then return old end
   local output = if typeof(old) == "table" then table.clone(old) else {}
   output.schemaVersion = 1
   output.playlists = pack(candidate).playlists
   return output
  end)
 end)
 busy = false
 if not ok then warn("[ClubMusic Playlists] Mutation failed: " .. tostring(result)); return false, "Playlist save failed; no change was applied." end
 if invalidStoredData then
  warn("[ClubMusic Playlists] Mutation refused malformed or unsupported stored data; persisted record was not overwritten.")
  return false, "Playlist data needs recovery; no change was saved."
 end
 if not accepted then return false, response end
 playlists = sanitize(result)
 return true, response
end

function MusicPlaylistService:Create(name: any): (boolean, string, string?)
 local clean = cleanName(name)
 if not clean then return false, "Playlist names must be 2–32 characters.", nil end
 local id = HttpService:GenerateGUID(false)
 local now = os.time()
 local ok, message = applyMutation(self, function(list)
  if #list >= MAX_PLAYLISTS then return false, "The playlist limit (30) has been reached." end
  for _, p in ipairs(list) do if string.lower(p.name) == string.lower(clean) then return false, "A playlist with that name already exists." end end
  table.insert(list, {id=id, name=clean, trackIds={}, createdAt=now, updatedAt=now})
  return true, "Playlist created."
 end)
 return ok, message, if ok then id else nil
end

function MusicPlaylistService:Delete(id: any): (boolean, string)
 if typeof(id) ~= "string" or #id > 64 then return false, "Invalid playlist." end
 return applyMutation(self, function(list)
  for i,p in ipairs(list) do if p.id == id then table.remove(list,i); return true,"Playlist deleted." end end
  return false, "Playlist not found."
 end)
end

function MusicPlaylistService:AddTrack(id: any, trackId: any): (boolean, string)
 if typeof(id) ~= "string" or #id > 64 or typeof(trackId) ~= "string" or #trackId > 24
  or not string.match(trackId, "^[%w%-_]+$") then return false, "Invalid playlist or track." end
 return applyMutation(self, function(list)
  for _,p in ipairs(list) do if p.id == id then
   if table.find(p.trackIds, trackId) then return false,"That track is already in this playlist." end
   if #p.trackIds >= MAX_TRACKS then return false,"This playlist is full (100 tracks)." end
   table.insert(p.trackIds,trackId); p.updatedAt=os.time(); return true,"Track added to playlist."
  end end
  return false,"Playlist not found."
 end)
end

function MusicPlaylistService:RemoveTrack(id: any, trackId: any): (boolean, string)
 if typeof(id) ~= "string" or #id > 64 or typeof(trackId) ~= "string" or #trackId > 24 then return false,"Invalid playlist or track." end
 return applyMutation(self, function(list)
  for _,p in ipairs(list) do if p.id == id then
   local index = table.find(p.trackIds,trackId)
   if not index then return false,"Track not found in playlist." end
   table.remove(p.trackIds,index); p.updatedAt=os.time(); return true,"Track removed from playlist."
  end end
  return false,"Playlist not found."
 end)
end

function MusicPlaylistService:MoveTrack(id: any, trackId: any, position: any): (boolean, string)
 if typeof(id) ~= "string" or #id > 64 or typeof(trackId) ~= "string" or #trackId > 24
  or typeof(position) ~= "number" or position ~= position or position % 1 ~= 0 then return false,"Invalid playlist order." end
 return applyMutation(self, function(list)
  for _,p in ipairs(list) do if p.id == id then
   local old = table.find(p.trackIds,trackId)
   if not old then return false,"Track not found in playlist." end
   local target = math.clamp(position,1,#p.trackIds)
   table.remove(p.trackIds,old); table.insert(p.trackIds,target,trackId)
   p.updatedAt=os.time(); return true,"Playlist order updated."
  end end
  return false,"Playlist not found."
 end)
end

return MusicPlaylistService
]]></ProtectedString>
      </Properties>
    </Item>
    
    <Item class="ModuleScript" referent="RBX7">
      <Properties>
        <string name="Name">MusicQueueManager</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- Compatibility adapter for the ClubMusic controller.
-- Queue behavior lives in MusicQueueManagerService; this module owns no queue
-- table, counters, playback state, or duplicate service implementation.

local ServerStorage = game:GetService("ServerStorage")
local MusicQueueManager = {}

-- Support both direct ServerStorage installation and the canonical
-- ClubMusic_ServerStorage_Modules RBXMX folder layout.
local serviceModule = script.Parent:FindFirstChild("MusicQueueManagerService")
if not serviceModule then serviceModule = ServerStorage:FindFirstChild("MusicQueueManagerService") end
if not serviceModule then
	local packageFolder = ServerStorage:FindFirstChild("ClubMusic_ServerStorage_Modules")
	if packageFolder and packageFolder:IsA("Folder") then
		serviceModule = packageFolder:FindFirstChild("MusicQueueManagerService")
	end
end
if not serviceModule then serviceModule = ServerStorage:WaitForChild("MusicQueueManagerService", 20) end
if not serviceModule or not serviceModule:IsA("ModuleScript") then
	error("[ClubMusic] Missing MusicQueueManagerService ModuleScript in the controller's ServerStorage package.")
end

local serviceRequireOk, serviceRequireResult = pcall(require, serviceModule)
if not serviceRequireOk then
	error("[ClubMusic] MusicQueueManagerService failed to load: " .. tostring(serviceRequireResult))
end

local MusicQueueManagerService = serviceRequireResult
if type(MusicQueueManagerService) ~= "table" or type(MusicQueueManagerService.new) ~= "function" then
	error("[ClubMusic] MusicQueueManagerService must return a table with a .new() constructor.")
end

function MusicQueueManager.new(sharedQueue: {any}, releaseSlot: ((any) -> ())?): any
	return MusicQueueManagerService.new(sharedQueue, releaseSlot)
end

return MusicQueueManager
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX8">
      <Properties>
        <string name="Name">MusicQueueManagerService</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- Authoritative in-memory queue operations for ClubMusic.
-- The controller supplies the one shared queue and its slot-release callback.
-- This service deliberately does not create a second queue or own playback state.

local MusicQueueManagerService = {}
MusicQueueManagerService.__index = MusicQueueManagerService

export type QueueManagerService = {
	queue: {any},
	releaseSlot: ((any) -> ())?,
	GetQueue: (self: QueueManagerService) -> {any},
	GetSize: (self: QueueManagerService) -> number,
	IsEmpty: (self: QueueManagerService) -> boolean,
	Insert: (self: QueueManagerService, index: number, entry: any) -> boolean,
	PopNext: (self: QueueManagerService) -> any?,
	RemoveAt: (self: QueueManagerService, index: number, release: boolean?) -> any?,
	RemoveUserSongs: (self: QueueManagerService, userId: number) -> number,
	Clear: (self: QueueManagerService, release: boolean?) -> number,
	ClearAutomatic: (self: QueueManagerService) -> number,
}

function MusicQueueManagerService.new(sharedQueue: {any}, releaseSlot: ((any) -> ())?): QueueManagerService
	assert(type(sharedQueue) == "table", "MusicQueueManagerService requires the controller-owned queue table")
	assert(releaseSlot == nil or type(releaseSlot) == "function", "MusicQueueManagerService releaseSlot must be a function")
	local self = setmetatable({}, MusicQueueManagerService)
	self.queue = sharedQueue
	self.releaseSlot = releaseSlot
	return self
end

function MusicQueueManagerService:GetQueue(): {any}
	return self.queue
end

function MusicQueueManagerService:GetSize(): number
	return #self.queue
end

function MusicQueueManagerService:IsEmpty(): boolean
	return #self.queue == 0
end

function MusicQueueManagerService:Insert(index: number, entry: any): boolean
	if type(index) ~= "number"
		or index % 1 ~= 0
		or index < 1
		or index > #self.queue + 1
		or type(entry) ~= "table"
	then
		return false
	end
	table.insert(self.queue, index, entry)
	return true
end

function MusicQueueManagerService:PopNext(): any?
	if #self.queue == 0 then
		return nil
	end
	local entry = table.remove(self.queue, 1)
	if self.releaseSlot then
		self.releaseSlot(entry)
	end
	return entry
end

function MusicQueueManagerService:RemoveAt(index: number, release: boolean?): any?
	if type(index) ~= "number"
		or index % 1 ~= 0
		or index < 1
		or index > #self.queue
	then
		return nil
	end

	local entry = table.remove(self.queue, index)
	if release ~= false and self.releaseSlot then
		self.releaseSlot(entry)
	end
	return entry
end

function MusicQueueManagerService:RemoveUserSongs(userId: number): number
	if type(userId) ~= "number" or userId <= 0 or userId % 1 ~= 0 then
		return 0
	end

	local removed = 0
	for index = #self.queue, 1, -1 do
		local entry = self.queue[index]
		if type(entry) == "table" and entry.source == "player" and entry.userId == userId then
			self:RemoveAt(index, true)
			removed += 1
		end
	end
	return removed
end

function MusicQueueManagerService:Clear(release: boolean?): number
	local removed = #self.queue
	if release ~= false and self.releaseSlot then
		for _, entry in ipairs(self.queue) do
			self.releaseSlot(entry)
		end
	end
	table.clear(self.queue)
	return removed
end

function MusicQueueManagerService:ClearAutomatic(): number
	local removed = 0
	for index = #self.queue, 1, -1 do
		local entry = self.queue[index]
		if type(entry) == "table" and entry.source ~= "player" then
			self:RemoveAt(index, false)
			removed += 1
		end
	end
	return removed
end

return MusicQueueManagerService
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX9">
      <Properties>
        <string name="Name">MusicValidationService</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- Bounded metadata cache for ClubMusic's existing server-side audio inspection.
-- This module does not own player permissions, cooldowns, spam limits, or audio playback.
-- The controller remains responsible for loading each Sound and verifying playability.

export type AssetInfo = {
	AssetTypeId: number?,
	Name: string?,
	Creator: { Name: string? }?,
}

export type MetadataProvider = (assetId: number) -> any

type CacheEntry = {
	valid: boolean,
	info: AssetInfo?,
	error: string?,
	expiresAt: number,
	generation: number,
}

type CacheQueueItem = {
	assetId: number,
	generation: number,
}

local MusicValidationService = {}
MusicValidationService.__index = MusicValidationService

function MusicValidationService.new(config: any, metadataProvider: MetadataProvider)
	assert(type(config) == "table", "MusicValidationService requires a configuration table")
	assert(type(metadataProvider) == "function", "MusicValidationService requires an injected metadata provider")

	local ttl = tonumber(config.CacheTTLSeconds) or 300
	local failureTtl = tonumber(config.FailureCacheTTLSeconds) or 5
	local maxEntries = tonumber(config.MaxCacheEntries) or 128
	assert(ttl >= 1 and ttl <= 3600, "CacheTTLSeconds must be between 1 and 3600")
	assert(failureTtl >= 1 and failureTtl <= 30, "FailureCacheTTLSeconds must be between 1 and 30")
	assert(maxEntries >= 1 and maxEntries <= 512 and maxEntries % 1 == 0, "MaxCacheEntries must be an integer between 1 and 512")

	local self = setmetatable({}, MusicValidationService)
	self.cacheTTLSeconds = ttl
	self.failureCacheTTLSeconds = failureTtl
	self.maxCacheEntries = maxEntries
	self.metadataProvider = metadataProvider
	self.cache = {} :: {[number]: CacheEntry}
	self.cacheOrder = {
		items = {} :: {[number]: CacheQueueItem},
		head = 1,
		count = 0,
	}
	self.cacheSequence = 0
	return self
end

local function normalizeAssetInfo(rawInfo: any): AssetInfo?
	if typeof(rawInfo) ~= "table" then return nil end

	local assetTypeId = tonumber(rawInfo.AssetTypeId)
	if not assetTypeId or assetTypeId % 1 ~= 0 then return nil end

	local creatorName = "Unknown"
	if typeof(rawInfo.Creator) == "table" and type(rawInfo.Creator.Name) == "string" then
		creatorName = string.sub(rawInfo.Creator.Name, 1, 80)
	end

	local name = if type(rawInfo.Name) == "string" then string.sub(rawInfo.Name, 1, 120) else "Untitled audio"
	return {
		AssetTypeId = assetTypeId,
		Name = name,
		Creator = { Name = creatorName },
	}
end

-- Circular FIFO insertion is O(1). A generation token prevents an old queue
-- slot from evicting a newer entry for the same asset after expiry/reinsertion.
local function setCache(self: any, assetId: number, entry: CacheEntry)
	self.cacheSequence += 1
	local existing = self.cache[assetId]
	if existing then
		entry.generation = existing.generation
	else
		local order = self.cacheOrder
		local nextItem: CacheQueueItem = {
			assetId = assetId,
			generation = self.cacheSequence,
		}
		if order.count >= self.maxCacheEntries then
			local oldest = order.items[order.head]
			order.items[order.head] = nextItem
			order.head = (order.head % self.maxCacheEntries) + 1
			if oldest then
				local oldEntry = self.cache[oldest.assetId]
				if oldEntry and oldEntry.generation == oldest.generation then
					self.cache[oldest.assetId] = nil
				end
			end
		else
			local tail = ((order.head + order.count - 1) % self.maxCacheEntries) + 1
			order.items[tail] = nextItem
			order.count += 1
		end
		entry.generation = self.cacheSequence
	end
	self.cache[assetId] = entry
end

function MusicValidationService:GetAudioAssetInfo(assetId: number): (boolean, AssetInfo | string, boolean)
	if type(assetId) ~= "number" or assetId ~= assetId or assetId % 1 ~= 0
		or assetId <= 0 or assetId > 9007199254740991 then
		return false, "Invalid audio asset ID.", false
	end

	local now = os.clock()
	local cached = self.cache[assetId]
	if cached then
		if cached.expiresAt > now then
			local cachedValue: AssetInfo | string = if cached.valid then cached.info :: AssetInfo else cached.error :: string
			return cached.valid, cachedValue, true
		end
		self.cache[assetId] = nil
	end

	local providerOk, rawInfo = pcall(self.metadataProvider, assetId)
	if not providerOk then
		local message = "Audio asset metadata is temporarily unavailable."
		setCache(self, assetId, {
			valid = false,
			error = message,
			expiresAt = now + self.failureCacheTTLSeconds,
			generation = 0,
		})
		return false, message, false
	end

	local info = normalizeAssetInfo(rawInfo)
	if not info then
		local message = "Audio asset metadata is invalid or unavailable."
		setCache(self, assetId, {
			valid = false,
			error = message,
			expiresAt = now + self.failureCacheTTLSeconds,
			generation = 0,
		})
		return false, message, false
	end

	setCache(self, assetId, {
		valid = true,
		info = info,
		expiresAt = now + self.cacheTTLSeconds,
		generation = 0,
	})
	return true, info, false
end

-- Marketplace metadata alone never proves experience permission or playability.
-- The controller performs the separate AudioPlayer preload before accepting a track.
function MusicValidationService:NormalizeAudioMetadata(assetId: number, info: any, duration: number): {[string]: any}?
	if type(assetId) ~= "number" or assetId ~= assetId or assetId % 1 ~= 0
		or assetId <= 0 or assetId > 9007199254740991 or typeof(info) ~= "table" then
		return nil
	end
	if type(duration) ~= "number" or duration ~= duration or duration % 1 ~= 0
		or duration < 1 or duration > 3600 then
		return nil
	end

	local rawCreator = info.Creator
	local creator = if typeof(rawCreator) == "table" then rawCreator.Name else nil
	if type(creator) ~= "string" or creator == "" then creator = "Unknown" end
	local title = if type(info.Name) == "string" then info.Name else "Untitled audio"

	return {
		assetId = assetId,
		soundId = "rbxassetid://" .. tostring(assetId),
		title = string.sub(title, 1, 60),
		artist = string.sub(creator, 1, 40),
		genre = "Creator Hub Audio",
		duration = duration,
		metadataSource = "MarketplaceService",
	}
end

function MusicValidationService:ClearCache()
	table.clear(self.cache)
	self.cacheOrder = {
		items = {} :: {[number]: CacheQueueItem},
		head = 1,
		count = 0,
	}
	self.cacheSequence = 0
end

function MusicValidationService:GetCacheStats(): { total: number, max: number, valid: number, invalid: number }
	local now = os.clock()
	local total = 0
	local valid = 0
	local invalid = 0
	for assetId, entry in pairs(self.cache) do
		if entry.expiresAt <= now then
			self.cache[assetId] = nil
		else
			total += 1
			if entry.valid then valid += 1 else invalid += 1 end
		end
	end
	return { total = total, max = self.maxCacheEntries, valid = valid, invalid = invalid }
end

return MusicValidationService
]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
</roblox>
