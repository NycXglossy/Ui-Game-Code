									<ProtectedString name="Source"><![CDATA[local UI = require(script.Parent.Parent)
local BaseClass = require(script.Parent:WaitForChild("BaseClass"))
local Clack = require(script.Clack).registerAll()

Clack.enabled = UI.raw(UI.Theme.TypingSounds)
Clack.everyTextBox = UI.raw(UI.Theme.TypingSoundsOnEveryTextBox)
UI.effect(UI.on(UI.Theme.TypingSounds, function(value)
	Clack.enabled = value and UI.Theme.SoundEnabled:peek()
end, true)):get()
UI.effect(UI.on(UI.Theme.TypingSoundsOnEveryTextBox, function(value)
	Clack.everyTextBox = value
end, true)):get()

local function stripNewLines(text: string)
	return string.gsub(string.gsub(text, "\n", " "), "\r", " ")
end

-- NOTE: only works for single line inputs
-- TODO: fallback for multiline
local function bytePositionToWidth(text, size, font, richText, bytePosition)
	if bytePosition == 1 then
		return 0
	end

	local params = Instance.new("GetTextBoundsParams")
	params.Font = font
	params.RichText = richText
	params.Size = size
	params.Text = string.sub(text, 1, bytePosition - 1)
	params.Width = math.huge

	return math.ceil(UI.retryGetTextBoundsAsync(params).X)
end

local function updateSelection(selection, display, input, inputOffset, cursorWidth)
	cursorWidth = cursorWidth
		or bytePositionToWidth(input.Text, display.TextSize, display.FontFace, display.RichText, input.CursorPosition)
	local selectWidth =
		bytePositionToWidth(input.Text, display.TextSize, display.FontFace, display.RichText, input.SelectionStart)
	local deltaWidth = cursorWidth - selectWidth
	selection.Size = UDim2.fromOffset(deltaWidth, display.TextSize)
	selection.Position = UDim2.new(0, selectWidth - inputOffset:peek(), 0.5, 0)
	selection.Visible = true
end

local function updateCursor(cursor, display, input, inputMask, inputOffset, selection)
	local cursorWidth =
		bytePositionToWidth(input.Text, display.TextSize, display.FontFace, display.RichText, input.CursorPosition)
	local visibleWidth = cursor.Parent.AbsoluteSize.X
	local cursorOffset = cursorWidth - inputOffset:peek()

	local margin = if (display.TextBounds.X > visibleWidth or inputOffset:peek() > 0) and cursorWidth > 32
		then 32
		else 0
	if cursorOffset > visibleWidth then
		inputOffset(math.min(display.TextBounds.X, inputOffset:peek() + cursorOffset - visibleWidth))
		cursorOffset = visibleWidth
	elseif cursorOffset < margin then
		inputOffset(inputOffset:peek() + cursorOffset - margin)
		if margin == 0 or inputOffset:peek() <= display.TextSize / 2 then
			inputOffset(math.min(0, inputOffset:peek()))
		end
		cursorOffset = margin
	end

	input.Position = UDim2.fromOffset(-inputOffset:peek(), 0)
	cursor.Position = UDim2.fromOffset(cursorOffset, 1)
	cursor.Visible = true

	if input.SelectionStart ~= -1 then
		updateSelection(selection, display, input, inputOffset, cursorWidth)
	end
end

local MODIFIERS = {
	Enum.KeyCode.LeftControl,
	Enum.KeyCode.RightControl,
	Enum.KeyCode.LeftShift,
	Enum.KeyCode.RightShift,
	Enum.KeyCode.LeftAlt,
	Enum.KeyCode.RightAlt,
	Enum.KeyCode.LeftMeta,
	Enum.KeyCode.RightMeta,
	Enum.KeyCode.LeftSuper,
	Enum.KeyCode.RightSuper,
}

local DEFAULT = {
	Cursor = "_",
	DisplayText = "",
	Placeholder = "",
	Value = "",
	ClearTextButton = false,
	--- Fills to the size of the text input.
	Fill = false,
	FontFace = UI.Theme.Font,
	FontSize = UI.Theme.FontSize,
	TextColor3 = UI.Theme.PrimaryText,
	TextStrokeColor3 = UI.Theme.Primary,
	TextStrokeTransparency = UI.Theme.TextStrokeTransparency,
	Padding = UI.Theme.Padding,
	Icon = "",
	IconProperties = {},
	IconRightAlign = false,
	HotkeyInput = false,
	Hotkey = UI.Nil,
	Modifiers = UI.Nil,
	MaxChars = math.huge,
	NumberOnly = false,
	IntegerOnly = false,
	NumberRange = NumberRange.new(0, 1),
	Validate = UI.Function,
}

type Properties = typeof(DEFAULT) & TextButton

local Class = {}
Class.__index = Class
setmetatable(Class, BaseClass)

-- Writes Value and the TextBox text together. Writing Value alone only reaches `_input.Text` when valueSync runs on the
-- next flush, so callers that read `_input.Text` or set CursorPosition straight after must use this.
function Class:SetValue(value: any)
	self.Value(value, true)
	self._input.Text = tostring(value)
	if not UI.isReactive() then
		UI.flush()
	end
end

-- TODO: send/clear button
function Class.new(properties: Properties?)
	local self = table.clone(DEFAULT)
	UI.makeStatefulDefaults(self, properties)
	self.IconProperties = {}

	local cleanup = {}
	local textState = UI.signal(UI.raw(self.Value))

	local inputSize = function()
		local fill = self.Fill()
		return UDim2.new(if fill then 1 else 0, if fill then 0 else self.FontSize(), 1, 0)
	end

	local displayLabel = UI.new "TextLabel" {
		AutomaticSize = Enum.AutomaticSize.X,
		AutoLocalize = false,
		Size = inputSize,
		BackgroundTransparency = 1,
		TextSize = self.FontSize,
		TextColor3 = self.TextColor3,
		FontFace = self.FontFace,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = function()
			local display = self.DisplayText()
			local placeholder = self.Placeholder()
			local input = textState()
			local maxChars = self.MaxChars()

			local text = if display ~= "" then display elseif input ~= "" then input else placeholder
			text = stripNewLines(text)

			return if maxChars ~= math.huge then string.sub(text, 1, maxChars :: number) else text
		end,
		TextTransparency = function()
			return if textState() == "" and self.DisplayText() == "" then 0.5 else 0
		end,
	}
	self._displayLabel = displayLabel

	local valueSync = UI.effect(UI.on(self.Value, function(value)
		self._input.Text = tostring(value)
	end, true))
	valueSync:get()
	table.insert(cleanup, valueSync)

	self._input = UI.new "TextBox" {
		AutomaticSize = Enum.AutomaticSize.X,
		AutoLocalize = false,
		ClearTextOnFocus = false,
		Size = inputSize,
		BackgroundTransparency = 1,
		TextTransparency = 1,
		TextSize = self.FontSize,
		Text = tostring(UI.raw(self.Value)),
		FontFace = self.FontFace,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		CursorPosition = -1,

		displayLabel,

		FocusLost = function()
			local text = self._input.Text
			local numberOnly = self.NumberOnly:peek()
			local integerOnly = self.IntegerOnly:peek()

			if text == "" and (numberOnly or integerOnly) then
				self:SetValue(self.NumberRange:peek().Min)
				return
			end

			if (numberOnly or integerOnly) and text ~= "" then
				local number = tonumber(text)
				if not number or (integerOnly and string.find(text :: string, "%D")) then
					self._input.Text = tostring(self.Value:peek())
					return
				end
				local numberClamped = math.clamp(number, self.NumberRange:peek().Min, self.NumberRange:peek().Max)
				text = if number == numberClamped then self._input.Text else numberClamped
				self._input.Text = tostring(text)
				local textLength = #tostring(text)
				if self._input.CursorPosition - 1 > textLength then
					self._input.CursorPosition = textLength + 1
				end
			end

			if self.Hotkey and self.Hotkey:peek() then
				local key = UI.UserInputService:GetStringForKeyCode(self.Hotkey:peek())
				if key ~= string.sub(tostring(text), -1) then
					text = tostring(text) .. key
					self._input.Text = text
				end
			end

			if self.MaxChars:peek() ~= math.huge then
				text = string.sub(tostring(text), 1, self.MaxChars:peek())
				self._input.CursorPosition = math.min(self.MaxChars:peek() + 1, self._input.CursorPosition)
				self._input.Text = text
			end

			if self.Validate and not self.Validate:peek()(text) then
				local currentText = tostring(self.Value:peek())
				self._input.Text = if self.MaxChars:peek() ~= math.huge
					then string.sub(currentText, 1, self.MaxChars:peek())
					else currentText
				return
			end

			self:SetValue(text)
		end,
	}
	self._input:AddTag("KeyClackSound")

	if self.HotkeyInput:peek() then
		local focusConn = self._input.Focused:Connect(function()
			self:SetValue("")
		end)
		table.insert(cleanup, focusConn)
		local inputConn = UI.UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if not self._input:IsFocused() then
				return
			end
			if input.UserInputType == Enum.UserInputType.Keyboard then
				local mods = {}
				mods.Ctrl = input:IsModifierKeyDown(Enum.ModifierKey.Ctrl)
				mods.Shift = input:IsModifierKeyDown(Enum.ModifierKey.Shift)
				mods.Alt = input:IsModifierKeyDown(Enum.ModifierKey.Alt)
				mods.Meta = input:IsModifierKeyDown(Enum.ModifierKey.Meta)

				local hotkeyText =
					`{mods.Ctrl and "Ctrl+" or ""}{mods.Shift and "Shift+" or ""}{mods.Alt and "Alt+" or ""}{mods.Meta and "Meta+" or ""}`
				if table.find(MODIFIERS, input.KeyCode) then
					self:SetValue(hotkeyText)
					return
				end

				self.Hotkey(input.KeyCode)
				self.Modifiers(mods)
				self:SetValue(hotkeyText .. UI.UserInputService:GetStringForKeyCode(input.KeyCode))
				self._input:ReleaseFocus(true)
			end
		end)
		table.insert(cleanup, inputConn)
	end

	local selection = UI.new "Frame" {
		Name = "Selection",
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundTransparency = 0.75,
		Size = UDim2.new(0, 0, 0, self.FontSize:peek()),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = UI.Theme.Secondary,
		BorderSizePixel = 0,
		Visible = false,
	}

	local cursor = UI.new "TextLabel" {
		Name = "Cursor",
		AutoLocalize = false,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		Position = UDim2.new(0, 0, 0, 0),
		BackgroundTransparency = 1,
		TextSize = self.FontSize,
		TextColor3 = UI.Theme.PrimaryText,
		TextStrokeColor3 = UI.Theme.Primary,
		TextStrokeTransparency = UI.Theme.TextStrokeTransparency,
		FontFace = self.FontFace,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = self.Cursor,
		Visible = false,
	}
	local lastCursorChange = 0
	task.defer(function() -- blinking cursor
		while cursor and cursor.Parent do
			if cursor.Visible and tick() - lastCursorChange > 0.25 then
				cursor.TextTransparency = if cursor.TextTransparency == 1 then 0 else 1
			end
			task.wait(0.5)
		end
	end)

	local automaticFill = function()
		return if self.Fill() then Enum.AutomaticSize.None else Enum.AutomaticSize.X
	end

	local inputMask = UI.new "Frame" {
		Name = "InputMask",
		AutomaticSize = automaticFill,
		ClipsDescendants = true,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.new(1, 0, 1, 0),

		self._input,
		selection,
	}

	self._inputOffset = UI.signal(0)
	self._maskSize = UI.property(inputMask, "AbsoluteSize")
	self._bounds = UI.property(self._input, "TextBounds")
	table.insert(cleanup, textState)
	table.insert(cleanup, self._inputOffset)
	table.insert(cleanup, self._maskSize)
	table.insert(cleanup, self._bounds)

	local isUpdating = false
	UI.edit(self._input)({
		Position = function()
			local xOffset = if self._bounds().X > self._maskSize().X then -self._inputOffset() else 0
			return UDim2.fromOffset(xOffset, 0)
		end,
		_Text = function()
			if isUpdating then
				return
			end
			isUpdating = true

			local text = self._input.Text
			text = if self.MaxChars:peek() ~= math.huge then string.sub(text, 1, self.MaxChars:peek()) else text
			self._input.Text = text
			textState(text, true)
			UI.flush()

			isUpdating = false
		end,
		_SelectionStart = function()
			if self._input.SelectionStart == -1 then
				selection.Visible = false
			else
				updateSelection(selection, displayLabel, self._input, self._inputOffset)
			end
		end,
		_CursorPosition = function()
			lastCursorChange = tick()
			cursor.TextTransparency = 0
			if self._input.CursorPosition == -1 then
				cursor.Visible = false
			else
				-- defer for text to register
				task.defer(updateCursor, cursor, displayLabel, self._input, inputMask, self._inputOffset, selection)
			end
		end,
	})

	local icon = UI.new "ImageLabel" {
		LayoutOrder = 1,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		Image = self.Icon,
		ImageColor3 = UI.Theme.Secondary,
		Visible = function()
			return self.Icon() ~= ""
		end,
	}
	if properties and properties.IconProperties then
		UI.edit(icon)(properties.IconProperties)
	end

	self._instance = UI.new "Frame" {
		Name = "Input",
		AutomaticSize = automaticFill,
		ClipsDescendants = true,
		BackgroundColor3 = UI.Theme.Secondary,
		BackgroundTransparency = UI.Theme.TransparencyHeavy,
		Size = function()
			return UDim2.new(1, 0, 0, self.FontSize() + self.Padding().Offset * 2)
		end,

		UI.corner(UI.Theme.CornerPadded),
		UI.new "Stroke" {},
		UI.padding {
			x = self.Padding,
		},
		UI.list {
			direction = "x",
			gap = self.Padding,
			verticalAlign = "center",
		},

		icon,

		UI.new "Frame" {
			LayoutOrder = 2,
			AutomaticSize = Enum.AutomaticSize.X,
			Name = "InputFrame",
			BackgroundTransparency = 1,
			Size = UDim2.new(0, 0, 1, 0),

			cursor,
			inputMask,
			UI.flex("fill"),
		},

		UI.new "ImageButton" {
			LayoutOrder = 3,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(0.5, 0.5),
			SizeConstraint = Enum.SizeConstraint.RelativeYY,
			Image = UI.Theme.Image.Close,
			ImageColor3 = UI.Theme.Secondary,
			Visible = function()
				return self.ClearTextButton() and textState() ~= ""
			end,

			Activated = function()
				self._input.Text = ""
				self.DisplayText("", true)
				self.Value("", true)
				textState("", true)
				UI.flush()
			end,
		},

		__CLEAN = cleanup,
	}

	return setmetatable(self, Class) :: typeof(self) & typeof(Class)
end

return Class
]]></ProtectedString>
									<string name="ScriptGuid">{EF4EAB1A-7DBD-4F44-98DE-A5E8B5876CAB}</string>
									<BinaryString name="AttributesSerialize"></BinaryString>
									<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
									<bool name="DefinesCapabilities">false</bool>
									<string name="Name">Input</string>
									<BinaryString name="SerializedOverrides"></BinaryString>
									<int64 name="SourceAssetId">-1</int64>
									<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
								</Properties>
								<Item class="ModuleScript" referent="RBXB95E6E709F744951BE7872F280530C8A">
									<Properties>
										<Content name="LinkedSource"><null></null></Content>
										<ProtectedString name="Source"><![CDATA[local ContentProvider = game:GetService("ContentProvider")
local TextChatService = game:GetService("TextChatService")
local UserInputService = game:GetService("UserInputService")
local SoundService = game:GetService("SoundService")

local ChatInputBarConfiguration = TextChatService:FindFirstChildOfClass("ChatInputBarConfiguration")

local module = {
	enabled = true,
	everyTextBox = true,
}

local clacks = "rbxassetid://136112106699293"

local sound = Instance.new("Sound")
sound.SoundId = clacks
task.spawn(ContentProvider.PreloadAsync, ContentProvider, { sound })

local lastHash, lastKey
local random = Random.new()

function module.sound(keycode)
	local keyHash = keycode.Value % 8
	local sound = Instance.new("Sound")
	sound.Volume = random:NextNumber(1.5, 2)
	if keyHash == lastHash and keycode ~= lastKey then
		sound.PlaybackSpeed = random:NextNumber(0.9, 1.1)
	end
	sound.SoundId = clacks
	sound.PlaybackRegionsEnabled = true
	sound.PlaybackRegion = NumberRange.new(keyHash * 0.3, keyHash * 0.3 + 0.15)
	sound.Parent = SoundService
	sound:Play()
	task.delay(1, sound.Destroy, sound)
	lastHash, lastKey = keyHash, keycode
end

function module.registerAll()
	module.registerAll = (nil :: unknown) :: typeof(module.registerAll)
	local focused, textBoxFocused = {}, false
	local _ = UserInputService.TextBoxFocused:Connect(function(textbox)
		if not (textbox and textbox.TextEditable) then
			return
		end
		focused[textbox] = true
		textBoxFocused = textbox
	end)

	local _ = UserInputService.TextBoxFocusReleased:Connect(function(textbox)
		if not (textbox and textbox.TextEditable) then
			return
		end
		focused[textbox] = nil
		if next(focused) then
			return
		end
		textBoxFocused = nil
	end)

	local _ = UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
		if
			not module.enabled
			or not (textBoxFocused or (ChatInputBarConfiguration and ChatInputBarConfiguration.IsFocused))
			or input.KeyCode == Enum.KeyCode.None
		then
			return
		end
		if module.everyTextBox or (textBoxFocused and textBoxFocused:HasTag("KeyClackSound")) then
			task.spawn(module.sound, input.KeyCode)
		end
	end)
	return module
end

return module
]]></ProtectedString>
