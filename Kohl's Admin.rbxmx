	{
		name = "antilag",
		aliases = { "unantilag" },
		description = "Improves the game performance for one or more player(s).",
		args = {
			{
				type = "players",
				name = "Player(s)",
				description = "The player(s) whose performance to improve.",
				shouldRequest = true,
			},
		},
		envClient = function(_K)
			local parentMap = {}
			local _ = _K.Remote.AntiLag:Connect(function(undo: boolean?)
				if undo then
					for _, instance in game:GetDescendants() do
						if instance:HasTag("_K_Ignore") then
							continue
						end

						if instance:IsA("BasePart") then
							_K.Util.Property.reset(instance, "Material")
						end
						_K.Util.Defer.wait()
					end
					for instance, parent in parentMap do
						instance.Parent = parent
					end
					table.clear(parentMap)
					return
				end

				for _, instance in game:GetDescendants() do
					local parent = instance.Parent
					local model = instance:FindFirstAncestorOfClass("Model")
					local humanoid = model and model:FindFirstChildOfClass("Humanoid")

					if humanoid or instance:HasTag("_K_Ignore") then
						continue
					end

					if instance:IsA("Decal") or instance:IsA("Texture") then
						parentMap[instance] = parent
						instance.Parent = nil
					elseif instance:IsA("BasePart") then
						_K.Util.Property.override(instance, "Material", Enum.Material.SmoothPlastic)
					elseif instance:IsA("MeshPart") then
						_K.Util.Property.override(instance, "Material", Enum.Material.SmoothPlastic)
						_K.Util.Property.override(instance, "TextureID", "")
					end

					_K.Util.Defer.wait()
				end
			end)
		end,
		env = function(_K)
			return { remote = _K.Remote.AntiLag }
		end,
		run = function(context, players)
			for _, player in players do
				context.env.remote:Fire(player, context.undo)
			end
		end,
	},
	{
		name = "fps",
		aliases = { "lag", "unlag", "unfps" },
		description = "Limits the frames per second of one or more player(s).",
		args = {
			{
				type = "players",
				name = "Player(s)",
				description = "The player(s) whose frames per second to limit.",
				shouldRequest = true,
			},
			{
				type = "number",
				name = "FPS",
				description = "The frames per second limit.",
				optional = true,
			},
		},
		envClient = function(_K)
			local connection
			local fps = 0

			local frameStart = 0
			local _ = _K.Service.Run.PreRender:Connect(function()
				frameStart = tick()
			end)

			local function lag()
				if not _K.LocalPlayer:GetAttribute("_KFPSLimit") then
					connection:Disconnect()
					return
				end

				local now = tick()
				local elapsed = now - frameStart
				local nextStep = now + (1 / fps :: number) - elapsed * 2
				repeat
				until tick() >= nextStep
			end

			local _ = _K.Remote.FPS:Connect(function(amount: number?)
				fps = math.max(1, amount or 32)
				if connection then
					connection:Disconnect()
				end
				connection = _K.Service.Run.Heartbeat:Connect(lag)
			end)
		end,
		env = function(_K)
			return { remote = _K.Remote.FPS }
		end,

		run = function(context, players, fps)
			local undo = context.undo or (not fps and context.alias == "fps")
			for _, player in players do
				if undo then
					player:SetAttribute("_KFPSLimit", nil)
					continue
				end
				player:SetAttribute("_KFPSLimit", true)
				context.env.remote:Fire(player, fps)
			end
		end,
	},
	{
		name = "lock",
		description = "Locks the character of one or more player(s).",
		args = {
