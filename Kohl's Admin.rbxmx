										table.insert(welds, v2)
										p1.Anchored = true
										v2.Part0 = nil
									end
								elseif v2:IsA("CharacterMesh") then
									local bp = tostring(v2.BodyPart):match("%w+.%w+.(%w+)")
									local msh = Instance.new("SpecialMesh")
