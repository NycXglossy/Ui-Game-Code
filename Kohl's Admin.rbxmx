							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- "non-abusive" commands for game staff members

local VOICE_IDS = {
	"British male",
	"British female",
	"US male",
	"US female",
	"US male #2",
	"US female #2",
	"Australian male",
	"Australian female",
	"Retro #1",
	"Retro #2",
}

local VOTE_DURATION = 30
local VOTE_YES_NO = { "YES", "NO" }
local POLL_MAX_OPTIONS = 8
local POLL_MAX_LENGTH = 200 -- TextChatService message limit
local RESULTS_DURATION = 20

--- Cleans up a poll's question and options, the options are nil for a yes/no vote
local function preparePoll(_K, question: string, given: { string }?): (string?, { string }?, string?)
	question = _K.Util.String.trim(question or "")
	if question == "" then
		return nil, nil, "A poll needs a question."
	end
	if (utf8.len(question) or #question) > POLL_MAX_LENGTH then
		return nil, nil, `The question can be at most {POLL_MAX_LENGTH} characters.`
	end

	if not given or #given == 0 then
		return question, nil, nil
	end

	local options, seen = {}, {}
	for _, option in given do
		option = _K.Util.String.trim(option)
		if option == "" then
			continue
		end
		if (utf8.len(option) or #option) > POLL_MAX_LENGTH then
			return nil, nil, `Each option can be at most {POLL_MAX_LENGTH} characters.`
		end
		local key = string.lower(option)
		if seen[key] then
			return nil, nil, "Poll options must be different from each other."
		end
		seen[key] = true
		table.insert(options, option)
	end

	if #options < 2 then
		return nil, nil, "A poll needs at least 2 options."
	elseif #options > POLL_MAX_OPTIONS then
		return nil, nil, `A poll can have at most {POLL_MAX_OPTIONS} options.`
	end

	return question, options, nil
end

--[=[
	Runs a vote for `players`, shared by the yes/no `vote` and the multiple choice `poll`.

	The server validates the options and tallies the votes, accepting one option number per asked player until the
	vote closes. Clients only display the options and report which one was picked.
]=]
local function startVote(context, players: { Player }, text: string, given: { string }?): string?
	if context.global then
		return
	end
	local _K = context._K

	local question, options, prepErr = preparePoll(_K, text, given)
	if prepErr then
		return prepErr
	end
	local rawQuestion = question :: string
	local count = if options then #options else #VOTE_YES_NO

	-- deduplicate target players so duplicate entries don't open two dialogs or inflate missing counts
	local uniquePlayers, seenPlayers = {}, {}
	for _, player in players do
		if not seenPlayers[player] then
			seenPlayers[player] = true
			table.insert(uniquePlayers, player)
		end
	end
	if #uniquePlayers == 0 then
		return "No players to poll."
	end

	local id, err, delivered = _K.Chat.send(context, "vote", rawQuestion, uniquePlayers)
	if not id then
		return err
	elseif err and context.fromPlayer and context.fromPlayer.Parent then
		_K.Remote.Notify:Fire(context.fromPlayer, { Text = err })
	end
	uniquePlayers = delivered or uniquePlayers

	local function clean(value: string): (string, string)
		local filtered = _K.Util.String.filterForBroadcast(value, context.from)
		return _K.Chat.restoreRichText(_K.Util.String.escapeRichText(filtered)), filtered
	end

	local labels = table.create(count)
	local filteredOptions
	if options then
		filteredOptions = table.create(count)
		local filters = _K.Util.Tasks.new()
		for index, option in options do
			filters:add(function()
				labels[index], filteredOptions[index] = clean(option)
			end)
		end
		filters:wait()
		for index = 1, count do
			labels[index] = labels[index] or "…"
			filteredOptions[index] = filteredOptions[index] or "…"
		end
	else
		table.move(VOTE_YES_NO, 1, count, 1, labels)
	end

	-- Chat.send already filtered the question into context.args[2] when rawArg matched; otherwise filter once
	local questionArg = context.args and context.args[2]
	local filteredQuestion = if questionArg
			and questionArg.redactLog == false
			and questionArg.parsedArgs
		then questionArg.parsedArgs[1]
		else _K.Util.String.filterForBroadcast(rawQuestion, context.from)
	question = _K.Chat.restoreRichText(_K.Util.String.escapeRichText(filteredQuestion))

	if questionArg and questionArg.rawType and questionArg.rawType.freeText then
		questionArg.parsedArgs = { filteredQuestion }
		questionArg.redactLog = false
	end
	local optionsArg = context.args and context.args[3]
	if optionsArg and filteredOptions then
		optionsArg.parsedArgs = filteredOptions
		optionsArg.redactLog = false
	end

	local tally = table.create(count, 0)
	local voted = {} -- players whose vote was counted
	local closed = false
	local pending = #uniquePlayers
	local finished = pending == 0
	local waiter = coroutine.running()
	local function finish()
		if finished then
			return
		end
		finished = true
		if coroutine.status(waiter) == "suspended" then
			task.spawn(waiter)
		end
	end

	local remote = context.env.remote
	for _, player in uniquePlayers do
		task.spawn(function()
			local ok, choice = pcall(
				remote.Invoke,
				remote,
				player,
				id,
				context.fromPlayer or context.from,
				count,
				if options then labels else VOTE_YES_NO
			)
			-- the client's answer is untrusted, only a whole option number (or legacy boolean for 2 options) counts
			if ok and not closed and not voted[player] then
				if type(choice) == "boolean" and count == 2 then
					choice = if choice then 1 else 2
				end
				if type(choice) == "number" and choice % 1 == 0 and choice >= 1 and choice <= count then
					voted[player] = true
					tally[choice] += 1
				end
			end
			pending -= 1
			if pending <= 0 then
				finish()
			end
		end)
	end

	local noun = if options then "poll" else "vote"
	local intro = `Created {noun}: <b>{question}</b>`
	if options then
		intro ..= `\n<font transparency="0.5">{table.concat(labels, ", ")}</font>`
	end
	if context.fromPlayer and context.fromPlayer.Parent then
		_K.Remote.Notify:Fire(context.fromPlayer, {
			Text = `{intro}\n\n<font transparency="0.5"><i>The {noun} will end in {VOTE_DURATION} seconds or when every player has submitted their vote!</i></font>`,
		})
	end

	-- wait for timeout or all votes to be submitted, later votes are ignored
	task.delay(VOTE_DURATION, finish)
	if not finished then
		coroutine.yield()
	end
	closed = true

	local total = 0
	for _, votes in tally do
		total += votes
	end

	local isYesNo = not options
		or (#labels == 2 and string.upper(labels[1]) == "YES" and string.upper(labels[2]) == "NO")
	if context.fromPlayer and context.fromPlayer.Parent then
		context.env.results:Fire(context.fromPlayer, question, labels, tally, #uniquePlayers - total, isYesNo)
	end
	return
end

local function voteEnv(_K)
	-- the results remote is created here so clients can connect to it at start
	return { remote = _K.Remote.Vote, results = _K.Remote.VoteResults }
end

--- Shows votes on a player's client, a vote returns the option they picked
local function connectVote(_K)
	local UI = _K.UI

	local function onVoteInvoke(id: string, from: Player | number, count: number?, fixedLabels: { string }?)
		local numOptions = if count == nil then #VOTE_YES_NO else count
		if count == nil then
			fixedLabels = VOTE_YES_NO
		elseif type(numOptions) ~= "number" or numOptions < 2 then
			return nil
		end
		-- the question arrives filtered through TextChatService
		local text = _K.Chat.waitForMessage(id)
		if not text then
			return nil
		end

		local labels = fixedLabels
		if not labels then
			labels = table.create(numOptions)
			for index = 1, numOptions do
				labels[index] = `Option {index}`
			end
		end

		local fromUserId = if typeof(from) == "Instance" and from:IsA("Player")
			then from.UserId
			elseif type(from) == "number" then from
			else nil

		local choiceSignal = _K.Util.Signal.new()
		local dialog = _K.Notify({
			Text = text,
			ActionText = "<b>CAST YOUR VOTE</b>",
			Action = true,
			Options = labels,
			-- yes and no are colored like the results
			OptionColors = if fixedLabels == VOTE_YES_NO
					or (
						fixedLabels
						and #fixedLabels == 2
						and string.upper(fixedLabels[1]) == "YES"
						and string.upper(fixedLabels[2]) == "NO"
					)
				then { UI.Theme.Valid, UI.Theme.Invalid }
				else nil,
			ExitButton = false,
			Duration = VOTE_DURATION,

			UserFrame = if fromUserId then { fromUserId } else nil,

			[UI.Hook] = {
				Action = function(choice)
					choiceSignal:Fire(choice)
				end,
			},
			-- the vote timed out without a choice
			Close = function()
				choiceSignal:Fire(nil)
			end,
		})
		if dialog and dialog._instance then
			dialog._instance.Destroying:Once(function()
				choiceSignal:Fire(nil)
			end)
		end
		return choiceSignal:Wait()
	end
	_K.Remote.Vote.OnInvoke = onVoteInvoke

	-- the server tallies the votes, this only draws them
	local _ = _K.Remote.VoteResults:Connect(
		function(question: string, labels: { string }, tally: { number }, missing: number, yesNo: boolean)
			if type(labels) ~= "table" or type(tally) ~= "table" then
				return
			end

			local total, highest = 0, 0
			for _, votes in tally do
				total += votes
				highest = math.max(highest, votes)
			end

			local list = UI.new "Frame" {
				Name = "Results",
				LayoutOrder = 3,
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 0),

				UI.list {
					gap = UI.Theme.Padding,
				},
			}

			local function addText(text: string, order: number)
				UI.new "TextLabel" {
					Parent = list,
					AutoLocalize = false,
					LayoutOrder = order,
					AutomaticSize = Enum.AutomaticSize.XY,
					BackgroundTransparency = 1,
					FontFace = UI.Theme.Font,
					RichText = true,
					Text = text,
					TextColor3 = UI.Theme.PrimaryText,
					TextSize = UI.Theme.FontSize,
					TextStrokeColor3 = UI.Theme.Primary,
					TextStrokeTransparency = UI.Theme.TextStrokeTransparency,
					TextWrapped = true,
					TextXAlignment = Enum.TextXAlignment.Left,
				}
			end

			for index, label in labels do
				local votes = tally[index] or 0
				local fraction = if total > 0 then votes / total else 0
				local color = UI.Theme.Secondary
				if yesNo then
					color = if index == 1 then UI.Theme.Valid else UI.Theme.Invalid
				elseif votes == highest and votes > 0 then
					color = UI.Theme.Valid
				end

				local fill = UI.new "Frame" {
					BackgroundColor3 = color,
					Size = UDim2.fromScale(0, 1),

					UI.corner(UI.Theme.CornerRadius),
				}
				UI.new "Frame" {
					Parent = list,
					Name = `Result{index}`,
					LayoutOrder = index,
					AutomaticSize = Enum.AutomaticSize.Y,
					BackgroundTransparency = 1,
					Size = UDim2.fromScale(1, 0),

					UI.list {
						gap = UDim.new(0, 2),
					},
					UI.new "TextLabel" {
						AutoLocalize = false,
						AutomaticSize = Enum.AutomaticSize.XY,
						BackgroundTransparency = 1,
						FontFace = UI.Theme.Font,
						RichText = true,
						Text = `<b>{label}</b>  {math.round(fraction * 100)}% <font transparency="0.5">({votes})</font>`,
						TextColor3 = UI.Theme.PrimaryText,
						TextSize = UI.Theme.FontSize,
						TextStrokeColor3 = UI.Theme.Primary,
						TextStrokeTransparency = UI.Theme.TextStrokeTransparency,
						TextWrapped = true,
						TextXAlignment = Enum.TextXAlignment.Left,
					},
					UI.new "Frame" {
						BackgroundColor3 = UI.Theme.Secondary,
						BackgroundTransparency = UI.Theme.TransparencyHeavy,
						Size = UDim2.new(1, 0, 0, 8),

						UI.corner(UI.Theme.CornerRadius),
						fill,
					},
				}
				-- the delay lets the notification slide in first
				_K.Service.Tween
					:Create(
						fill,
						TweenInfo.new(0.6, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out, 0, false, 0.3),
						{ Size = UDim2.fromScale(fraction, 1) }
					)
					:Play()
			end

			if type(missing) == "number" and missing > 0 then
				addText(`<font transparency="0.5">{missing} did not vote</font>`, #labels + 1)
			end

			_K.Notify({
				Text = `<font transparency="0.5">The results are in!</font>\n\n<b>{question}</b>`,
				Duration = RESULTS_DURATION,

				list,
			})
		end
	)
end

local POLL_ARGS = {
	{
		type = "players",
		name = "Player(s)",
		description = "The player(s) to poll.",
	},
	{
		type = "chatString",
		name = "Question",
		description = "The question to poll, in quotes when it has spaces and options follow.",
	},
	{
		type = "rawStrings",
		name = "Options",
		description = `Up to {POLL_MAX_OPTIONS} options separated by commas or spaces (in quotes when they have spaces).`,
		optional = true,
	},
}

