	logsHidden = {},
	pendingLogReveals = {} :: { any },
	playerPrefix = {},
	targetLimits = {},

	defaultSettings = {},
	savedSettings = {} :: Dict,
	settingsModuleData = nil,
	settings = {
		announcement = false,
		useSavedSettings = true,

		prefix = { ";", ":" },
		splitKey = " ",

		commandBarRank = 0,
		dashboardRank = 0,
		commandsButtonRank = 0,
		dashboardButtonRank = 1,
		joinNotificationRank = 1,

