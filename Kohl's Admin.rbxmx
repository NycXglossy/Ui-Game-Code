	{
		name = "headsize",
		aliases = { "headscale", "bighead", "hugehead", "largehead", "tinyhead", "minihead", "smallhead", "normalhead" },
		description = "Changes the head size of one or more player(s).",
		args = {
			{
				type = "players",
				name = "Player(s)",
				description = "The player(s) whose head size to change.",
				shouldRequest = true,
			},
			{
				type = "number",
				name = "Size",
				description = "The size of the head, or the original size if omitted.",
				optional = true,
			},
		},
		env = function(_K)
			local function scaleHead(char, scale)
				local human = char and char:FindFirstChildOfClass("Humanoid")
				if not human then
					return
				end
				if human.RigType == Enum.HumanoidRigType.R15 then
					local headScale = human:FindFirstChild("HeadScale")
					if headScale then
						local cache = _K.Util.Property.cache[headScale]
						local originalScale = if cache and cache.Value then cache.Value[1] else headScale.Value
						_K.Util.Property.override(headScale, "Value", originalScale * scale)
					end
				elseif human.RigType == Enum.HumanoidRigType.R6 then
					if char:FindFirstChild("Head") and char:FindFirstChild("Torso") then
						local headMesh = char.Head:FindFirstChild("Mesh")
						if headMesh then
							local cache = _K.Util.Property.cache[headMesh]
							local originalScale = if cache and cache.Scale then cache.Scale[1] else headMesh.Scale
							_K.Util.Property.override(headMesh, "Scale", originalScale * scale)
						end

						local headY = char.Head.Size.Y
						char.Torso.Neck.C0 = CFrame.new(0, headY / 2 + (headY * scale / 2), 0)
							* CFrame.Angles(math.pi / 2, math.pi, 0)
					end
				end
			end

			return {
				scaleHead = scaleHead,
				big = { "bighead", "largehead", "hugehead" },
				small = { "smallhead", "minihead", "tinyhead" },
			}
		end,

		run = function(context, players, size)
			if context.alias == "normalhead" then
				size = 1
			elseif table.find(context.env.big, context.alias) then
				size = 3
			elseif table.find(context.env.small, context.alias) then
				size = 0.5
			end

			size = size or 1
			if context._K.Auth.getRank(context.from) <= 1 then
				size = math.clamp(size, 0.5, 3)
			end
			for _, player in players do
				context.env.scaleHead(player.Character, size)
			end
		end,
	},
	{
		name = "face",
		aliases = { "🙂", "un🙂", "unface" },
		description = "Changes the face of one or more player(s).",
		args = {
			{
				type = "players",
				name = "Player(s)",
				description = "The player(s) whose face to change.",
			},
			{
				type = "image",
				name = "AssetId",
				description = "The assetId of the face, or the original face if omitted.",
				optional = true,
			},
		},

		run = function(context, players, image)
			for _, player in players do
				local head = player.Character and player.Character:FindFirstChild("Head")
				if not head then
					continue
				end
				local face = head:FindFirstChild("face")
				if not face then
					face = Instance.new("Decal")
					face.Name = "face"
					face.Parent = head
				end
				if context.undo then
					context._K.Util.Property.reset(face, "Texture")
				else
					context._K.Util.Property.override(face, "Texture", image)
				end
			end
		end,
	},
