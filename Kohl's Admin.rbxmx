					while FindChild(plr.Character, "KTShirt") do
						plr.Character.KTShirt:Destroy()
					end
					new("ShirtGraphic")({ Parent = plr.Character, Name = "KTShirt", Graphic = getTexture(args[2]) })
				end
			end
