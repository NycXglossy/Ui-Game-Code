	f.addCommand({ "f3x" }, { "Gives a player F3X building tools.", "Kohl" }, 5, { "player" }, function(pl, args)
		for i, plr in args[1] do
			if plr and plr.Character and FindChild(plr, "Backpack") then
				BuildingTools:Clone().Parent = plr.Backpack
			end
