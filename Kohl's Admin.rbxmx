								<ProtectedString name="Source"><![CDATA[-- dangerous commands restricted to superadmins

local Util = require(script.Parent.Parent:WaitForChild("Util"))

return {
	{
		name = "badge",
		aliases = { "awardbadge", "givebadge" },
		description = "Awards a badge to one or more player(s).",
		args = {
			{
				type = "players",
				name = "Player(s)",
				description = "The player(s) to award the badge.",
			},
			{
				type = "integer",
				name = "Badge ID",
				description = "The badge ID.",
			},
		},

		run = function(context, players, badge)
			local service = context._K.Service.Badge
			local tasks = Util.Tasks.new()

			for _, player in players do
				tasks:add(function()
					local ok, result = Util.Retry(service.UserHasBadgeAsync, 3, 2, service, player.UserId, badge)
					if not ok then
						error(result)
					end
					if result then
						context._K.alert(context.fromPlayer, `{player.Name} already has the badge!`)
						return
					else
						local ok2, result2 = Util.Retry(service.AwardBadge, 3, 2, service, player.UserId, badge)
						if not ok2 then
							error(result2)
						end
						return result2
					end
				end)
			end

			local resultsList = tasks:wait()
			for _, results in resultsList do
				local ok, result = results[1], results[2]
				if not ok then
					return `Failed to award badges: {result}`
				end
			end

			context._K.alert(context.fromPlayer, `Badges awarded!`)
			return
		end,
	},
	{
		name = "btools",
		aliases = { "build", "f3x" },
		credit = { "GigsD4X", "Kohl @Scripth" },
		description = "Gives Building Tools by F3X to one or more player(s).",
		args = {
			{
				type = "players",
				name = "Player(s)",
				description = "The player(s) to give Building Tools by F3X.",
			},
		},
		env = function(_K)
			local env = {}

			task.defer(function()
				env.tool = _K.Tools:WaitForChild("Building Tools") :: Tool
				env.tool.CanBeDropped = false
				local handle = Instance.new("Part")
				handle.Name = "Handle"
				handle.Size = Vector3.new(0.8, 0.8, 0.8)
				handle.CastShadow = false
				handle.CanTouch = false
				handle.CanQuery = false
				handle.TopSurface = 0
				handle.BottomSurface = 0
				for _, face in Enum.NormalId:GetEnumItems() do
					local decal = Instance.new("Decal")
					decal.Face = face
					decal.Texture = "rbxassetid://129748355"
					decal.Parent = handle
				end
				handle.Parent = env.tool
			end)

			return env
		end,

		run = function(context, players)
			for _, player in players do
				local backpack = player:FindFirstChildOfClass("Backpack")
				if not backpack or backpack:FindFirstChild("Building Tools") then
					continue
				end
				context.env.tool:Clone().Parent = backpack
			end
		end,
	},
	{
		name = "chat",
		aliases = { "forcechat" },
		description = "Disabled, scripts can't send chat messages for players.",
		args = {},
		runClient = function(context)
			context._K.Notify({ From = "_K", Text = "Forcing players to chat is disabled, scripts can't send chat." })
		end,
	},
	{
		name = "clearterrain",
		aliases = { "cterrain", "clrterrain", "removeterrain" },
		description = "Removes all terrain.",
		args = {},
		run = function(context)
			workspace.Terrain:Clear()
		end,
	},
	{
		name = "explorer",
		description = "Shows the explorer.",
		args = {},
		runClient = function(context)
			context._K.client.Explorer.Show()
		end,
	},
	{
		name = "incognito",
		description = "Hides one or more player(s) from lower rank players. (Persists until rejoin)",
		args = {
			{
				type = "players",
				name = "Player(s)",
				description = "The player(s) to hide.",
				shouldRequest = true,
			},
			{
				type = "boolean",
				name = "Hide Character",
				description = "Hides the character, defaults to true.",
				optional = true,
			},
		},

		envClient = function(_K)
			local env = {
				hidden = _K.UI.signal({}),
			}

			local function removeCharacter(name: string)
				local character = workspace:WaitForChild(name)
				if not (character and character:FindFirstChildOfClass("Humanoid")) then
					character = nil
					for _, child in workspace:GetChildren() do
						if child.Name == name and child:IsA("Model") and child:FindFirstChildOfClass("Humanoid") then
							character = child
							break
						end
					end
				end
				if character then
					character:Destroy()
				end
			end

			local _ = _K.Remote.Incognito:Connect(
				function(userIdOrName: number | string, hiddenRank: number, hideCharacter: boolean?)
					if type(userIdOrName) == "number" then
						if hideCharacter == nil then -- remove from hidden list
							env.hidden:peek()[userIdOrName] = nil
							env.hidden(env.hidden:peek(), true)
						else
							local player = _K.Service.Players:GetPlayerByUserId(userIdOrName)
							if player then
								env.hidden:peek()[userIdOrName] = player.Name
								env.hidden(env.hidden:peek(), true)
								if hiddenRank > _K.client.rank:peek() then
									if hideCharacter and player.Character then
										player.Character:Destroy()
									end
									player:Destroy()
								end
							end
						end
					elseif type(userIdOrName) == "string" and hiddenRank > _K.client.rank:peek() then
						removeCharacter(userIdOrName)
					end
				end
			)

			_K.Remote.Incognito:Fire()

			return env
		end,

		env = function(_K)
			local env = {
				hidden = {},
				remote = _K.Remote.Incognito :: RemoteEvent,
			}

			function env.apply(hiddenPlayer: Player, hideCharacter: boolean?)
				local hiddenRank = _K.Auth.getRank(hiddenPlayer.UserId)
				if env.hidden[hiddenPlayer] == false and hideCharacter then
					env.remote:FireAll(hiddenPlayer.Name, hiddenRank, hideCharacter)
				else
					env.remote:FireAll(hiddenPlayer.UserId, hiddenRank, hideCharacter)
				end
				env.hidden[hiddenPlayer] = hideCharacter
			end

			local function characterAdded(character)
				local player = _K.Service.Players:GetPlayerFromCharacter(character)
				if env.hidden[player] ~= nil then
					local hiddenRank = _K.Auth.getRank(player.UserId)
					env.remote:FireAll(character.Name, hiddenRank)
				end
			end

			local cleanup = {}

			_K.Util.SafePlayerAdded(function(player: Player)
				cleanup[player] = player.CharacterAdded:Connect(characterAdded)
				if player.Character then
					characterAdded(player.Character)
				end
			end)

			local _ = _K.Service.Players.PlayerRemoving:Connect(function(player)
				_K.Flux.dispose(cleanup[player])
				cleanup[player] = nil
				if env.hidden[player] ~= nil then
					env.hidden[player] = nil
					env.remote:FireAll(player.UserId)
				end
			end)

			local _ = env.remote:Connect(function(player)
				for hiddenPlayer, hideCharacter in env.hidden do
					local hiddenRank = _K.Auth.getRank(hiddenPlayer.UserId)
					env.remote:Fire(player, hiddenPlayer.UserId, hiddenRank, hideCharacter)
				end
			end)

			return env
		end,

		run = function(context, players: { Player }, hideCharacter: boolean?)
			if hideCharacter == nil then
				hideCharacter = true
			end
			for _, player in players do
				context.env.apply(player, hideCharacter)
			end
		end,
	},
	{
		name = "incognitolist",
		description = "Views all incognito players in the server.",

		envClient = function(_K)
			local UI = _K.UI

			local hidden = _K.Registry.commands.incognito.env.hidden

			local scroller = UI.new "ScrollerFast" {
				List = hidden,
				Enabled = true,
				DictList = true,
				FilterInput = true,
				ReverseOrder = true,
				Visible = true,
				CreateItem = function(self, lineData)
					return UI.new "Frame" {
						BackgroundTransparency = 1,
						Size = self.ItemSize,

						UI.padding {
							y = UI.Theme.PaddingHalf,
						},

						UI.list {
							verticalAlign = "center",
							direction = "x",
							gap = UI.Theme.Padding,
						},

						UI.new "ImageLabel" {
							BackgroundTransparency = UI.Theme.TransparencyHeavy,
							BackgroundColor3 = UI.Theme.PrimaryText,
							Size = UDim2.new(1, 0, 1, 0),
							SizeConstraint = Enum.SizeConstraint.RelativeYY,

							UI.corner(UDim.new(1, 0)),
							UI.new "Stroke" {},
						},

						UI.new "TextLabel" {
							AutoLocalize = false,
							AutomaticSize = Enum.AutomaticSize.X,
							BackgroundTransparency = 1,
							Size = UDim2.new(0, 0, 1, 0),
							RichText = true,
							FontFace = UI.Theme.FontMono,
							TextSize = UI.Theme.FontSize,
							TextColor3 = UI.Theme.PrimaryText,
							TextStrokeColor3 = UI.Theme.Primary,
							TextStrokeTransparency = UI.Theme.TextStrokeTransparency,
							TextTruncate = Enum.TextTruncate.SplitWord,
							TextXAlignment = Enum.TextXAlignment.Left,

							UI.flex("fill"),
						},
					}
				end,
				RenderItem = function(self, lineItem, lineData)
					lineItem.ImageLabel.Image = `rbxthumb://type=AvatarHeadShot&id={lineData}&w=48&h=48`
					lineItem.TextLabel.Text =
						`<b>{hidden:peek()[lineData]}</b> <font transparency="0.5">[{lineData}]</font>`
				end,
			}

			UI.edit(scroller._scroller)({
				UI.flex("fill"),
			})

			UI.edit(scroller._instance)({
				UI.padding(UI.Theme.PaddingStroke),
			})

			return {
				scroller = scroller,
				window = UI.new "Window" {
					Parent = UI.LayerTopInset,
					Title = "Incognito Players",
					Exitable = true,
					Position = UDim2.new(0.5, -128, 0.5, -128),
					Size = UDim2.new(0, 256, 0, 256),

					scroller,
				},
			}
		end,
		runClient = function(context, player)
			context.env.window._instance.Visible = true
		end,
	},
	{
		name = "reserve",
		aliases = { "privateserver" },
		description = "Reserves a private server.",
		args = {
			{
				type = "rawString",
				name = "AccessCode",
				description = "The access code for joining the reserved server.",
			},
			{
				type = "integer",
				name = "PlaceId",
				description = "The place identifier, omit for the current place.",
				optional = true,
			},
		},
		env = function(_K)
			local remote = _K.Remote.ReservedServers
			_K.Data.subscribeTopic("reserve", function(message)
				local data = message.Data
				if type(data) == "table" then
					_K.Data.reservedServers[data[1]] = data
					for _, player in _K.Service.Players:GetPlayers() do
						if
							_K.Auth.hasCommand(player.UserId, "place")
							or _K.Auth.hasCommand(player.UserId, "unreserve")
						then
							remote:Fire(player, { [data[1]] = data })
						end
					end
				elseif type(data) == "string" then
					_K.Data.reservedServers[data] = nil
					remote:FireAll(data)
				end
			end)
			return { remote = remote }
		end,
		envClient = function(_K)
			local _ = _K.Remote.ReservedServers:Connect(function(data)
				if type(data) == "table" then
					_K.Util.Table.merge(_K.Data.reservedServers, data)
				elseif type(data) == "string" then
					_K.Data.reservedServers[data] = nil
				end
			end)
		end,
		run = function(context, code: string, placeId: number?)
			if context.global then
				return
			end
			if context._K.Data.SEPARATE_DATASTORE then
				return `Reserve command is disabled in private servers.`
			end

			context._K.Data.ensureServersLoaded()
			if context._K.Data.reservedServers[code] then
				return `Server "<b>{code}</b>" is already reserved.`
			end

			if not context._K.Chat.canUserChat(context.from) then
				return "User cannot chat"
			end

			-- access codes are listed to admins in every server, so they are filtered and rate limited
			local filtered = context._K.Util.String.filterForBroadcast(code, context.from)
			if filtered ~= code then
				return "That access code was filtered, choose another."
			end

			local err = context._K.Chat.cooldown(context.from, "reserve")
			if err then
				return err
			end
			if context.args[1] then
				context.args[1].redactLog = false
			end

			placeId = placeId or game.PlaceId
			local data = { code, context._K.Service.Teleport:ReserveServer(placeId), placeId }
			context._K.Data.Store.updateAsync("Servers", function(store)
				if store == nil then
					store = {}
				end

				-- convert to new format
				for k, v in store do
					if #v == 2 then
						store[k] = { k, v[1], v[2] }
					end
				end

				store[code] = data
				return store
			end)

			context._K.Data.reservedServers[code] = data
			context._K.Data.publishTopic("reserve", data)
			context._K.Remote.Notify:Fire(context.fromPlayer, {
				Text = `Server "<b>{code}</b>" has been reserved, use <b>{context._K.getCommandPrefix(context.from)}place me @{code}</b> to join it!`,
			})

			return
		end,
	},
	{
		name = "unreserve",
		aliases = { "delreserve", "removereserve", "removeprivateserver" },
		description = "Removes a reserved server.",
		args = {
			{
				type = "reservedServer",
				name = "AccessCode",
				description = "The access code of the reserved server.",
			},
		},
		run = function(context, data)
			if context.global then
				return
			end
			if context._K.Data.SEPARATE_DATASTORE then
				return `Unreserve command is disabled in private servers.`
			end

			context._K.Data.ensureServersLoaded()
			local code = data[1]
			local removed
			context._K.Data.Store.updateAsync("Servers", function(store)
				if store == nil then
					store = {}
				end

				if store[code] then
					removed = true
				end
				store[code] = nil

				return store
			end)

			context._K.Data.reservedServers[code] = nil
			context._K.Data.publishTopic("reserve", code)
			context._K.Remote.Notify:Fire(context.fromPlayer, {
				Text = `Server "<b>{code}</b>" {if removed then "has been removed" else "was NOT found"}!`,
			})

			return
		end,
	},
	{
		name = "shutdown",
		aliases = { "stopserver" },
		description = "Shuts down the server.",
		args = {
			{
				type = "timeSimple",
				name = "Delay",
				description = "The delay before shutting down.",
				optional = true,
			},
			{
				type = "rawString",
				name = "Reason",
				description = "The reason for the shutdown.",
				optional = true,
			},
		},
		run = function(context, delay: number?, reason: string?)
			if delay ~= nil then
				context._K.Remote.Announce:FireAll({
					Text = `Server will shut down in {delay} seconds`,
					From = context.from,
					Duration = delay,
				})
				task.wait(delay)
			end
			-- shutdown reasons are user text everyone sees
			local allowedReason, restrictedReason = reason, reason
			if not context.global then
				allowedReason, restrictedReason =
					context._K.Chat.limitReason(context.from, reason, context._K.Service.Players:GetPlayers())
			end
			if restrictedReason and context.args[2] then
				context.args[2].parsedArgs = { restrictedReason }
				context.args[2].redactLog = false
			elseif allowedReason and context.args[2] then
				context.args[2].parsedArgs = { allowedReason }
			end
			local from = tostring(context.fromPlayer or context.from)
			local function kick(player)
				local playerReason = if context.global
						or context._K.Chat.canUsersChat(context.from, player.UserId)
					then allowedReason
					else restrictedReason
				player:Kick(`{from} has shutdown the server.{if playerReason then `\nReason: {playerReason}` else ""}`)
			end
			context._K.Util.SafePlayerAdded(kick)
		end,
	},
	{
		name = "global",
		aliases = { "gcmd" },
		description = "Runs a command string globally in all servers.",
		args = {
			{
				type = "rawString",
				name = "Command string",
				description = "The command string to run.",
			},
		},
		env = function(_K)
			_K.Data.subscribeTopic("global", function(message)
				local data = message.Data
				if type(data) ~= "table" then
					return
				end
				local from, commandString = unpack(data)
				if from and commandString then
					_K.Process.runCommands(_K, from, commandString, true, true)
				end
			end)

			return
		end,
		run = function(context, commandString: string)
			if context.global then
				return
			end

			if context._K.Data.SEPARATE_DATASTORE then
				return `Global commands are disabled in private servers.`
			end

			local prefix = context._K.getCommandPrefix(context.from)
			local escapedPrefix = context._K.Util.String.escapePattern(prefix)
			local serverPrefix = context._K.getCommandPrefix()
			if string.find(commandString, string.format('^%s[^%s"`,%%s]', escapedPrefix, escapedPrefix)) ~= 1 then
				commandString = prefix .. commandString
			end

			local ok, result = context._K.Process.prepareCommands(context._K, context.from, commandString)
			if not ok then
				return result
			end

			-- text shown to other users can't go through TextChatService across servers, so commands carrying any are
			-- gated and rate limited like announcements
			local commands = {} -- each command's name and argument strings
			local texts = {} -- argument lists and indexes of text to filter, if it's a list, its quoted pieces and items
			local argIndexes = {} -- each command's argument string index of each published argument
			local function publishedArg(commandArg)
				-- a skipped optional argument leaves its token to the next argument, so it isn't published twice
				if not commandArg or commandArg.skipped == commandArg.rawArg or commandArg.rawArg == "" then
					return nil
				end
				return commandArg.rawArg
			end
			for _, command in result do
				local definition = command.definition
				if definition.name == "vote" or definition.name == "poll" then
					return `"{definition.name}" can't run globally.`
				end
				if not definition.args then
					table.insert(commands, { serverPrefix .. command.alias })
					table.insert(argIndexes, {})
					continue
				end

				local argStrings = { serverPrefix .. command.alias }
				local indexes = {}
				for i, arg in definition.args do
					local rawArg = publishedArg(command.args[i])
					if not rawArg then
						continue
					end
					table.insert(argStrings, rawArg)
					indexes[i] = #argStrings
					if
						arg.type == "string"
						or arg.type == "strings"
						or arg.type == "chatString"
						or arg.type == "stringGreedy"
						or (definition.name == "change" and i == 3)
						or ((definition.name == "ban" or definition.name == "kick" or definition.name == "shutdown") and arg.name == "Reason")
						or (
							definition.name == "title"
							and i == 2
							and not context._K.VIP.titleDefinition[string.lower(
								context._K.Util.String.stripQuotes(context._K.Util.String.trim(rawArg))
							)]
						)
					then
						table.insert(texts, { argStrings, #argStrings, #commands + 1, arg.type == "strings" })
					end
				end
				table.insert(commands, argStrings)
				table.insert(argIndexes, indexes)
			end

			-- always quoted so receiving servers read one text argument instead of commands or skipped arguments in it,
			-- quotes have no escapes so it takes the quote the text doesn't use
			local function quoted(text: string): string
				local quote = if string.find(text, '"', 1, true) then "`" else '"'
				text = string.gsub(text, quote, "'")
				return quote .. text .. quote
			end
			for _, text in texts do
				local argStrings, index = text[1], text[2]
				-- a list is filtered and quoted per item so receiving servers split the same items
				local items = if text[4]
					then context._K.Util.String.splitOutsideQuotes(argStrings[index]) :: { string }
					else { argStrings[index] }
				local pieces = {}
				for i, item in items do
					items[i] = context._K.Util.String.stripQuotes(context._K.Util.String.trim(item))
					pieces[i] = quoted(items[i])
				end
				text[5], text[6] = pieces, items
			end

			local commandStrings = {}
			local function build()
				for _, text in texts do
					text[1][text[2]] = table.concat(text[5], ",")
				end
				table.clear(commandStrings)
				for _, argStrings in commands do
					table.insert(commandStrings, table.concat(argStrings, " "))
				end
				commandString = table.concat(commandStrings, " ")
			end

			-- receiving servers must read the same commands, arguments and text: they split tokens at the server prefix
			-- that the sender's own prefix left whole or quotes the sender's prefix didn't open, in Roblox a combining
			-- mark after a quote joins its grapheme, and an optional argument skipped here can take the quoted text
			local function parsesBack()
				local parsed = context._K.Process.rawParse(
					commandString,
					{ serverPrefix },
					context._K.Data.settings.splitKey or " "
				)
				if not parsed or #parsed ~= #commands then
					return false
				end
				for i, parsedArgs in parsed do
					local argStrings = {}
					for _, arg in parsedArgs do
						table.insert(argStrings, arg[2])
					end
					if serverPrefix .. table.concat(argStrings, " ") ~= commandStrings[i] then
						return false
					end
				end
				for _, text in texts do
					local token = parsed[text[3]][text[2]]
					if not token or token[2] ~= text[1][text[2]] then
						return false
					end
					-- and split a list into the same items
					if text[4] then
						for i, piece in context._K.Util.String.splitOutsideQuotes(token[2]) :: { string } do
							if piece ~= text[5][i] then
								return false
							end
						end
					end
				end
				local bound, boundCommands =
					context._K.Process.prepareCommands(context._K, context.from, commandString, true)
				if not bound or #boundCommands ~= #commands then
					return false
				end
				for i, command in boundCommands do
					if command.definition ~= result[i].definition then
						return false
					end
					for j in command.definition.args or {} do
						local index = argIndexes[i][j]
						if publishedArg(command.args[j]) ~= (index and commands[i][index]) then
							return false
						end
					end
				end
				return true
			end

			-- receiving servers cut longer command strings from users without a restricted role
			local function tooLong()
				return #commandString > 1024 and not context._K.Auth.hasRestrictedRole(context.from)
			end

			-- checked with the text as typed first so a refused string doesn't spend the announcement cooldown,
			-- filtering never makes text longer
			build()
			if tooLong() then
				return "This command string is too long to run globally."
			end
			if not parsesBack() then
				return "Other servers would parse this command string differently."
			end

			if #texts > 0 then
				local err = context._K.Chat.limitBroadcast(context.from)
				if err then
					return err
				end
				local filters = context._K.Util.Tasks.new()
				for _, text in texts do
					for i, item in text[6] do
						text[5][i] = "" -- stays empty if filtering fails
						filters:add(function()
							text[5][i] = quoted(context._K.Util.String.filterForBroadcast(item, context.from))
						end)
					end
				end
				filters:wait()
				build()
			end

			if tooLong() then
				return "This command string is too long to run globally."
			end

			-- filtered text can still parse differently, those refusals spend the cooldown
			if not parsesBack() then
				return "Other servers would parse this command string differently."
			end

			if context.args[1] then
				context.args[1].parsedArgs = { commandString }
				context.args[1].redactLog = false
			end
			context._K.Data.publishTopic("global", { context.from, commandString })
			return
		end,
	},
}
