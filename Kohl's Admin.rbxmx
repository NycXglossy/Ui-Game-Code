	logsLoaded = false,
	serversLoaded = false,
	localOnlyLogs = setmetatable({}, { __mode = "k" }),
	_skipNextAnnounceSync = nil :: (boolean | { [number]: any })?,
	ensureLogsLoaded = function() end,
	ensureServersLoaded = function(_silent: boolean?) end,
	subscribeTopic = function(_topic: string, _callback: (any) -> ()): any
		return nil
	end,
	publishTopic = function(_topic: string, _data: any?): boolean
		return false
	end,

	sizeBans = 0,
	sizeMain = 0,
	sizeLogs = 0,

	-- Core

	creatorId = game.CreatorId,
	gameClosing = false,

	async = {
		asset = {},
		gamepass = {},
		group = {},
		subscription = {},
	},
	friendRoles = {},

	bans = {},
	members = {},
	logs = {},
	logsVersion = 0,
	reservedServers = {},
	servers = {},
	roles = nil,
	rolesList = {},
	defaultRoles = {
		everyone = {
			_key = "everyone",
			_rank = 0,
			name = "Player",
			color = "#ffffff",
			groups = { "utility" },
			limits = { cooldown = 4, commands = 4, targets = 1 },
			permissions = {
				admin = false,
				banasync = false,
				saveRoles = false,
				settings = false,
				serverlogs = false,
				targetOthers = false,
			},
			onlyTargetSelf = true,
		},
		vip = {
			_key = "vip",
			_rank = 1,
			name = "VIP",
			color = "#0ff",
			groups = { "vip" },
			limits = { cooldown = 4, commands = 16, targets = 1 },
			permissions = { targetOthers = false },
			onlyTargetSelf = true,
		},
		mod = {
			_key = "mod",
			_rank = 2,
			name = "Moderator",
			color = "#0f0",
			groups = { "moderation", "general", "environment", "fun", "vip" },
			limits = { cooldown = 4, commands = 32, targets = math.huge },
			permissions = { serverlogs = true, targetOthers = true },
		},
		admin = {
			_key = "admin",
			_rank = 3,
			name = "Administrator",
			color = "#fc0",
			groups = { "administration", "moderation", "general", "environment", "fun", "vip" },
			limits = { cooldown = 4, commands = 64, targets = math.huge },
			permissions = { banasync = true, serverlogs = true, targetOthers = true },
		},
		superadmin = {
			_key = "superadmin",
			_rank = 4,
			name = "SuperAdmin",
			color = "#f80",
			groups = { "superadmin", "administration", "moderation", "general", "environment", "fun", "vip" },
			permissions = {
				banasync = true,
				saveRoles = true,
				settings = true,
				serverlogs = true,
				targetOthers = true,
			},
		},
		creator = {
			_key = "creator",
			_rank = math.huge,
			name = "Game Creator",
			color = "#f00",
			permissions = { admin = true, targetOthers = true },
		},
