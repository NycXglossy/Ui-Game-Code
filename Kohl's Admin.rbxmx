												v3.Part0 = nil
												v3.Part1.Anchored = true
											end
										end
										p1.FormFactor = 3
										p1.Size = Vector3.new(p1.Size.X, p1.Size.Y, 1)
										for i3, v3 in p1:GetChildren() do
											if v3:IsA("Weld") then
												v3.Part0 = p1
												v3.Part1.Anchored = false
											end
										end
									end
									if v2.Parent == ags.t then
										p1.BottomSurface = 0
										p1.TopSurface = 0
									end
									p1.Anchored = false
									v2.Part1 = p1
