	local a, b, t = false, 1, nil
	repeat
		task.wait(1)
		t = tick()
		repeat
			task.wait()
			b = tick() - t
			local c = a and b or math.max(0, 1 - b)
			Credit.Toggle.ImageColor3 = Color3.new(c, c, c)
		until b > 1
		a = not a
	until nil
end)

