						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
--[[
Shared clock for timers, frame callbacks, and deterministic stepping in tests.
Delegates to `os.clock()`, `workspace:GetServerTimeNow()`, `task.*`, and `RunService` in live games, or steps virtual time in manual mode (`Clock.manual(true)`).

```luau
local Clock = Flux.Clock
Clock.manual(true)
Clock.delay(1, function() print("one second later") end)
Clock.step(1) -- advances 1 second in 1/60s frames
```
]]

local IS_ROBLOX = game ~= nil

export type Phase = "PreRender" | "RenderStepped" | "Heartbeat"

local EPOCH = 1767225600 -- 2026-01-01T00:00:00Z
local EPSILON = 1e-9
local DRAIN_LIMIT = 10000

local osClock = os.clock
local engineTask: any = task
local RunService: any = if IS_ROBLOX then game:GetService("RunService") else nil

local manual = not IS_ROBLOX
local virtualNow = 0

--- @ignore
type Timer = {
	due: number,
	seq: number,
	thread: thread,
	start: number?,
	args: { any }?,
	cancelled: boolean?,
}

--- @ignore
type Deferred = {
	thread: thread,
	args: { any }?,
	cancelled: boolean?,
}

local heap: { Timer } = {}
local seq = 0
local timerOf: { [thread]: Timer } = {}

local queue: { Deferred } = {}
local head, tail = 1, 0
local deferredOf: { [thread]: Deferred } = {}

local render: { (dt: number) -> () } = {}
local heartbeat: { (dt: number) -> () } = {}

local frameHook: ((dt: number) -> ())? = nil
local report: (...any) -> () = if IS_ROBLOX then warn else print

local function before(a: Timer, b: Timer): boolean
	return a.due < b.due or (a.due == b.due and a.seq < b.seq)
end

local function push(timer: Timer)
	local index = #heap + 1
	heap[index] = timer
	while index > 1 do
		local parent = index // 2
		if not before(heap[index], heap[parent]) then
			break
		end
		heap[index], heap[parent] = heap[parent], heap[index]
		index = parent
	end
end

local function pop(): Timer
	local top = heap[1]
	local last = table.remove(heap) :: Timer
	local size = #heap
	if size > 0 then
		heap[1] = last
		local index = 1
		while true do
			local left, right, smallest = index * 2, index * 2 + 1, index
			if left <= size and before(heap[left], heap[smallest]) then
				smallest = left
			end
			if right <= size and before(heap[right], heap[smallest]) then
				smallest = right
			end
			if smallest == index then
				break
			end
			heap[index], heap[smallest] = heap[smallest], heap[index]
			index = smallest
		end
	end
	return top
end

local function resume(thread: thread, ...: any)
	if coroutine.status(thread) ~= "suspended" then
		return
	end
	if IS_ROBLOX then
		engineTask.spawn(thread, ...)
		return
	end
	local ok, err = coroutine.resume(thread, ...)
	if not ok then
		report(debug.traceback(thread, `[Flux] Clock: error in a resumed thread: {err}`))
	end
end

local function resumeArgs(thread: thread, args: any)
	if args then
		resume(thread, table.unpack(args, 1, args.n))
	else
		resume(thread)
	end
end

local function toThread(fnOrThread: any): thread
	return if type(fnOrThread) == "thread" then fnOrThread else coroutine.create(fnOrThread)
end

local function scheduleTimer(seconds: number?, thread: thread, start: number?, args: { any }?)
	seq += 1
	local timer: Timer = {
		due = virtualNow + math.max(seconds or 0, 0),
		seq = seq,
		thread = thread,
		start = start,
		args = args,
	}
	timerOf[thread] = timer
	push(timer)
end

local function canWait(): boolean
	if not coroutine.isyieldable() then
		return false
	elseif IS_ROBLOX then
		return true
	end
	local level, bottom = 2, nil
	while true do
		local fn = debug.info(level, "f")
		if fn == nil then
			break
		end
		bottom = fn
		level += 1
	end
	if bottom == nil or debug.info(bottom, "s") == "[C]" then
		return true
	end
	local params, vararg = debug.info(bottom, "a")
	return not (debug.info(bottom, "l") <= 1 and params == 0 and vararg)
end

local Clock = {}

--[[
Seconds on a monotonic clock, for measuring intervals: `os.clock()` in a game, virtual time on a manual clock.
]]
function Clock.now(): number
	return if manual then virtualNow else osClock()
end

--[[
Unix time in seconds, for dates and countdowns shared between players: `workspace:GetServerTimeNow()` in a game,
`2026-01-01T00:00:00Z + now()` on a manual clock.
]]
function Clock.wall(): number
	if manual then
		return EPOCH + virtualNow
	end
	return if IS_ROBLOX then workspace:GetServerTimeNow() else os.time()
end

local function pack(...: any): { any }?
	if select("#", ...) == 0 then
		return nil
	end
	local packed: { any } = table.pack(...)
	return packed
end

--[[
Runs `fn(...)` (or resumes a thread) after `seconds`, like `task.delay`. Returns the thread, for `cancel`.
]]
function Clock.delay<A...>(seconds: number?, fn: ((A...) -> ...any) | thread, ...: A...): thread
	if not manual then
		return engineTask.delay(seconds, fn, ...)
	end
	local thread = toThread(fn)
	scheduleTimer(seconds, thread, nil, pack(...))
	return thread
end

--[[
Yields the running thread for `seconds` (default: one frame), like `task.wait`, and returns the time it waited. On a
manual clock it waits for a `step` to pass the deadline, so it needs a coroutine to yield.
]]
function Clock.wait(seconds: number?): number
	if not manual then
		return engineTask.wait(seconds)
	end
	local thread = coroutine.running()
	if not canWait() then
		error("Clock.wait on a manual clock needs a yieldable coroutine; run it in a thread a step can resume", 2)
	end
	scheduleTimer(seconds, thread, virtualNow, nil)
	return coroutine.yield()
end

--[[
Runs `fn(...)` (or resumes a thread) once the current work finishes, like `task.defer`. On a manual clock it waits for
`drain()` (which every `step` frame calls). Returns the thread, for `cancel`.
]]
function Clock.defer<A...>(fn: ((A...) -> ...any) | thread, ...: A...): thread
	if not manual then
		return engineTask.defer(fn, ...)
	end
	local thread = toThread(fn)
	local entry: Deferred = { thread = thread, args = pack(...) }
	deferredOf[thread] = entry
	tail += 1
	queue[tail] = entry
	return thread
end

--[[
Cancels a thread from `delay`, `defer` or a `wait`, like `task.cancel`.
]]
function Clock.cancel(thread: thread)
	if not manual then
		engineTask.cancel(thread)
		return
	end
	local timer = timerOf[thread]
	if timer then
		timer.cancelled = true
		timer.args = nil
		timerOf[thread] = nil
	end
	local entry = deferredOf[thread]
	if entry then
		entry.cancelled = true
		entry.args = nil
		deferredOf[thread] = nil
	end
	if IS_ROBLOX then
		engineTask.cancel(thread)
	elseif coroutine.status(thread) == "suspended" then
		coroutine.close(thread)
	end
end

--[[
Calls `fn(dt)` every frame at `phase` ("PreRender", "RenderStepped" or "Heartbeat"). Returns a function that
disconnects it. A manual clock calls it from `step` instead of the engine's frames.
]]
function Clock.connect(phase: Phase, fn: (dt: number) -> ()): () -> ()
	local list = if phase == "Heartbeat"
		then heartbeat
		elseif phase == "PreRender" or phase == "RenderStepped" then render
		else error(`Clock.connect: unknown phase "{phase}" (PreRender, RenderStepped or Heartbeat)`, 2)
	if not manual then
		local connection = RunService[phase]:Connect(fn)
		return function()
			connection:Disconnect()
		end
	end
	local entry = function(dt: number)
		fn(dt)
	end
	table.insert(list, entry)
	return function()
		local index = table.find(list, entry)
		if index then
			table.remove(list, index)
		end
	end
end

--[[
Toggles manual clock mode for tests (headless Luau is always manual).
Disabling manual mode clears pending tasks via `Clock.reset()`.
]]
function Clock.manual(on: boolean)
	if not IS_ROBLOX or on == manual then
		return
	end
	if on then
		virtualNow = math.max(virtualNow, osClock())
		manual = true
	else
		Clock.reset()
		manual = false
	end
end

--[[
Tests only: whether the clock is manual.
]]
function Clock.isManual(): boolean
	return manual
end

--[[
Tests only: runs deferred work until none is left, including work it defers in turn. Errors after 10000 calls, when
deferred work keeps deferring more.
]]
function Clock.drain()
	local count = 0
	while head <= tail do
		count += 1
		if count > DRAIN_LIMIT then
			table.clear(queue)
			table.clear(deferredOf)
			head, tail = 1, 0
			error(`Clock.drain: deferred work did not settle after {DRAIN_LIMIT} calls`, 2)
		end
		local entry = queue[head]
		queue[head] = nil
		head += 1
		if not entry.cancelled then
			if deferredOf[entry.thread] == entry then
				deferredOf[entry.thread] = nil
			end
			resumeArgs(entry.thread, entry.args)
		end
	end
	head, tail = 1, 0
end

local function runFrame(dt: number)
	local last = seq
	while heap[1] ~= nil and heap[1].due <= virtualNow + EPSILON and heap[1].seq <= last do
		local timer = pop()
		if not timer.cancelled then
			if timerOf[timer.thread] == timer then
				timerOf[timer.thread] = nil
			end
			if timer.start then
				resume(timer.thread, virtualNow - timer.start)
			else
				resumeArgs(timer.thread, timer.args)
			end
		end
	end
	Clock.drain()
	if #render > 0 then
		for _, subscriber in table.clone(render) do
			subscriber(dt)
		end
		Clock.drain()
	end
	if frameHook then
		frameHook(dt)
		Clock.drain()
	end
	if #heartbeat > 0 then
		for _, subscriber in table.clone(heartbeat) do
			subscriber(dt)
		end
		Clock.drain()
	end
end

--[[
Tests only: advances a manual clock by `seconds`, in frames of at most `frameLength` seconds (default 1/60). `step(0)`
runs one frame of zero length: due timers, subscribers, a Flux step and the deferred work.
]]
function Clock.step(seconds: number, frameLength: number?)
	if not manual then
		error("Clock.step needs a manual clock; call Clock.manual(true) first", 2)
	end
	local length = frameLength or 1 / 60
	assert(seconds >= 0, "Clock.step: seconds must not be negative")
	assert(length > 0, "Clock.step: the frame length must be positive")
	local start = virtualNow
	local frames = math.max(math.ceil(seconds / length - EPSILON), 1)
	for index = 1, frames do
		local target = if index == frames then start + seconds else start + index * length
		local dt = target - virtualNow
		virtualNow = target
		runFrame(dt)
	end
end

--[[
Tests only: drops every pending timer, `wait`, deferred call and manual subscriber. `now` keeps its value.
]]
function Clock.reset()
	table.clear(heap)
	table.clear(timerOf)
	table.clear(queue)
	table.clear(deferredOf)
	head, tail = 1, 0
	table.clear(render)
	table.clear(heartbeat)
end

-- Internal, not part of `Flux.Clock`: init.luau installs the Flux frame step, Compat routes errors through its `warn`
-- and runs its headless `task.spawn` through `resume`.
--- @ignore
Clock._internal = table.freeze({
	setFrame = function(fn: ((dt: number) -> ())?)
		frameHook = fn
	end,
	setReport = function(fn: (message: string) -> ())
		report = fn
	end,
	spawn = function(fnOrThread: any, ...: any): thread
		local thread = toThread(fnOrThread)
		resume(thread, ...)
		return thread
	end,
})

return table.freeze(Clock)
]]></ProtectedString>
							<string name="ScriptGuid">{CF657EF9-CE65-4AD4-AC0D-9740B3B9848A}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">Clock</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX9EFEE49A514247C4A7919AD7A5F440D5">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
local Clock = require("./Clock")

local IS_ROBLOX = game ~= nil

type Task = {
	spawn: (fnOrThread: any, ...any) -> thread,
	defer: (fnOrThread: any, ...any) -> thread,
	delay: (seconds: number?, fnOrThread: any, ...any) -> thread,
	wait: (seconds: number?) -> number,
	cancel: (thread: thread) -> (),
}

type Compat = {
	isRoblox: boolean,
	traceback: (err: any, level: number?) -> any,
	warn: (...any) -> (),
	setWarnHook: (hook: ((message: string) -> ())?) -> (),
	task: Task,
	clock: () -> number,
	typeof: (value: any) -> string,
	getService: (name: string) -> any,
	services: { [string]: any },
	Instance: any,
	Color3: typeof(Color3),
	UDim: typeof(UDim),
	UDim2: typeof(UDim2),
	Vector2: typeof(Vector2),
	Vector3: typeof(Vector3),
	Font: typeof(Font),
	TweenInfo: typeof(TweenInfo),
	Enum: typeof(Enum),
	ColorSequence: typeof(ColorSequence),
	ColorSequenceKeypoint: typeof(ColorSequenceKeypoint),
	NumberSequence: typeof(NumberSequence),
	NumberSequenceKeypoint: typeof(NumberSequenceKeypoint),
}

local builtinTypeof = typeof
local rawWarn: (...any) -> () = if IS_ROBLOX then warn else print
local warnHook: ((message: string) -> ())? = nil

local function warn(...: any)
	local hook = warnHook
	if hook then
		local parts: any = table.pack(...)
		for i = 1, parts.n do
			parts[i] = tostring(parts[i])
		end
		hook(table.concat(parts, " ", 1, parts.n))
		return
	end
	rawWarn(...)
end

local function setWarnHook(hook: ((message: string) -> ())?)
	warnHook = hook
end

local function traceback(err: any, level: number?): any
	return if type(err) == "string" then debug.traceback(err, level) else err
end

Clock._internal.setReport(warn)

local compatTask: any = table.freeze({
	spawn = if IS_ROBLOX then task.spawn else Clock._internal.spawn,
	defer = Clock.defer,
	delay = Clock.delay,
	wait = Clock.wait,
	cancel = Clock.cancel,
})

if IS_ROBLOX then
	local gameGetService: any = game.GetService
	local robloxServices: { [string]: any } = {}
	local robloxCompat: any = table.freeze({
		isRoblox = true,
		traceback = traceback,
		warn = warn,
		setWarnHook = setWarnHook,
		task = compatTask,
		clock = Clock.now,
		typeof = typeof,
		getService = function(name: string): any
			local service = robloxServices[name]
			if service == nil then
				service = gameGetService(game, name)
				robloxServices[name] = service
			end
			return service
		end,
		services = robloxServices,
		Instance = Instance,
		Color3 = Color3,
		UDim = UDim,
		UDim2 = UDim2,
		Vector2 = Vector2,
		Vector3 = Vector3,
		Font = Font,
		TweenInfo = TweenInfo,
		Enum = Enum,
		ColorSequence = ColorSequence,
		ColorSequenceKeypoint = ColorSequenceKeypoint,
		NumberSequence = NumberSequence,
		NumberSequenceKeypoint = NumberSequenceKeypoint,
	})
	return robloxCompat :: Compat
end

local function compatTypeof(value: any): string
	local mt = getmetatable(value)
	return if type(mt) == "table" and type(mt.__type) == "string" then mt.__type else builtinTypeof(value)
end

local function fieldsEqual(a: any, b: any): boolean
	if getmetatable(a) ~= getmetatable(b) then
		return false
	end
	for key, value in a do
		if b[key] ~= value then
			return false
		end
	end
	return true
end

local function datatype(
	name: string,
	repr: (self: any) -> string,
	methods: { [string]: any }?,
	metamethods: { [string]: any }?
): (any, (fields: { [string]: any }) -> any)
	local mt: { [string]: any } = {
		__type = name,
		__index = methods,
		__eq = fieldsEqual,
		__tostring = function(self: any): string
			return `{name}({repr(self)})`
		end,
	}
	if metamethods ~= nil then
		for key, fn in metamethods do
			mt[key] = fn
		end
	end
	return mt, function(fields: { [string]: any }): any
		return table.freeze(setmetatable(fields, mt))
	end
end

local newColor3: (fields: { [string]: any }) -> any
local _, buildColor3 = datatype("Color3", function(s: any)
	return `{s.R}, {s.G}, {s.B}`
end, {
	Lerp = function(self: any, other: any, alpha: number): any
		return newColor3({
			R = self.R + (other.R - self.R) * alpha,
			G = self.G + (other.G - self.G) * alpha,
			B = self.B + (other.B - self.B) * alpha,
		})
	end,
	ToHex = function(self: any): string
		return string.format(
			"%02x%02x%02x",
			math.round(self.R * 255),
			math.round(self.G * 255),
			math.round(self.B * 255)
		)
	end,
})
newColor3 = buildColor3

local Color3Stub = {
	new = function(r: number?, g: number?, b: number?): any
		return newColor3({ R = r or 0, G = g or 0, B = b or 0 })
	end,
	fromRGB = function(r: number?, g: number?, b: number?): any
		return newColor3({ R = (r or 0) / 255, G = (g or 0) / 255, B = (b or 0) / 255 })
	end,
	fromHex = function(hex: string): any
		local digits = string.match(hex, "^#?(%x+)$")
		if digits == nil or (#digits ~= 3 and #digits ~= 6) then
			error(`invalid hex color "{hex}"`, 2)
		end
		if #digits == 3 then
			digits = string.gsub(digits, "(%x)", "%1%1")
		end
		local v = tonumber(digits, 16) :: number
		return newColor3({
			R = bit32.rshift(v, 16) / 255,
			G = bit32.band(bit32.rshift(v, 8), 0xff) / 255,
			B = bit32.band(v, 0xff) / 255,
		})
	end,
}

local function int32(v: number): number
	return if v >= 0 then math.floor(v) else math.ceil(v)
end

local udim: (scale: number?, offset: number?) -> any
local _, newUDim = datatype(
	"UDim",
	function(s: any)
		return `{s.Scale}, {s.Offset}`
	end,
	nil,
	{
		__add = function(a: any, b: any): any
			return udim(a.Scale + b.Scale, a.Offset + b.Offset)
		end,
		__sub = function(a: any, b: any): any
			return udim(a.Scale - b.Scale, a.Offset - b.Offset)
		end,
	}
)

function udim(scale: number?, offset: number?): any
	return newUDim({ Scale = scale or 0, Offset = int32(offset or 0) })
end

local UDimStub = {
	new = udim,
}

local _, newUDim2 = datatype("UDim2", function(s: any)
	return `\{{s.X.Scale}, {s.X.Offset}\}, \{{s.Y.Scale}, {s.Y.Offset}\}`
end)

local function udim2(x: any, y: any): any
	return newUDim2({ X = x, Y = y, Width = x, Height = y })
end

local UDim2Stub = {
	new = function(a: any, b: any, c: number?, d: number?): any
		return if type(a) == "table" then udim2(a, b) else udim2(UDimStub.new(a, b), UDimStub.new(c, d))
	end,
	fromScale = function(x: number?, y: number?): any
		return udim2(UDimStub.new(x, 0), UDimStub.new(y, 0))
	end,
	fromOffset = function(x: number?, y: number?): any
		return udim2(UDimStub.new(0, x), UDimStub.new(0, y))
	end,
}

local vector2: (x: number?, y: number?) -> any
local _, newVector2 = datatype("Vector2", function(s: any)
	return `{s.X}, {s.Y}`
end, {
	Lerp = function(self: any, goal: any, alpha: number): any
		return vector2(self.X + (goal.X - self.X) * alpha, self.Y + (goal.Y - self.Y) * alpha)
	end,
}, {
	__add = function(a: any, b: any): any
		return vector2(a.X + b.X, a.Y + b.Y)
	end,
	__sub = function(a: any, b: any): any
		return vector2(a.X - b.X, a.Y - b.Y)
	end,
	__mul = function(a: any, b: any): any
		if type(b) == "number" then
			return vector2(a.X * b, a.Y * b)
		elseif type(a) == "number" then
			return vector2(a * b.X, a * b.Y)
		end
		return vector2(a.X * b.X, a.Y * b.Y)
	end,
	__div = function(a: any, b: any): any
		return if type(b) == "number" then vector2(a.X / b, a.Y / b) else vector2(a.X / b.X, a.Y / b.Y)
	end,
	__unm = function(a: any): any
		return vector2(-a.X, -a.Y)
	end,
})
function vector2(x: number?, y: number?): any
	return newVector2({ X = x or 0, Y = y or 0 })
end

local Vector2Stub = { new = vector2, zero = vector2(0, 0) }

local vector3: (x: number?, y: number?, z: number?) -> any
local _, newVector3 = datatype("Vector3", function(s: any)
	return `{s.X}, {s.Y}, {s.Z}`
end, {
	Lerp = function(self: any, goal: any, alpha: number): any
		return vector3(
			self.X + (goal.X - self.X) * alpha,
			self.Y + (goal.Y - self.Y) * alpha,
			self.Z + (goal.Z - self.Z) * alpha
		)
	end,
}, {
	__add = function(a: any, b: any): any
		return vector3(a.X + b.X, a.Y + b.Y, a.Z + b.Z)
	end,
	__sub = function(a: any, b: any): any
		return vector3(a.X - b.X, a.Y - b.Y, a.Z - b.Z)
	end,
	__mul = function(a: any, b: any): any
		if type(b) == "number" then
			return vector3(a.X * b, a.Y * b, a.Z * b)
		elseif type(a) == "number" then
			return vector3(a * b.X, a * b.Y, a * b.Z)
		end
		return vector3(a.X * b.X, a.Y * b.Y, a.Z * b.Z)
	end,
	__div = function(a: any, b: any): any
		return if type(b) == "number"
			then vector3(a.X / b, a.Y / b, a.Z / b)
			else vector3(a.X / b.X, a.Y / b.Y, a.Z / b.Z)
	end,
	__unm = function(a: any): any
		return vector3(-a.X, -a.Y, -a.Z)
	end,
})
function vector3(x: number?, y: number?, z: number?): any
	return newVector3({ X = x or 0, Y = y or 0, Z = z or 0 })
end

local Vector3Stub = { new = vector3, zero = vector3(0, 0, 0) }

local ENUM_VALUES: { [string]: { [string]: number } } = {
	FontWeight = {
		Thin = 100,
		ExtraLight = 200,
		Light = 300,
		Regular = 400,
		Medium = 500,
		SemiBold = 600,
		Bold = 700,
		ExtraBold = 800,
		Heavy = 900,
	},
	InputSink = { None = 0, Activate = 1, All = 100 },
	EasingStyle = {
		Linear = 0,
		Sine = 1,
		Back = 2,
		Quad = 3,
		Quart = 4,
		Quint = 5,
		Bounce = 6,
		Elastic = 7,
		Exponential = 8,
		Circular = 9,
		Cubic = 10,
	},
	EasingDirection = { In = 0, Out = 1, InOut = 2 },
}

local EnumItemMt = {
	__type = "EnumItem",
	__tostring = function(self: any): string
		return `Enum.{tostring(self.EnumType)}.{self.Name}`
	end,
}

local EnumStub = setmetatable({}, {
	__type = "Enums",
	__index = function(enums: any, enumType: string): any
		local values = ENUM_VALUES[enumType]
		local items
		items = setmetatable({}, {
			__type = "Enum",
			__index = function(self: any, name: string): any
				local item = table.freeze(setmetatable({
					Name = name,
					EnumType = items,
					Value = if values then values[name] or 0 else 0,
				}, EnumItemMt))
				rawset(self, name, item)
				return item
			end,
			__tostring = function(): string
				return enumType
			end,
		})
		rawset(enums, enumType, items)
		return items
	end,
	__tostring = function(): string
		return "Enums"
	end,
})

local _, newFont = datatype("Font", function(s: any)
	return `{s.Family}, {s.Weight.Name}, {s.Style.Name}`
end)

local function font(family: string, weight: any?, style: any?): any
	local resolvedWeight = weight or EnumStub.FontWeight.Regular
	return newFont({
		Family = family,
		Weight = resolvedWeight,
		Style = style or EnumStub.FontStyle.Normal,
		Bold = resolvedWeight.Value >= 600,
	})
end

local FontStub = {
	new = font,
	fromEnum = function(item: any): any
		return font(`rbxasset://fonts/families/{item.Name}.json`)
	end,
	fromId = function(id: number, weight: any?, style: any?): any
		return font(`rbxassetid://{id}`, weight, style)
	end,
}

local _, newTweenInfo = datatype("TweenInfo", function(s: any)
	return `{s.Time}, {s.EasingStyle.Name}, {s.EasingDirection.Name}, {s.RepeatCount}, {s.Reverses}, {s.DelayTime}`
end)

local TweenInfoStub = {
	new = function(
		time: number?,
		easingStyle: any?,
		easingDirection: any?,
		repeatCount: number?,
		reverses: boolean?,
		delayTime: number?
	): any
		return newTweenInfo({
			Time = time or 1,
			EasingStyle = easingStyle or EnumStub.EasingStyle.Quad,
			EasingDirection = easingDirection or EnumStub.EasingDirection.Out,
			RepeatCount = repeatCount or 0,
			Reverses = reverses or false,
			DelayTime = delayTime or 0,
		})
	end,
}

local _, newColorKeypoint = datatype("ColorSequenceKeypoint", function(s: any)
	return `{s.Time}, {s.Value}`
end)
local function colorKeypoint(time: number, value: any): any
	return newColorKeypoint({ Time = time, Value = value })
end

local _, newNumberKeypoint = datatype("NumberSequenceKeypoint", function(s: any)
	return `{s.Time}, {s.Value}, {s.Envelope}`
end)
local function numberKeypoint(time: number, value: number, envelope: number?): any
	return newNumberKeypoint({ Time = time, Value = value, Envelope = envelope or 0 })
end

local function sequence(name: string, keypoint: (time: number, value: any) -> any): any
	local mt = {
		__type = name,
		__eq = function(a: any, b: any): boolean
			if getmetatable(b) ~= getmetatable(a) or #a.Keypoints ~= #b.Keypoints then
				return false
			end
			for i, point in a.Keypoints do
				if point ~= b.Keypoints[i] then
					return false
				end
			end
			return true
		end,
		__tostring = function(self: any): string
			local parts = {}
			for _, point in self.Keypoints do
				table.insert(parts, `({tostring(point)})`)
			end
			return `{name}({table.concat(parts, ", ")})`
		end,
	}
	return {
		new = function(first: any, last: any?): any
			local points = if type(first) == "table" and getmetatable(first) == nil
				then table.clone(first)
				else { keypoint(0, first), keypoint(1, if last == nil then first else last) }
			return table.freeze(setmetatable({ Keypoints = table.freeze(points) }, mt))
		end,
	}
end

local Compat: any = {}
Compat.isRoblox = false
Compat.traceback = traceback
Compat.warn = warn
Compat.setWarnHook = setWarnHook
Compat.task = compatTask
Compat.clock = Clock.now
Compat.typeof = compatTypeof
Compat.services = {} :: { [string]: any }
Compat.getService = function(name: string): any
	return Compat.services[name]
end
Compat.Instance = nil
Compat.Color3 = Color3Stub
Compat.UDim = UDimStub
Compat.UDim2 = UDim2Stub
Compat.Vector2 = Vector2Stub
Compat.Vector3 = Vector3Stub
Compat.Font = FontStub
Compat.TweenInfo = TweenInfoStub
Compat.Enum = EnumStub
Compat.ColorSequence = sequence("ColorSequence", colorKeypoint)
Compat.ColorSequenceKeypoint = { new = colorKeypoint }
Compat.NumberSequence = sequence("NumberSequence", numberKeypoint)
Compat.NumberSequenceKeypoint = { new = numberKeypoint }

return Compat :: Compat
