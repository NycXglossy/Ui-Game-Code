			<Item class="ModuleScript" referent="RBX14BC2AA685914F6D9DC270E418142589">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- src/init.luau
--- @class MainModule
if shared._K_INTERFACE then
	return shared._K_INTERFACE
end

local RunService = game:GetService("RunService")
local requireStart = os.clock()

local Client = script:WaitForChild("Client")
local Server = RunService:IsServer() and script:WaitForChild("Server")
local Shared = script:WaitForChild("Shared")

local Util = require(Shared:WaitForChild("Util"))

export type Log = Util.Log
export type LogType = Util.LogType
export type Logger = Util.Logger
export type Hook = "log" | "preCommand" | "postCommand"

local IS_DEMO_PLACE = game.PlaceId == 2569622788

if Server then
	Server.Parent = Util.Service.ServerStorage
end

local _K = {
	script = script,
	IsClient = RunService:IsClient(),
	IsServer = RunService:IsServer(),
	IsStudio = RunService:IsStudio(),

	DEBUG = IS_DEMO_PLACE,
	VERSION = Util.String.trim(script:WaitForChild("VERSION").Value),
	-- capabilities addons can check on the running version
	features = table.freeze({
		platformIntegratedChat = true,
	}),

	Logger = Util.Logger.new(true),

	-- modules
	Util = Util,
	Data = require(Shared:WaitForChild("Data")),
	Hook = require(Shared:WaitForChild("Hook")),
	Remote = Util.Remote,
	UI = nil,

	-- submodules
	Flux = require(script:WaitForChild("Flux")),
	Z = require(script:WaitForChild("Z")),

	-- core modules
	Auth = require(Shared:WaitForChild("Auth")),
	Chat = require(Shared:WaitForChild("Chat")),
	Process = require(Shared:WaitForChild("Process")),
	Registry = require(Shared:WaitForChild("Registry")),
	VIP = require(Shared:WaitForChild("VIP")),

	-- shorthand
	Service = Util.Service,
	Server = Server,
	Tools = Server and Server:WaitForChild("Tools"),
	ChatCommands = nil,

	client = nil,
	pinnedAnnouncement = nil,
	ready = false,
	Notify = nil,

	cleanupCommands = {},
	_serverLock = false,
	_addonTag = "Kohl's Admin Addon",
}

-- Increase Z scratch buffer size to 4MB
_K.Z.BUFFER = buffer.create(4 * 1024 ^ 2)

-- register creator
task.spawn(function()
	if game.CreatorType == Enum.CreatorType.Group then
		_K.groupId = game.CreatorId
		local ok, result = Util.Retry(function()
			return _K.Service.Group:GetGroupInfoAsync(game.CreatorId)
		end)
		_K.creatorId = if ok then result.Owner.Id else 0
	else
		_K.creatorId = game.CreatorId
	end
	_K.Data.creatorId = _K.creatorId

	if _K.IsServer then
		local start = os.clock()
		while not _K.Data.roles and os.clock() - start < 10 do
			task.wait()
		end
		if _K.Data.roles then
			_K.Auth.userRoleAdd(_K.creatorId, "creator")
		end
	end
end)

function _K.getCommandPrefix(from: number?)
	if _K.IsClient then
		return _K.client.playerPrefix:peek()
	end
	return _K.Data.playerPrefix[from] or ";"
end

-- the first alias of a command that works in chat, e.g. ";kill", or the command prefix before it
function _K.chatCommandAlias(alias: string): string
	local word = string.lower(alias)
	if _K.ChatCommands then
		local chatAlias = _K.ChatCommands.alias(word)
		if chatAlias then
			return chatAlias
		end
	end
	local prefix = _K.Chat.commandPrefixes(_K.Data.settings.prefix)[1] or _K.getCommandPrefix()
	return prefix .. word
end

function _K.removeExcessLogs()
	local logs = _K.Data.logs
	local excess = #logs - _K.Logger.limit
	if excess > 0 then
		_K.Util.Table.fastRemove(logs, 1, excess)
		_K.Data.logsVersion = (_K.Data.logsVersion or 0) + 1
	end
end

local pendingLogReveals = _K.Data.pendingLogReveals or {}
_K.Data.pendingLogReveals = pendingLogReveals
local revealTimer = false

local function flushLogReveals()
	revealTimer = false
	local now = os.clock()
	local nextDelay: number?
	local ready = {}
	local remaining = {}
	for _, entry in pendingLogReveals do
		local waitTime = (entry.revealAt or 0) - now
		if waitTime <= 0 then
			table.insert(ready, entry)
		else
			table.insert(remaining, entry)
			if not nextDelay or waitTime < nextDelay then
				nextDelay = waitTime
			end
		end
	end
	table.clear(pendingLogReveals)
	table.move(remaining, 1, #remaining, 1, pendingLogReveals)
	if nextDelay then
		revealTimer = true
		task.delay(nextDelay, flushLogReveals)
	end
	for _, entry in ready do
		local stored = entry.stored
		stored[1] = entry.fullText
		_K.Data.logsVersion = (_K.Data.logsVersion or 0) + 1
		if entry.save then
			_K.Data.queueLogSave(stored, entry.global)
		end
		for _, player in _K.Service.Players:GetPlayers() do
			if
				player.UserId ~= stored[4]
				and not (entry.revealedTo and entry.revealedTo[player.UserId])
				and player:GetAttribute("_K_READY")
				and _K.Auth.hasPermission(player.UserId, "serverlogs")
			then
				_K.Remote.Log:Fire(player, stored)
			end
		end
	end
end

function _K.log(
	text: string,
	level: LogType,
	from: number?,
	filtered: boolean?,
	liveText: string?,
	global: boolean?
): Log?
	if _K.Data.logsHidden[from] then
		return
	end
	local log = _K.Logger:log(text, level, from, true)
	if not log then
		return -- DEBUG disabled
	end

	if _K.IsClient and level ~= "CHAT" then
		log[6] = true
	end

	local isGlobalLog = global == true

	task.defer(function()
		if from then
			log[5] = Util.getUserInfo(from).Username
		end

		local stored = log
		if _K.IsServer then
			-- trim for 32KB sync max
			if #log[1] > 16 * 1024 then
				log[1] = string.sub(log[1] :: string, 1, 16 * 1024)
			end
			if from and filtered then
				log[1] = Util.String.filterForBroadcast(text, from)
			end
			local shouldSave = level == "COMMAND"
				and _K.Data.settings.saveLogs
				and (not from or _K.Data.settings.saveLogsForAllRoles or _K.Auth.hasRestrictedRole(from))
			local revealLater = false
			local canChat = from ~= nil and _K.Chat.canUserChat(from)
			local revealedTo = {}
			-- liveText replaces the text for players who can't chat with the sender while the sender's 60s log cooldown is active
			if liveText then
				if not canChat then
					stored = table.clone(log)
					stored[1] = liveText
				elseif
					(shouldSave or _K.Chat.hasRestrictedPeer(from :: number))
					and _K.Chat.cooldown(from :: number, "log")
				then
					stored = table.clone(log)
					stored[1] = liveText
					revealLater = true
				end
			end
			if shouldSave and not revealLater then
				_K.Data.queueLogSave(stored, isGlobalLog)
			end
			for _, player in _K.Service.Players:GetPlayers() do
				if player:GetAttribute("_K_READY") and _K.Auth.hasPermission(player.UserId, "serverlogs") then
					local full = player.UserId == from
						or (canChat and _K.Chat.canUsersChat(from :: number, player.UserId))
					if full then
						revealedTo[player.UserId] = true
					end
					_K.Remote.Log:Fire(player, if full then log else stored)
				end
			end
			if revealLater then
				table.insert(pendingLogReveals, {
					stored = stored,
					fullText = log[1],
					save = shouldSave,
					global = isGlobalLog,
					revealAt = os.clock() + _K.Chat.COOLDOWN,
					revealedTo = revealedTo,
				})
				if not revealTimer then
					revealTimer = true
					task.delay(_K.Chat.COOLDOWN, flushLogReveals)
				end
			end
		end

		table.insert(_K.Data.logs, stored)
		_K.Data.logsVersion = (_K.Data.logsVersion or 0) + 1
		_K.Hook.log:Fire(stored)
		_K.removeExcessLogs()

		if _K.IsClient and _K.client and _K.client.dashboard then
			_K.client.dashboard.Logs:updateList()
		end
	end)

	return log
end
_K.Logger.logs = _K.Data.logs

function _K.alert(to: number | Player, text: string, isError: boolean?)
	if type(to) == "number" then
		to = _K.Service.Players:GetPlayerByUserId(to)
	end
	if typeof(to) == "Instance" and to:IsA("Player") then
		local props = { Text = text, From = if isError then "_K" else nil }
		if isError then
			props.TextColor3 = Color3.new(1, 0, 0)
			props.Sound = "Call_Leave"
		end
		if _K.IsServer then
			_K.Remote.Notify:Fire(to :: Player, props)
		else
			_K.Notify(props)
		end
	end
end

-- register initial UI children
if _K.IsClient then
	_K.UI = require(Client:WaitForChild("UI"))
	local uiRegisterStart = os.clock()
	_K.UI.registerClasses()
	task.spawn(_K.log, `UI classes registered in {math.round((os.clock() - uiRegisterStart) * 1000)} ms`, "DEBUG")
end

local typeRegisterStart = os.clock()
-- register types
for _, child in Shared.DefaultTypes:GetChildren() do
	require(child)(_K)
end
task.spawn(_K.log, `Default Types registered in {math.round((os.clock() - typeRegisterStart) * 1000)} ms`, "DEBUG")

local commandRegisterStart = os.clock()
-- register commands
for _, child in Shared.DefaultCommands:GetChildren() do
	_K.Registry.registerCommandModule(_K, child)
end
task.spawn(
	_K.log,
	`Default Commands registered in {math.round((os.clock() - commandRegisterStart) * 1000)} ms`,
	"DEBUG"
)

shared._K_INTERFACE = _K

if _K.IsServer then
	require(Server)(_K)
else
	if not _K.IsStudio or IS_DEMO_PLACE then
		print(`🛡️ Running Kohl's Admin v{_K.VERSION} by @Scripth`)
	end
end

task.spawn(_K.log, `Required in {math.round((os.clock() - requireStart) * 1000)} ms`, "DEBUG")

export type _K = typeof(_K)

return _K
